<Window
	x:Class="SilverBulletPro.LoadingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:jControl="clr-namespace:JsonControls.JsonViewer;assembly=SilverBulletPro.JsonViewer" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="LoadingWindow"
	Width="300"
	Height="200"
	Background="{DynamicResource BackgroundMain}" xmlns:silverbulletpro="clr-namespace:SilverBulletPro">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Storyboard
				x:Key="WaitStoryboard">
				<DoubleAnimation
					RepeatBehavior="Forever"
					Storyboard.TargetName="Wait"
					Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
					From="0"
					To="360"
					Duration="0:0:2" />
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		HorizontalAlignment="Center"
		VerticalAlignment="Center">
		<StackPanel>
			<TextBlock
				Grid.Row="0"
				HorizontalAlignment="Center"
				FontFamily="Consolas"
				FontSize="14"
				Foreground="#FFDCDCDC"
				Text="LOADING..." />
			<TextBlock
				Grid.Row="0"
				HorizontalAlignment="Center"
				FontFamily="Consolas"
				FontSize="14"
				Foreground="#FFDCDCDC"
				Text="PLEASE WAIT" />
			<TextBlock
				Name="Wait"
				Grid.Row="1"
				Margin="20"
				HorizontalAlignment="Center"
				FontFamily="Fonts/#FontAwesome"
				FontSize="50"
				Foreground="#FFDCDCDC"
				RenderTransformOrigin="0.5, 0.5"
				Text="">
				<UIElement.RenderTransform>
					<RotateTransform
						Angle="0" />
				</UIElement.RenderTransform>
			</TextBlock>
		</StackPanel>
	</Grid>
</Window>
