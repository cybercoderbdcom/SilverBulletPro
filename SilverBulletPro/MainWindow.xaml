								<PackIconMaterial
									FrameworkElement.Width="26"
									FrameworkElement.Height="19.5"
									FrameworkElement.HorizontalAlignment="Center"
									PackIconMaterial.Kind="MapMarkerRadiusOutline"
									Control.Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type uc:CustomTabItem}}}" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
