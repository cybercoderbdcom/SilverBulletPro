<Page
	x:Class="SilverBulletPro.Views.Dialogs.CustomInputDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="CustomInputDialog" xmlns:dialogs="clr-namespace:SilverBulletPro.Views.Dialogs">
	<Border
		Padding="15"
		Background="#00FFFFFF"
		KeyDown="Border_KeyDown">
		<StackPanel
			MaxWidth="600"
			HorizontalAlignment="Center">
			<TextBlock
				Name="blockQuestion"
				Margin="0,10,0,20"
				HorizontalAlignment="Center"
				FontSize="14"
				Text="Question?"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<ComboBox
				Name="answerComboBox"
				Width="200"
				IsEditable="True" />
			<Grid
				Margin="0,5,0,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Button
					Margin="0,0,5,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					IconElement.Geometry="M12,5 L4,13 L0,9 L1.5,7.5 L4,10 L10.5,3.5 L12,5"
					Content="Ok"
					Click="Ok_Click" />
				<Button
					Grid.Column="1"
					Margin="5,0,0,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					IconElement.Geometry="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 L19,6.41"
					IconElement.Width="11"
					Content="Cancel"
					Click="Cancel_Click" />
			</Grid>
		</StackPanel>
	</Border>
</Page>
