<!--Class 'SilverBulletPro.Views.Dialogs.DialogAddBlock' has IComponentConnector.Connect method, but cannot be parsed.-->
<Page
	x:Class="SilverBulletPro.Views.Dialogs.DialogAddBlock" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="DialogAddBlock"
	Width="561"
	Height="365" xmlns:dialogs="clr-namespace:SilverBulletPro.Views.Dialogs">
	<Grid
		Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<Button
				Name="browseBack"
				Width="30"
				Padding="5,0,0,0"
				BorderElement.CornerRadius="5 0 0 0"
				IconElement.Geometry="M31.7,239 L167.7,103 C177.1,93.6 192.29999999999998,93.6 201.6,103 L224.2,125.6 C233.6,135 233.6,150.2 224.2,159.5 L127.9,256 L224.3,352.4 C233.70000000000002,361.79999999999995 233.70000000000002,377 224.3,386.29999999999995 L201.7,409 C192.29999999999998,418.4 177.1,418.4 167.79999999999998,409 L31.799999999999983,273 C22.299999999999983,263.6 22.299999999999983,248.4 31.69999999999998,239"
				IconElement.Width="10"
				Background="{DynamicResource BackgroundSecondary}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1,1,0,1"
				Command="NavigationCommands.BrowseBack"
				Foreground="{DynamicResource ForegroundMain}"
				CommandTarget="{Binding ElementName=NavigationFrame}"
				IsEnabled="{Binding ElementName=NavigationFrame, Path=CanGoBack}" />
			<controls:SearchBar
				Grid.Column="3"
				BorderElement.CornerRadius="0 4 0 0"
				InfoElement.Placeholder="{DynamicResource SearchInBlocks}"
				Control.Background="{DynamicResource BackgroundSecondary}"
				FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
				Control.Foreground="{DynamicResource ForegroundMain}"
				FrameworkElement.Style="{StaticResource SearchBarExtend}" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
		</Grid>
		<TabControl
			Name="tabControl"
			Grid.Row="1"
			Background="{DynamicResource BackgroundSecondary}"
			Foreground="{DynamicResource ForegroundMain}">
			<TabItem
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}"
				Header="{DynamicResource Default}">
				<ScrollViewer
					CanContentScroll="True"
					VerticalScrollBarVisibility="Auto">
					<Frame
						Name="NavigationFrame"
						BorderElement.CornerRadius="0"
						Background="{DynamicResource BackgroundSecondary}"
						BorderThickness="1,0,1,1"
						Foreground="{DynamicResource ForegroundMain}"
						NavigationUIVisibility="Hidden" />
				</ScrollViewer>
			</TabItem>
			<TabItem
				Name="tabItemPlugins"
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}"
				Header="{DynamicResource Plugins}"
				IsEnabled="False">
				<Border
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="1,0,1,1"
					CornerRadius="0">
					<ScrollViewer
						CanContentScroll="True"
						VerticalScrollBarVisibility="Auto">
						<Frame
							Name="NavigationFramePlugin"
							BorderElement.CornerRadius="0"
							Background="{DynamicResource BackgroundSecondary}"
							BorderThickness="1,0,1,1"
							Foreground="{DynamicResource ForegroundMain}"
							NavigationUIVisibility="Hidden" />
					</ScrollViewer>
				</Border>
			</TabItem>
			<TabItem
				Name="tabItemFavorites"
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}"
				Header="{DynamicResource Favorites}"
				IsEnabled="False">
				<Border
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="1,0,1,1"
					CornerRadius="0">
					<ScrollViewer
						CanContentScroll="True"
						VerticalScrollBarVisibility="Auto">
						<Frame
							Name="NavigationFrameFavorites"
							BorderElement.CornerRadius="0"
							Background="{DynamicResource BackgroundSecondary}"
							BorderThickness="1,0,1,1"
							Foreground="{DynamicResource ForegroundMain}"
							NavigationUIVisibility="Hidden" />
					</ScrollViewer>
				</Border>
			</TabItem>
		</TabControl>
		<Grid
			Name="gridRecentBlocks"
			Row="2"
			Visibility="Collapsed">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<Label
				Margin="0,0,0,-3"
				Content="Recently used blocks:" />
			<WrapPanel
				Name="panelRecentBlocks"
				Grid.Row="1" />
		</Grid>
	</Grid>
</Page>
