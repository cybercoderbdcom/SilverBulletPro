<Page
	x:Class="SilverBulletPro.Views.Dialogs.DialogUpdateDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
	Title="DialogUpdateDetails"
	Width="550"
	Height="350" xmlns:dialogs="clr-namespace:SilverBulletPro.Views.Dialogs">
	<Grid
		Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition />
				<ColumnDefinition
					Width="auto" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Margin="5,0,5,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource DownloadLink}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="textBox"
				Grid.Column="1"
				BorderElement.CornerRadius="4 0 0 4"
				IsReadOnly="True" />
			<Button
				Grid.Column="2"
				Width="35"
				Padding="5,5,0,5"
				BorderElement.CornerRadius="0 4 4 0"
				IconElement.Geometry="M15,14 L9,14 A1,1 0 0 0 9,16L15,16 A1,1 0 0 0 15,14M15,10 L11,10 A1,1 0 0 0 11,12L15,12 A1,1 0 0 0 15,10M17,4 L15.82,4 A3,3 0 0 0 13,2L11,2 A3,3 0 0 0 8.18,4L7,4 A3,3 0 0 0 4,7L4,19 A3,3 0 0 0 7,22L17,22 A3,3 0 0 0 20,19L20,7 A3,3 0 0 0 17,4M10,5 A1,1 0 0 1 11,4L13,4 A1,1 0 0 1 14,5L14,6 L10,6 M18,19 A1,1 0 0 1 17,20L7,20 A1,1 0 0 1 6,19L6,7 A1,1 0 0 1 7,6L8,6 L8,7 A1,1 0 0 0 9,8L15,8 A1,1 0 0 0 16,7L16,6 L17,6 A1,1 0 0 1 18,7"
				BorderThickness="1"
				ToolTip="Copy download link"
				Click="Button_Click" />
		</Grid>
		<ScrollViewer
			Grid.Row="1"
			Margin="2,15,2,10"
			CanContentScroll="True"
			HorizontalScrollBarVisibility="Disabled"
			IsDeferredScrollingEnabled="True"
			VerticalScrollBarVisibility="Disabled">
			<md:MarkdownScrollViewer
				MarkdownScrollViewer.Name="markDown"
				ScrollViewerAttach.AutoHide="False"
				Control.Background="{DynamicResource BackgroundSecondary}"
				Control.Foreground="{DynamicResource ForegroundMain}"
				FlowDocumentScrollViewer.HorizontalScrollBarVisibility="Auto"
				ScrollViewer.CanContentScroll="True"
				FlowDocumentScrollViewer.VerticalScrollBarVisibility="Auto"
				x:Name="markDown">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							BasedOn="{StaticResource ScrollViewerNativeBaseStyle}"
							TargetType="{x:Type ScrollViewer}"
							x:Key="{x:Type ScrollViewer}" />
						<Style
							BasedOn="{StaticResource ScrollBarBaseStyle}"
							TargetType="{x:Type ScrollBar}"
							x:Key="{x:Type ScrollBar}" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</md:MarkdownScrollViewer>
		</ScrollViewer>
	</Grid>
</Page>
