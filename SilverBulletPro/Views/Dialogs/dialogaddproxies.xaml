<Page
	x:Class="SilverBulletPro.DialogAddProxies" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Add Proxies" xmlns:silverbulletpro="clr-namespace:SilverBulletPro"
	KeyDown="Page_KeyDown"
	Loaded="Page_Loaded">
	<Grid
		Width="270"
		Height="auto"
		Margin="2">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<StackPanel
			Grid.Row="0"
			Orientation="Horizontal">
			<TextBlock
				Margin="5,0,0,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource ImportFrom}" /> <Run
					Text=":" /></TextBlock>
			<Label
				Name="fileMode"
				FontWeight="Bold"
				Foreground="{DynamicResource ForegroundMenuSelected}"
				MouseDown="FileMode_MouseDown">
				<DockPanel
					Background="#00FFFFFF">
					<iconpacks:PackIconFontAwesome
						PackIconFontAwesome.Kind="FileAltSolid" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" />
					<TextBlock
						Margin="5,0,0,0"
						Text="{DynamicResource File}"
						Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Label}}}" />
				</DockPanel>
			</Label>
			<Label
				Name="pasteMode"
				FontWeight="Bold"
				MouseDown="PasteMode_MouseDown">
				<DockPanel
					Background="#00FFFFFF">
					<PackIconFontAwesome
						PackIconFontAwesome.Kind="ClipboardSolid" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" />
					<TextBlock
						Margin="5,0,0,0"
						Text="{DynamicResource Paste}"
						Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Label}}}" />
				</DockPanel>
			</Label>
			<Label
				Name="apiMode"
				FontWeight="Bold"
				MouseDown="ApiMode_MouseDown">
				<DockPanel
					Background="#00FFFFFF">
					<iconpacks:PackIconFileIcons
						PackIconFileIcons.Kind="ApiBlueprint" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FileIcons" />
					<TextBlock
						Margin="5,0,0,0"
						Text="{DynamicResource Api}"
						Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Label}}}" />
				</DockPanel>
			</Label>
		</StackPanel>
		<TabControl
			Name="modeTabControl"
			Grid.Row="1"
			Margin="5"
			Background="#00FFFFFF"
			BorderThickness="0">
			<ItemsControl.ItemContainerStyle>
				<Style
					TargetType="{x:Type TabItem}">
					<Setter
						Property="Visibility"
						Value="Collapsed" />
				</Style>
			</ItemsControl.ItemContainerStyle>
			<TabItem
				Name="fileTab">
				<StackPanel>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="auto" />
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Margin="5,0,2,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource Location}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							Name="locationTextbox"
							Grid.Column="1"
							Margin="5"
							VerticalContentAlignment="Center"
							BorderElement.CornerRadius="4 0 0 4"
							AllowDrop="True"
							IsReadOnly="True"
							Drop="TextBox_Drop"
							PreviewDragOver="TextBox_PreviewDragOver" />
						<Button
							Name="loadProxiesButton"
							Grid.Column="2"
							Width="35"
							Margin="-5,0,0,0"
							Padding="4,0,0,0"
							BorderElement.CornerRadius="0 5 5 0"
							IconElement.Geometry="M480,119 C480,105.7 470.6,96 457.2,96 L198.9,96 C196.1,96 194.6,95.4 192.8,93.6 L170.3,71.1 L170.10000000000002,70.89999999999999 C165.20000000000002,66.3 161.20000000000002,63.99999999999999 152.8,63.99999999999999 L56.7,63.99999999999999 C42.9,64 32,74.3 32,87 L32,160.7 C32,162.29999999999998 33.7,162.2 35,161.39999999999998 C36.3,160.59999999999997 40,159.99999999999997 42,159.99999999999997 L470,159.99999999999997 C472,159.99999999999997 475.7,160.59999999999997 477,161.39999999999998 C478.3,162.2 480,162.29999999999998 480,160.7 L480,119 M32,416.4 C32,433.9 46.2,448 63.6,448 L448,448 C465.6,448 480,433.6 480,416 L480,204 C480,195.2 472.8,188 464,188 L48,188 C39.2,188 32,195.2 32,204 L32,416.4"
							IconElement.Width="16"
							Background="{DynamicResource BackgroundSecondary}"
							BorderBrush="{DynamicResource BorderBrush}"
							BorderThickness="0,1,1,1"
							Foreground="{DynamicResource ForegroundMain}"
							Click="LoadProxiesButton_Click" />
					</Grid>
				</StackPanel>
			</TabItem>
			<TabItem
				Name="pasteTab">
				<StackPanel>
					<Label
						Content="{DynamicResource PasteYourProxiesInTheBoxBelow}" />
					<TextBox
						Name="proxiesBox"
						Height="100"
						Margin="0,5"
						AcceptsReturn="True"
						FontFamily="Consolas"
						TextWrapping="Wrap"
						VerticalScrollBarVisibility="Auto" />
				</StackPanel>
			</TabItem>
			<TabItem
				Name="apiTab">
				<StackPanel>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="auto" />
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.Column="0"
							Margin="5,0,2,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource Url}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							Name="urlTextbox"
							Grid.Column="1"
							Margin="5"
							VerticalContentAlignment="Center" />
					</Grid>
				</StackPanel>
			</TabItem>
		</TabControl>
		<Grid
			Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<TextBlock
				Name="advancedWarning"
				Grid.Row="0"
				Grid.ColumnSpan="2"
				Margin="5"
				FontFamily="Consolas">
				<Span
					FontWeight="Bold"
					Foreground="{DynamicResource ForegroundMain}">Advanced Syntax:</Span>
				<LineBreak />
				<Span
					Foreground="{DynamicResource ForegroundMain}">Type: (http)1.1.1.1:80</Span>
				<LineBreak />
				<Span
					Foreground="{DynamicResource ForegroundMain}">Auth: 1.1.1.1:80:username:password</Span>
				<LineBreak />
				<Span
					Foreground="{DynamicResource ForegroundMain}">Chain: 1.1.1.1:80 -&gt; 2.2.2.2:80</Span>
				<LineBreak />
				<Span
					Foreground="{DynamicResource ForegroundCustom}">Chain won't work with Selenium</Span>
			</TextBlock>
			<TextBlock
				Grid.Row="1"
				Grid.ColumnSpan="2"
				Margin="5,4,0,3"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource DefaultsWhenNotSpecified}" /> <Run
					Text=":" /></TextBlock>
			<TextBlock
				Grid.Row="2"
				Grid.Column="0"
				Margin="5,0,2,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}"
				Visibility="{Binding ElementName=nameTextbox, Path=Visibility}">
				<Run
					Text="{DynamicResource Name}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="nameTextbox"
				Grid.Row="2"
				Grid.Column="1"
				Margin="5" />
			<TextBlock
				Grid.Row="3"
				Grid.Column="0"
				Margin="5,0,2,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Type}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="proxyTypeCombobox"
				Grid.Row="3"
				Grid.Column="1"
				Margin="5" />
			<TextBlock
				Grid.Row="4"
				Grid.Column="0"
				Margin="5,0,2,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Username}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="usernameTextbox"
				Grid.Row="4"
				Grid.Column="1"
				Margin="5" />
			<TextBlock
				Grid.Row="5"
				Grid.Column="0"
				Margin="5,0,2,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Password}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="passwordTextbox"
				Grid.Row="5"
				Grid.Column="1"
				Margin="5" />
			<Button
				Name="acceptButton"
				Grid.Row="6"
				Grid.ColumnSpan="2"
				Width="auto"
				Height="30"
				Margin="5"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				IconElement.Geometry="M173.898,439.404 L7.4979999999999905,273.004 C-2.4990000000000094,263.007 -2.4990000000000094,246.79800000000003 7.4979999999999905,236.8 L43.70099999999999,200.596 C53.69799999999999,190.598 69.90799999999999,190.598 79.905,200.596 L192,312.69 L432.095,72.596 C442.09200000000004,62.599000000000004 458.302,62.599000000000004 468.29900000000004,72.596 L504.50200000000007,108.80000000000001 C514.499,118.79700000000001 514.499,135.006 504.50200000000007,145.00400000000002 L210.1020000000001,439.405 C200.1040000000001,449.40200000000004 183.8950000000001,449.40200000000004 173.89800000000008,439.40400000000005"
				IconElement.Width="14"
				Content="{DynamicResource Accept}"
				Click="acceptButton_Click" />
		</Grid>
	</Grid>
</Page>
