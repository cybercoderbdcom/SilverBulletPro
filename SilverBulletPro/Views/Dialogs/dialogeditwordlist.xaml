<Page
	x:Class="SilverBulletPro.DialogEditWordlist" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="DialogEditWordlist" xmlns:silverbulletpro="clr-namespace:SilverBulletPro"
	KeyDown="Page_KeyDown"
	Loaded="Page_Loaded">
	<StackPanel
		Width="310"
		Margin="10,8,8,8">
		<DockPanel
			Margin="0,0,0,5">
			<TextBlock
				Margin="0,0,8,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Name}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="wordlistName"
				Margin="12,0,0,0" />
		</DockPanel>
		<DockPanel
			Margin="0,0,0,5">
			<TextBlock
				Margin="0,0,8,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Path}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="wordlistPath"
				Margin="20,0,0,0" />
		</DockPanel>
		<DockPanel
			Margin="0,0,0,5">
			<TextBlock
				Margin="0,0,8,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Type}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="wordlistType"
				Margin="19,0,0,0" />
		</DockPanel>
		<DockPanel
			Margin="0,0,0,5">
			<TextBlock
				Margin="0,0,7,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Purpose}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="wordlistPurpose"
				Margin="3,0,0,0" />
		</DockPanel>
		<DockPanel
			Margin="56,0,0,0">
			<Button
				Width="127"
				HorizontalAlignment="Left"
				BorderElement.CornerRadius="4 0 0 4"
				IconElement.Geometry="M18.71,7.21 A1,1 0 0 0 17.29,7.21L9.84,14.67 L6.71,11.53 A1,1 1 1 0 5.29,13L9.129999999999999,16.84 A1,1 0 0 0 10.549999999999999,16.84L18.71,8.68 A1,1 0 0 0 18.71,7.21"
				BorderThickness="0.5,1,0.5,0.5"
				Click="Button_Click_1">
				<DockPanel>
					<TextBlock
						Margin="5,0"
						Text="{DynamicResource Accept}" />
				</DockPanel>
			</Button>
			<Button
				Width="127"
				HorizontalAlignment="Right"
				BorderElement.CornerRadius="0 4 4 0"
				IconElement.Geometry="M13.41,12 L17.71,7.71 A1,1 1 1 0 16.29,6.29L12,10.59 L7.71,6.29 A1,1 0 0 0 6.29,7.71L10.59,12 L6.29,16.29 A1,1 0 0 0 6.29,17.71A1,1 0 0 0 7.71,17.71L12,13.41 L16.29,17.71 A1,1 0 0 0 17.71,17.71A1,1 0 0 0 17.71,16.29"
				BorderThickness="0.5,1,0.5,0.5"
				Click="Button_Click">
				<DockPanel>
					<TextBlock
						Margin="5,0"
						Text="{DynamicResource Cancel}" />
				</DockPanel>
			</Button>
		</DockPanel>
	</StackPanel>
</Page>
