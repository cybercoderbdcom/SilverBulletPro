<controls:GlowWindow
	x:Class="SilverBulletPro.DialogFindReplace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:frp="clr-namespace:SilverBulletPro.FindReplace" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Window.Title="{DynamicResource FindAndReplace}"
	FrameworkElement.Width="360"
	Control.Background="{DynamicResource BackgroundMain}"
	FocusManager.IsFocusScope="True"
	Window.ResizeMode="NoResize"
	Window.ShowInTaskbar="False"
	Window.SizeToContent="Height"
	Window.Topmost="False"
	Window.WindowStartupLocation="CenterOwner"
	Window.WindowStyle="ToolWindow" xmlns:silverbulletpro="clr-namespace:SilverBulletPro" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
	Window.Left="{Binding WindowLeft, Mode=TwoWay}"
	Window.Top="{Binding WindowTop, Mode=TwoWay}"
	KeyDown="Window_KeyDown">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<frp:SearchScopeToInt
				x:Key="searchScopeToInt" />
			<BooleanToVisibilityConverter
				x:Key="boolToVis" />
			<frp:BoolToInt
				x:Key="boolToInt" />
			<DataTemplate
				x:Key="FindPageTemplate">
				<StackPanel>
					<TextBlock
						Margin="7,8,3,3">
						<Run
							Text="{DynamicResource TextToFind}" /> <Run
							Text=":" /></TextBlock>
					<ContentPresenter
						Content="{Binding}" />
					<StackPanel
						DataContext="{Binding DataContext}">
						<TextBlock
							Margin="10,3,3,3"
							Visibility="{Binding ShowSearchIn, Converter={StaticResource boolToVis}}">
							<Run
								Text="{DynamicResource SearchIn}" /> <Run
								Text=":" /></TextBlock>
						<ComboBox
							Margin="7,1,5,5"
							HorizontalAlignment="Stretch"
							SelectedIndex="{Binding SearchIn, Mode=TwoWay, Converter={StaticResource searchScopeToInt}}"
							Visibility="{Binding ShowSearchIn, Converter={StaticResource boolToVis}}">
							<ComboBoxItem>Current Document</ComboBoxItem>
							<ComboBoxItem>All Documents</ComboBoxItem>
						</ComboBox>
						<Expander
							Margin="8,0,5,5"
							Foreground="{DynamicResource ForegroundMain}"
							Header="{DynamicResource Options}"
							IsExpanded="False"
							Style="{StaticResource BaseStyle}">
							<StackPanel
								Margin="1,7,0,0">
								<CheckBox
									Name="chkCaseSensitive"
									Margin="1"
									Content="{DynamicResource CaseSensitive}"
									IsChecked="{Binding CaseSensitive, Mode=TwoWay}" />
								<CheckBox
									Name="chkSearchUp"
									Margin="1"
									Content="{DynamicResource SearchUp}"
									IsChecked="{Binding SearchUp, Mode=TwoWay}" />
								<CheckBox
									Name="chkWholeWord"
									Margin="1"
									Content="{DynamicResource MatchWholeWord}"
									IsChecked="{Binding WholeWord, Mode=TwoWay}" />
								<CheckBox
									Name="chkRegex"
									Margin="1"
									Content="{DynamicResource RegularExpression}"
									IsChecked="{Binding UseRegEx, Mode=TwoWay}" />
								<CheckBox
									Name="chkWildcards"
									Margin="1"
									Content="{DynamicResource Wildcards}"
									IsChecked="{Binding UseWildcards, Mode=TwoWay}" />
							</StackPanel>
						</Expander>
					</StackPanel>
				</StackPanel>
			</DataTemplate>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="0,0,3,0"
		Background="{DynamicResource BackgroundMain}">
		<TabControl
			Name="tabMain"
			Height="Auto"
			BorderThickness="{Binding AllowReplace, Converter={StaticResource boolToInt}}">
			<TabItem
				Name="tabFind"
				ContentTemplate="{StaticResource FindPageTemplate}"
				Style="{StaticResource TabItemCustomStyle}"
				Visibility="{Binding AllowReplace, Converter={StaticResource boolToVis}}">
				<HeaderedContentControl.Header>
					<DockPanel>
						<iconpacks:PackIconMaterial
							PackIconMaterial.Kind="TextSearch" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material"
							Control.Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}}" />
						<TextBlock
							Margin="4,-1,0,0"
							Text="{DynamicResource DialogFind}"
							Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}}" />
					</DockPanel>
				</HeaderedContentControl.Header>
				<StackPanel>
					<TextBox
						Name="txtFind"
						Margin="8,3,8,3"
						AcceptsReturn="{Binding AcceptsReturn}"
						Text="{Binding TextToFind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<Button
						Margin="3,3,8,0"
						HorizontalAlignment="Right"
						IconElement.Geometry="M505,442.7 L405.3,343 C400.8,338.5 394.7,336 388.3,336 L372,336 C399.6,300.7 416,256.3 416,208 C416,93.1 322.9,0 208,0 C93.10000000000002,0 0,93.1 0,208 C0,322.9 93.1,416 208,416 C256.3,416 300.7,399.6 336,372 L336,388.3 C336,394.7 338.5,400.8 343,405.3 L442.7,505 C452.09999999999997,514.4 467.3,514.4 476.59999999999997,505 L504.9,476.7 C514.3,467.3 514.3,452.09999999999997 505,442.7 M208,336 C137.3,336 80,278.8 80,208 C80,137.3 137.2,80 208,80 C278.7,80 336,137.2 336,208 C336,278.7 278.8,336 208,336"
						IconElement.Width="14.5"
						Background="{DynamicResource BackgroundSecondary}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						Content="{DynamicResource FindNext}"
						Foreground="{DynamicResource ForegroundMain}"
						IsDefault="True"
						Click="FindNextClick" />
				</StackPanel>
			</TabItem>
			<TabItem
				Name="tabReplace"
				ContentTemplate="{StaticResource FindPageTemplate}"
				Style="{StaticResource TabItemCustomStyle}"
				Visibility="{Binding AllowReplace, Converter={StaticResource boolToVis}}">
				<HeaderedContentControl.Header>
					<DockPanel>
						<iconpacks:PackIconRemixIcon
							FrameworkElement.Width="14.5"
							PackIconRemixIcon.Kind="FindReplaceLine" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
							Control.Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}}" />
						<TextBlock
							Margin="3,0,0,0"
							Text="{DynamicResource DialogReplace}"
							Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}}" />
					</DockPanel>
				</HeaderedContentControl.Header>
				<StackPanel
					Margin="5,0,5,0">
					<TextBox
						Name="txtFind2"
						Margin="3"
						AcceptsReturn="{Binding AcceptsReturn}"
						Text="{Binding TextToFind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					<TextBlock
						Margin="3">
						<Run
							Text="{DynamicResource ReplaceWith}" /> <Run
