<Page
	x:Class="SilverBulletPro.DialogNewConfig" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="DialogNewConfig"
	Height="210"
	Background="{DynamicResource BackgroundMain}" xmlns:silverbulletpro="clr-namespace:SilverBulletPro"
	KeyDown="Page_KeyDown">
	<Grid
		Width="250"
		Margin="5">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="auto" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<Style
					TargetType="{x:Type Label}"
					x:Key="{x:Type Label}">
					<Setter
						Property="VerticalAlignment"
						Value="Center" />
					<Setter
						Property="Foreground"
						Value="{DynamicResource ForegroundMain}" />
				</Style>
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<TextBlock
			Grid.Row="0"
			Grid.Column="0"
			Margin="4,0,0,0"
			VerticalAlignment="Center"
			Foreground="{DynamicResource ForegroundMain}">
			<Run
				Text="{DynamicResource Name}" /> <Run
				Text=":" /></TextBlock>
		<TextBox
			Name="nameTextbox"
			Grid.Row="0"
			Grid.Column="1"
			Margin="5" />
		<TextBlock
			Grid.Row="1"
			Grid.Column="0"
			Margin="4,0,0,0"
			VerticalAlignment="Center"
			Foreground="{DynamicResource ForegroundMain}">
			<Run
				Text="{DynamicResource Icon}" /> <Run
				Text=":" /></TextBlock>
		<DockPanel
			Grid.Row="1"
			Grid.Column="1"
			Margin="5">
			<Button
				Width="34"
				Padding="5,0,0,0"
				BorderElement.CornerRadius="0 4 4 0"
				IconElement.Geometry="M480,119 C480,105.7 470.6,96 457.2,96 L198.9,96 C196.1,96 194.6,95.4 192.8,93.6 L170.3,71.1 L170.10000000000002,70.89999999999999 C165.20000000000002,66.3 161.20000000000002,63.99999999999999 152.8,63.99999999999999 L56.7,63.99999999999999 C42.9,64 32,74.3 32,87 L32,160.7 C32,162.29999999999998 33.7,162.2 35,161.39999999999998 C36.3,160.59999999999997 40,159.99999999999997 42,159.99999999999997 L470,159.99999999999997 C472,159.99999999999997 475.7,160.59999999999997 477,161.39999999999998 C478.3,162.2 480,162.29999999999998 480,160.7 L480,119 M32,416.4 C32,433.9 46.2,448 63.6,448 L448,448 C465.6,448 480,433.6 480,416 L480,204 C480,195.2 472.8,188 464,188 L48,188 C39.2,188 32,195.2 32,204 L32,416.4"
				IconElement.Width="14"
				Background="{DynamicResource BackgroundSecondary}"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="0,1,1,1"
				DockPanel.Dock="Right"
				Click="OpenIconButton_Click" />
			<TextBox
				Name="iconTextbox"
				BorderElement.CornerRadius="4 0 0 4"
				Drop="TextBox_Drop"
				PreviewDragOver="TextBox_PreviewDragOver" />
		</DockPanel>
		<TextBlock
			Grid.Row="2"
			Grid.Column="0"
			Margin="4,0,0,0"
			VerticalAlignment="Center"
			Foreground="{DynamicResource ForegroundMain}">
			<Run
				Text="{DynamicResource Category}" /> <Run
				Text=":" /></TextBlock>
		<ComboBox
			Name="categoryCombobox"
			Grid.Row="2"
			Grid.Column="1"
			Margin="5"
			IsEditable="True"
			Text="Default" />
		<TextBlock
			Grid.Row="3"
			Grid.Column="0"
			Margin="4,0,0,0"
			VerticalAlignment="Center"
			Foreground="{DynamicResource ForegroundMain}">
			<Run
				Text="{DynamicResource Author}" /> <Run
				Text=":" /></TextBlock>
		<TextBox
			Name="authorTextbox"
			Grid.Row="3"
			Grid.Column="1"
			Margin="5" />
		<Button
			Name="acceptButton"
			Grid.Row="4"
			Grid.Column="0"
			Grid.ColumnSpan="3"
			Margin="5"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			IconElement.Geometry="M18.71,7.21 A1,1 0 0 0 17.29,7.21L9.84,14.67 L6.71,11.53 A1,1 1 1 0 5.29,13L9.129999999999999,16.84 A1,1 0 0 0 10.549999999999999,16.84L18.71,8.68 A1,1 0 0 0 18.71,7.21"
			Content="{DynamicResource Accept}"
			Click="acceptButton_Click" />
	</Grid>
</Page>
