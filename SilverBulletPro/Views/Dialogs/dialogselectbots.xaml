<Page
	x:Class="SilverBulletPro.DialogSelectBots" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="DialogSelectBots" xmlns:silverbulletpro="clr-namespace:SilverBulletPro"
	KeyDown="Page_KeyDown"
	Loaded="Page_Loaded">
	<Grid
		Margin="0,5,0,0">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<DockPanel
			Grid.Row="0"
			Margin="8,0,8,5">
			<TextBlock
				Margin="1,0,4,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Bots}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="botsNumberTextbox"
				Text="1"
				PreviewTextInput="botsNumberTextbox_PreviewTextInput" />
		</DockPanel>
		<Button
			Name="selectButton"
			Grid.Row="1"
			Margin="0,5,0,0"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			IconElement.Geometry="M18.71,7.21 A1,1 0 0 0 17.29,7.21L9.84,14.67 L6.71,11.53 A1,1 1 1 0 5.29,13L9.129999999999999,16.84 A1,1 0 0 0 10.549999999999999,16.84L18.71,8.68 A1,1 0 0 0 18.71,7.21"
			Content="{DynamicResource Select}"
			Click="selectButton_Click" />
	</Grid>
</Page>
