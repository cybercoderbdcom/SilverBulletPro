<Page
	x:Class="SilverBulletPro.DialogTestDataRules" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="DialogTestDataRules" xmlns:silverbulletpro="clr-namespace:SilverBulletPro">
	<Grid
		MaxWidth="280"
		MaxHeight="167"
		Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<StackPanel
			Grid.Row="0"
			VerticalAlignment="Center"
			Orientation="Horizontal">
			<Label
				Content="Wordlist Type:"
				FontWeight="Bold" />
			<Label
				Content="{Binding WordlistType}" />
		</StackPanel>
		<Label
			Grid.Row="1"
			Content="Slices:"
			FontWeight="Bold" />
		<ItemsControl
			Grid.Row="2"
			ItemsSource="{Binding SlicesCollection}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel
						Orientation="Vertical" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<StackPanel
						Margin="0,-5,0,-5"
						VerticalAlignment="Center"
						Orientation="Horizontal">
						<Label
							Content="{Binding Name}" />
						<Label
							Content="=" />
						<Label
							Content="{Binding Value}" />
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<Separator
			Grid.Row="3"
			Margin="0,5,0,0"
			Opacity="0.5" />
		<Label
			Grid.Row="4"
			Content="Results:"
			FontWeight="Bold" />
		<ScrollViewer
			Grid.Row="5"
			MaxHeight="300"
			Margin="5,0,0,0"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto">
			<ItemsControl
				ItemsSource="{Binding ResultsCollection}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel
							Orientation="Vertical" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<StackPanel
							VerticalAlignment="Center"
							Orientation="Horizontal">
							<PackIconForkAwesome
								FrameworkElement.VerticalAlignment="Center"
								Control.Foreground="{Binding Color}"
								PackIconForkAwesome.Kind="{Binding Icon}" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.ForkAwesome" />
							<Label
								Content="{Binding Text}" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</Page>
