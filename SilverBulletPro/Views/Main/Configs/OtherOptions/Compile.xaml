<Page
	x:Class="SilverBulletPro.Views.Main.Configs.OtherOptions.Compile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Compile" xmlns:otheroptions="clr-namespace:SilverBulletPro.Views.Main.Configs.OtherOptions">
	<Grid
		Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<StackPanel>
			<DockPanel
				Margin="0,0,0,5"
				Visibility="Collapsed">
				<TextBlock
					Margin="5,0,5,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource OtherOptions_Compiler_TargetFramework}" /> <Run
						Text=":" /></TextBlock>
				<ComboBox
					Name="targetFrameworkBox"
					Margin="5,0,0,0"
					Foreground="{DynamicResource ForegroundMain}"
					SelectedItem="{Binding TargetFrameworkComp}" />
			</DockPanel>
			<DockPanel
				Margin="0,0,0,5">
				<TextBlock
					Margin="5,0,5,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource OtherOptions_Compiler_AssemblyName}" /> <Run
						Text=":" /></TextBlock>
				<TextBox
					Margin="5,0,0,0"
					Foreground="{DynamicResource ForegroundMain}"
					Text="{Binding AssemblyName}" />
			</DockPanel>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition />
					<ColumnDefinition
						Width="auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Margin="5,0,5,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource OtherOptions_Compiler_IconPath}" /> <Run
						Text=":" /></TextBlock>
				<TextBox
					Grid.Column="1"
					Margin="5,0,0,0"
					BorderElement.CornerRadius="4 0 0 4"
					Foreground="{DynamicResource ForegroundMain}"
					Text="{Binding IconPath}"
					TextChanged="IconPath_TextChanged" />
				<Button
					Grid.Column="2"
					BorderElement.CornerRadius="0 4 4 0"
					BorderBrush="{DynamicResource BorderBrush}"
					BorderThickness="0,1,1,1"
					Click="SelectIcon_Click">
					<DockPanel>
						<iconpacks:PackIconModern
							FrameworkElement.Margin="0,1,5,0"
							PackIconModern.Kind="ImageSelect" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Modern" />
						<TextBlock
							Margin="0,0,4,0"
							Text="{DynamicResource OtherOptions_Compiler_SelectIcon}" />
					</DockPanel>
				</Button>
			</Grid>
			<Grid
				Margin="0,5,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Margin="5,0,5,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundToCheck}">
					<Run
						Text="{DynamicResource OtherOptions_Compiler_References}" /> <Run
						Text=":" /></TextBlock>
				<ComboBox
					Name="refsComboBox"
					Grid.Column="1"
					BorderElement.CornerRadius="4 0 0 4"
					ItemsSource="{Binding CsRefs}" />
				<DockPanel
					Grid.Column="2">
					<Button
						Name="clearLib"
						Width="37"
						Padding="6,0,0,0"
						HorizontalAlignment="Right"
						BorderElement.CornerRadius="0 4 0 0"
						IconElement.Geometry="M9,3 L9,4 L4,4 L4,6 L5,6 L5,19 A2,2 0 0 0 7,21L17,21 A2,2 0 0 0 19,19L19,6 L20,6 L20,4 L15,4 L15,3 L9,3 M9,8 L11,8 L11,17 L9,17 L9,8 M13,8 L15,8 L15,17 L13,17 L13,8"
						IconElement.Width="14"
						Background="{DynamicResource BackgroundSecondary}"
						BorderThickness="0,1,1,1"
						DockPanel.Dock="Right"
						Click="ClearLibs_Click" />
					<Button
						Name="removeLib"
						Width="37"
						Padding="7,0,0,0"
						HorizontalAlignment="Right"
						BorderElement.CornerRadius="0 0 0 0"
						IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
						IconElement.Width="17"
						Background="{DynamicResource BackgroundSecondary}"
						BorderThickness="0,1,1,1"
						DockPanel.Dock="Right"
						Click="RemoveLib_Click" />
					<Button
						Name="addLib"
						Width="37"
						Padding="6,0,0,0"
						HorizontalAlignment="Right"
						BorderElement.CornerRadius="0"
						IconElement.Geometry="M512,960 C230.39999999999998,960 0,729.6 0,448 C0,166.39999999999998 230.4,-64 512,-64 C793.6,-64 1024,166.4 1024,448 C1024,729.6 793.6,960 512,960 M832,384 L576,384 L576,128 L448,128 L448,384 L192,384 L192,512 L448,512 L448,768 L576,768 L576,512 L832,512 L832,384"
						IconElement.Width="17"
						Background="{DynamicResource BackgroundSecondary}"
						BorderThickness="1,1,0,1"
						DockPanel.Dock="Right"
						Click="AddLib_Click" />
				</DockPanel>
			</Grid>
		</StackPanel>
		<avalonedit:TextEditor
			TextEditor.Name="csEditor"
			Grid.Row="1"
			FrameworkElement.Margin="4,4,4,2"
			Control.Background="{DynamicResource BackgroundSecondary}"
			Control.BorderBrush="{DynamicResource BorderBrush}"
			Control.BorderThickness="1"
			Control.FontSize="10pt"
			Control.Foreground="{DynamicResource ForegroundMain}"
			TextEditor.LineNumbersForeground="{DynamicResource ForegroundMain}" xmlns:avalonedit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
			x:Name="csEditor"
			KeyDown="csEditor_KeyDown"
			LostFocus="CsEditor_LostFocus" />
		<DockPanel
			Grid.Row="2">
			<Button
				Width="100"
				Height="30"
				Margin="0,-2,4,0"
				VerticalAlignment="Center"
				BorderElement.CornerRadius="0 0 4 0"
				IconElement.Geometry="M474.1,398.2 L289.1,212 C307.40000000000003,165 297.20000000000005,109.7 258.6,70.9 C217.9,30 156.9,21.8 108.1,44.3 L195.5,132.3 L134.5,193.70000000000002 L45,105.70000000000002 C20.7,154.70000000000002 30.9,216.10000000000002 71.5,257 C110.1,295.9 165,306.1 211.8,287.7 L396.8,473.9 C404.90000000000003,482.09999999999997 417.1,482.09999999999997 425.3,473.9 L472.1,426.9 C482.3,418.59999999999997 482.3,404.29999999999995 474.1,398.2"
				IconElement.Width="16"
				BorderThickness="0.5,0,1,1"
				Content="{DynamicResource OtherOptions_Compiler_BtnCompile}"
				DockPanel.Dock="Right"
				Foreground="{DynamicResource InfoBrush}"
				Click="Compile_Click" />
			<Button
				Width="105"
				Height="30"
				Margin="0,-2,0,0"
				VerticalAlignment="Center"
				BorderElement.CornerRadius="0 0 0 4"
				IconElement.Geometry="M19,20 L4,20 C2.89,20 2,19.1 2,18 L2,6 C2,4.89 2.89,4 4,4 L10,4 L12,6 L19,6 A2,2 0 0 1 21,8L21,8 L4,8 L4,18 L6.14,10 L23.21,10 L20.93,18.5 C20.7,19.37 19.92,20 19,20"
				IconElement.Width="16"
				BorderThickness="1,0,0.5,1"
				Content="{DynamicResource OtherOptions_Compiler_OpenFolder}"
				DockPanel.Dock="Right"
				Click="OpenFolder_Click" />
			<Label
				Name="compilerVersion"
				VerticalAlignment="Bottom"
				FontSize="13"
				FontWeight="Bold"
				Foreground="{DynamicResource ForegroundOcrRate}"
				ToolTip="Version" />
		</DockPanel>
	</Grid>
</Page>
