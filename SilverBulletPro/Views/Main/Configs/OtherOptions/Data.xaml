<Page
	x:Class="SilverBulletPro.Views.Main.Configs.OtherOptions.Data" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:SilverBulletPro.Core.Models;assembly=SilverBulletPro.Core"
	Title="ConfigOtherOptionsData" xmlns:otheroptions="clr-namespace:SilverBulletPro.Views.Main.Configs.OtherOptions">
	<ScrollViewer
		Margin="0,0,5,5"
		HorizontalScrollBarVisibility="Disabled"
		VerticalScrollBarVisibility="Auto">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<StackPanel
				Margin="10,11,0,10">
				<TextBlock
					Margin="2,0,0,0"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource OtherOptions_Data_AllowedWordlistTypes}" /> <Run
						Text=":" /></TextBlock>
				<Grid
					Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition
							Width="auto" />
						<ColumnDefinition
							Width="auto" />
					</Grid.ColumnDefinitions>
					<ComboBox
						Name="allowedWordlistTypeComboBox"
						Margin="0,0,0,0"
						BorderElement.CornerRadius="3"
						IsEditable="True"
						ItemsSource="{Binding AllowedWordlistType}" />
					<Button
						Grid.Column="1"
						Width="auto"
						Height="20"
						Margin="11,0,5,0"
						Padding="0"
						IconElement.Geometry="M512,960 C230.39999999999998,960 0,729.6 0,448 C0,166.39999999999998 230.4,-64 512,-64 C793.6,-64 1024,166.4 1024,448 C1024,729.6 793.6,960 512,960 M832,384 L576,384 L576,128 L448,128 L448,384 L192,384 L192,512 L448,512 L448,768 L576,768 L576,512 L832,512 L832,384"
