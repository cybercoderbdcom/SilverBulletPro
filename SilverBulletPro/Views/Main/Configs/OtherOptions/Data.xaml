				Row="4"
				Margin="10,13,0,0"
				IsEnabled="False"
				Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="auto" />
					<RowDefinition
						Height="auto" />
					<RowDefinition
						Height="auto" />
				</Grid.RowDefinitions>
				<TextBlock
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource OtherOptions_Data_Resources}" /> <Run
						Text=":" /></TextBlock>
				<DockPanel
					Grid.Row="1"
					Margin="-1,7,0,0"
					HorizontalAlignment="Left">
					<Button
						Width="127"
						BorderElement.CornerRadius="4 0 0 4"
						IconElement.Geometry="M12,9 L7,9 L7,14 L5,14 L5,9 L0,9 L0,7 L5,7 L5,2 L7,2 L7,7 L12,7 L12,9"
						IconElement.Width="14"
						BorderThickness="1,1,0,1"
						Content="{DynamicResource OtherOptions_Data_LinesFromFile}"
						Click="AddLinesFromFileResourceButton_Click" />
					<Button
						Width="165"
						BorderElement.CornerRadius="0 4 4 0"
						IconElement.Geometry="M12,9 L7,9 L7,14 L5,14 L5,9 L0,9 L0,7 L5,7 L5,2 L7,2 L7,7 L12,7 L12,9"
						IconElement.Width="14"
						BorderThickness="0,1,1,1"
						Content="{DynamicResource OtherOptions_Data_RandomLinesFromFile}"
						Click="AddRandomLinesFromFileResourceButton_Click" />
				</DockPanel>
				<ItemsControl
					Grid.Row="2"
					ItemsSource="{Binding Resources}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel
								Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<DataTemplate
								DataType="{x:Type models:LinesFromFileResourceOptions}"
								x:Key="{DataTemplateKey {x:Type models:LinesFromFileResourceOptions}}">
								<Border
									Padding="0,5">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="auto" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Margin="0,0,2,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ForegroundMain}">
											<Run
												Text="{DynamicResource OtherOptions_Data_Name}" /> <Run
												Text=":" /></TextBlock>
										<TextBox
											Grid.Column="1"
											Height="30"
											Margin="4,0"
											Foreground="{DynamicResource ForegroundMain}"
											Text="{Binding Name}" />
										<TextBlock
											Grid.Column="2"
											Margin="5,0,4,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ForegroundMain}">
											<Run
												Text="{DynamicResource OtherOptions_Data_Location}" /> <Run
												Text=":" /></TextBlock>
										<TextBox
											Grid.Column="3"
											Height="30"
											Margin="4,0"
											Foreground="{DynamicResource ForegroundMain}"
											Text="{Binding Location}" />
										<CheckBox
											Grid.Column="4"
											Margin="4,0"
											VerticalContentAlignment="Center"
											Content="{DynamicResource OtherOptions_Data_LoopsAround}"
											Foreground="{DynamicResource ForegroundMain}"
											IsChecked="{Binding LoopsAround}" />
										<CheckBox
											Grid.Column="5"
											Margin="4,0"
											VerticalContentAlignment="Center"
											Content="{DynamicResource OtherOptions_Data_IgnoreEmptyLines}"
											Foreground="{DynamicResource ForegroundMain}"
											IsChecked="{Binding IgnoreEmptyLines}" />
										<!--Unknown connection ID: 12-->
										<Button
											Grid.Column="6"
											Width="auto"
											Height="20"
											Margin="5,0,5,0"
											Padding="0"
											IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
											Background="#00FFFFFF"
											Foreground="{DynamicResource ForegroundMain}"
											Style="{StaticResource ButtonIcon}"
											Tag="{Binding}" />
									</Grid>
								</Border>
							</DataTemplate>
							<DataTemplate
								DataType="{x:Type models:RandomLinesFromFileResourceOptions}"
								x:Key="{DataTemplateKey {x:Type models:RandomLinesFromFileResourceOptions}}">
								<Border
									Padding="0,5">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="auto" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Margin="0,0,2,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ForegroundMain}">
											<Run
												Text="{DynamicResource OtherOptions_Data_Name}" /> <Run
												Text=":" /></TextBlock>
										<TextBox
											Grid.Column="1"
											Height="30"
											Margin="4,0"
											Foreground="{DynamicResource ForegroundMain}"
											Text="{Binding Name}" />
										<TextBlock
											Grid.Column="2"
											Margin="5,0,4,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ForegroundMain}">
											<Run
												Text="{DynamicResource OtherOptions_Data_Location}" /> <Run
												Text=":" /></TextBlock>
										<TextBox
											Grid.Column="3"
											Height="30"
											Margin="4,0"
											Foreground="{DynamicResource ForegroundMain}"
											Text="{Binding Location}" />
										<CheckBox
											Grid.Column="4"
											Margin="4,0"
											VerticalContentAlignment="Center"
											Content="{DynamicResource OtherOptions_Data_Unique}"
											Foreground="{DynamicResource ForegroundMain}"
											IsChecked="{Binding Unique}" />
										<CheckBox
											Grid.Column="5"
											Margin="4,0"
											VerticalContentAlignment="Center"
											Content="{DynamicResource OtherOptions_Data_IgnoreEmptyLines}"
											Foreground="{DynamicResource ForegroundMain}"
											IsChecked="{Binding IgnoreEmptyLines}" />
										<!--Unknown connection ID: 13-->
										<Button
											Grid.Column="6"
											Width="auto"
											Height="20"
											Margin="0,0,5,0"
											Padding="0"
											IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
											Background="#00FFFFFF"
											Foreground="{DynamicResource ForegroundMain}"
											Style="{StaticResource ButtonIcon}"
											Tag="{Binding}" />
									</Grid>
								</Border>
							</DataTemplate>
						</ResourceDictionary>
					</FrameworkElement.Resources>
				</ItemsControl>
			</Grid>
		</Grid>
	</ScrollViewer>
</Page>
