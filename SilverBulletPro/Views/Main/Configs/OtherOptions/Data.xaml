						Foreground="{DynamicResource ForegroundMain}"
						Style="{StaticResource ButtonIcon}" />
				</Grid>
			</StackPanel>
			<CheckBox
				Grid.Row="1"
				Margin="10,0,0,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource OtherOptions_Data_UrlEncodeDataAfterSlicing}"
				Foreground="{DynamicResource ForegroundMain}"
				IsChecked="{Binding EncodeData}" />
			<Grid
				Row="2"
				Margin="10,13,0,0">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="auto" />
					<RowDefinition
						Height="auto" />
					<RowDefinition
						Height="auto" />
					<RowDefinition
						Height="auto" />
				</Grid.RowDefinitions>
				<TextBlock
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource OtherOptions_Data_Rules}" /> <Run
						Text=":" /></TextBlock>
				<DockPanel
					Grid.Row="1"
					Margin="-1,6,0,0"
					HorizontalAlignment="Left">
					<Button
						Width="90"
						BorderElement.CornerRadius="4 0 0 4"
						IconElement.Geometry="M12,9 L7,9 L7,14 L5,14 L5,9 L0,9 L0,7 L5,7 L5,2 L7,2 L7,7 L12,7 L12,9"
						IconElement.Width="14"
						BorderThickness="1,1,0.5,1"
						Content="{DynamicResource OtherOptions_Data_Simple}"
						Click="AddSimpleDataRuleButton_Click" />
					<Button
						Width="90"
						BorderElement.CornerRadius="0 4 4 0"
						IconElement.Geometry="M12,9 L7,9 L7,14 L5,14 L5,9 L0,9 L0,7 L5,7 L5,2 L7,2 L7,7 L12,7 L12,9"
						IconElement.Width="14"
						BorderThickness="0.5,1,1,1"
