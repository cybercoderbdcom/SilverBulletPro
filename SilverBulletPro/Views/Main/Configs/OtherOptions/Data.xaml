					ItemsSource="{Binding DataRules}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel
								Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<DataTemplate
								DataType="{x:Type models:SimpleDataRule}"
								x:Key="{DataTemplateKey {x:Type models:SimpleDataRule}}">
								<Border
									Padding="0,5">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="auto" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Margin="0,0,2,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ForegroundMain}">
											<Run
												Text="{DynamicResource OtherOptions_Data_SliceName}" /> <Run
												Text=":" /></TextBlock>
										<TextBox
											Grid.Column="1"
											Height="30"
											Margin="4,0"
											Text="{Binding SliceName}" />
										<ComboBox
											Grid.Column="2"
											Height="30"
											Margin="4,0"
											Foreground="{DynamicResource ForegroundMain}"
											ItemsSource="{Binding DataContext.StringRules, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
											SelectedItem="{Binding Comparison}" />
										<TextBox
											Grid.Column="3"
											Height="30"
											Margin="4,0"
											Foreground="{DynamicResource ForegroundMain}"
											Text="{Binding StringToCompare}" />
										<CheckBox
											Grid.Column="4"
											Margin="4,0"
											VerticalContentAlignment="Center"
											Content="{DynamicResource OtherOptions_Data_CaseSensitive}"
											Foreground="{DynamicResource ForegroundMain}"
											IsChecked="{Binding CaseSensitive}" />
										<CheckBox
											Grid.Column="5"
											Margin="4,0"
											VerticalContentAlignment="Center"
											Content="{DynamicResource OtherOptions_Data_Invert}"
											Foreground="{DynamicResource ForegroundMain}"
											IsChecked="{Binding Invert}" />
										<!--Unknown connection ID: 8-->
										<Button
											Grid.Column="6"
											Width="auto"
											Height="20"
											Margin="6,0,5,0"
											Padding="0"
											IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
											Background="#00FFFFFF"
											Foreground="{DynamicResource ForegroundMain}"
											Style="{StaticResource ButtonIcon}"
											CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
											Tag="{Binding}" />
									</Grid>
								</Border>
							</DataTemplate>
							<DataTemplate
								DataType="{x:Type models:RegexDataRule}"
								x:Key="{DataTemplateKey {x:Type models:RegexDataRule}}">
								<Border
									Padding="0,5">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="*" />
											<ColumnDefinition
												Width="auto" />
											<ColumnDefinition
												Width="auto" />
										</Grid.ColumnDefinitions>
										<TextBlock
											Grid.Column="0"
											Margin="0,0,2,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ForegroundMain}">
											<Run
												Text="{DynamicResource OtherOptions_Data_SliceName}" /> <Run
												Text=":" /></TextBlock>
										<TextBox
											Grid.Column="1"
											Height="30"
											Margin="4,0"
											Foreground="{DynamicResource ForegroundMain}"
											Text="{Binding SliceName}" />
										<TextBlock
											Grid.Column="2"
											Margin="4,0,3,0"
											VerticalAlignment="Center"
											Foreground="{DynamicResource ForegroundMain}">
											<Run
												Text="{DynamicResource OtherOptions_Data_RegexToMatch}" /> <Run
												Text=":" /></TextBlock>
										<TextBox
											Grid.Column="3"
											Height="30"
											Margin="4,0"
											Foreground="{DynamicResource ForegroundMain}"
											Text="{Binding RegexToMatch}" />
										<CheckBox
											Grid.Column="4"
											Margin="4,0"
											VerticalContentAlignment="Center"
											Content="{DynamicResource OtherOptions_Data_Invert}"
											Foreground="{DynamicResource ForegroundMain}"
											IsChecked="{Binding Invert}" />
										<!--Unknown connection ID: 9-->
										<Button
											Grid.Column="5"
											Width="auto"
											Height="20"
											Margin="5,0,5,0"
											Padding="0"
											IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
											Background="#00FFFFFF"
											Foreground="{DynamicResource ForegroundMain}"
											Style="{StaticResource ButtonIcon}"
											Tag="{Binding}" />
									</Grid>
								</Border>
							</DataTemplate>
						</ResourceDictionary>
					</FrameworkElement.Resources>
				</ItemsControl>
			</Grid>
			<Separator
				Grid.Row="3"
				Margin="6,18,6,4"
				Visibility="Hidden" />
