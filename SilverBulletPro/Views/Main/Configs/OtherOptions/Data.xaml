						Name="testAllowedWordlistTypeComboBox"
						Grid.Column="2"
						Width="100"
						BorderElement.CornerRadius="0 0 0 0"
						Foreground="{DynamicResource ForegroundMain}"
						ItemsSource="{Binding TestAllowedWordlistTypes}"
						SelectedItem="{Binding TestWordlistTypeForRules}" />
