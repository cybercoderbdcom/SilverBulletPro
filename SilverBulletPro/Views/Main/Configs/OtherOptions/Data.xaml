						<ColumnDefinition
							Width="auto" />
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="auto" />
						<ColumnDefinition
							Width="auto" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Margin="0,0,9,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundMain}">
						<Run
							Text="{DynamicResource OtherOptions_Data_TestYourDataHere}" /> <Run
							Text=":" /></TextBlock>
