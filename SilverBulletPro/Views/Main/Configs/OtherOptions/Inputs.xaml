<Page
	x:Class="SilverBulletPro.Views.Main.Configs.OtherOptions.Inputs" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="ConfigOtherOptionsInput" xmlns:otheroptions="clr-namespace:SilverBulletPro.Views.Main.Configs.OtherOptions">
	<Grid
		Margin="5,13,5,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<DockPanel
			HorizontalAlignment="Left">
			<Button
				Width="110"
				Padding="10,5,5,5"
				BorderElement.CornerRadius="4 0 0 4"
				IconElement.Geometry="M12,9 L7,9 L7,14 L5,14 L5,9 L0,9 L0,7 L5,7 L5,2 L7,2 L7,7 L12,7 L12,9"
				IconElement.Width="14"
				BorderThickness="1,1,0.5,1"
				Content="{DynamicResource OtherOptions_Inputs_AddInput}"
				Click="addInputButton_Click" />
			<Button
				Width="115"
				BorderElement.CornerRadius="0 4 4 0"
				IconElement.Geometry="M128,405.429 C128,428.846 147.198,448 170.667,448 L341.334,448 C364.802,448 384,428.846 384,405.429 L384,160 L128,160 L128,405.429 M416,96 L336,96 L309.215,64 L202.786,64 L176,96 L96,96 L96,128 L416,128 L416,96"
				IconElement.Width="11"
				BorderThickness="0.5,1,1,1"
				Content="{DynamicResource OtherOptions_Inputs_ClearInputs}"
				Click="clearInputsButton_Click" />
		</DockPanel>
		<ItemsControl
			Name="customInputsControl"
			Grid.Row="1"
			Margin="0,3,0,0"
			Foreground="{DynamicResource ForegroundLabelConfigSettings}"
			ItemsSource="{Binding CustomInputs}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel
						Orientation="Vertical" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border
						Padding="0,4">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="auto" />
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="auto" />
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="auto" />
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="auto" />
							</Grid.ColumnDefinitions>
							<TextBlock
								Margin="6,0,5,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundMain}">
								<Run
									Text="{DynamicResource OtherOptions_Inputs_Description}" /> <Run
									Text=":" /></TextBlock>
							<TextBox
								Grid.Column="1"
								Height="30"
								Margin="4,0"
								Foreground="{DynamicResource ForegroundMain}"
								Text="{Binding Description}" />
							<TextBlock
								Grid.Column="2"
								Margin="8,0,5,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundMain}">
								<Run
									Text="{DynamicResource OtherOptions_Inputs_VariableName}" /> <Run
									Text=":" /></TextBlock>
							<TextBox
								Grid.Column="3"
								Height="30"
								Margin="4,0"
								Foreground="{DynamicResource ForegroundMain}"
								Text="{Binding VariableName}" />
							<TextBlock
								Grid.Column="4"
								Margin="8,0,5,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundMain}">
								<Run
									Text="{DynamicResource OtherOptions_Inputs_DefaultAnswer}" /> <Run
									Text=":" /></TextBlock>
							<TextBox
								Grid.Column="5"
								Height="30"
								Margin="4,0"
								Foreground="{DynamicResource ForegroundMain}"
								Text="{Binding DefaultAnswer}" />
							<!--Unknown connection ID: 4-->
							<Button
								Grid.Column="6"
								Width="auto"
								Height="20"
								Margin="6,0,5,0"
								Padding="0"
								IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
								Style="{StaticResource ButtonIcon}"
								CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
								Tag="{Binding Id}" />
						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</Page>
