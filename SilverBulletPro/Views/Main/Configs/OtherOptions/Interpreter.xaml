<Page
	x:Class="SilverBulletPro.Views.Main.Configs.OtherOptions.Interpreter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Interpreter" xmlns:otheroptions="clr-namespace:SilverBulletPro.Views.Main.Configs.OtherOptions">
	<Grid
		Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<DockPanel>
			<TextBlock
				Margin="3,5,5,5"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource OtherOptions_Interpreter}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="interpreterBox"
				SelectionChanged="InterpreterBox_SelectionChanged" />
		</DockPanel>
		<Grid
			Row="1"
			Background="{DynamicResource BackgroundMain}">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<DockPanel
				Grid.Row="1"
				Margin="2,5,0,0">
				<TextBlock
					Margin="5"
					Foreground="{DynamicResource ForegroundToCheck}">
					<Run
						Text="{DynamicResource OtherOptions_Interpreter_Libs}" /> <Run
						Text=":" /></TextBlock>
				<Button
					Name="clearLib"
					Width="37"
					Padding="6,0,0,0"
					HorizontalAlignment="Right"
					BorderElement.CornerRadius="0 4 0 0"
					IconElement.Geometry="M9,3 L9,4 L4,4 L4,6 L5,6 L5,19 A2,2 0 0 0 7,21L17,21 A2,2 0 0 0 19,19L19,6 L20,6 L20,4 L15,4 L15,3 L9,3 M9,8 L11,8 L11,17 L9,17 L9,8 M13,8 L15,8 L15,17 L13,17 L13,8"
					IconElement.Width="14"
					Background="{DynamicResource BackgroundSecondary}"
					BorderThickness="0,1,1,1"
					DockPanel.Dock="Right"
					Click="ClearLibs_Click" />
				<Button
					Name="removeLib"
					Width="37"
					Padding="7,0,0,0"
					HorizontalAlignment="Right"
					BorderElement.CornerRadius="0 0 0 0"
					IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
					IconElement.Width="17"
					Background="{DynamicResource BackgroundSecondary}"
					BorderThickness="0,1,1,1"
					DockPanel.Dock="Right"
					Click="RemoveLib_Click" />
				<Button
					Name="addLib"
					Width="37"
					Padding="6,0,0,0"
					HorizontalAlignment="Right"
					BorderElement.CornerRadius="4 0 0 0"
					IconElement.Geometry="M512,960 C230.39999999999998,960 0,729.6 0,448 C0,166.39999999999998 230.4,-64 512,-64 C793.6,-64 1024,166.4 1024,448 C1024,729.6 793.6,960 512,960 M832,384 L576,384 L576,128 L448,128 L448,384 L192,384 L192,512 L448,512 L448,768 L576,768 L576,512 L832,512 L832,384"
					IconElement.Width="17"
					Background="{DynamicResource BackgroundSecondary}"
					BorderThickness="1,1,0,1"
					DockPanel.Dock="Right"
					Click="AddLib_Click" />
			</DockPanel>
			<ListBox
				Name="listBox"
				Grid.Row="2"
				AllowDrop="True"
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}"
				DragEnter="DropList_DragEnter"
				Drop="DropList_Drop">
				<FrameworkElement.ContextMenu>
					<ContextMenu
						Name="listBoxMenu">
						<MenuItem
							Header="{DynamicResource OtherOptions_Interpreter_GetSitePkgPath}"
							Click="GetPySitePkg_Click" />
					</ContextMenu>
				</FrameworkElement.ContextMenu>
			</ListBox>
			<DockPanel
				Grid.Row="3">
				<Label
					Margin="0,2,0,0"
					Content="Count:"
					Foreground="{DynamicResource ForegroundMain}" />
				<TextBlock
					Name="libCount"
					Margin="0,4,0,0"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundCustom}"
					Text="0" />
			</DockPanel>
		</Grid>
	</Grid>
</Page>
