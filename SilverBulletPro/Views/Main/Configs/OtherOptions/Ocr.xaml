<Page
	x:Class="SilverBulletPro.Views.Main.Configs.OtherOptions.Ocr" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Ocr" xmlns:otheroptions="clr-namespace:SilverBulletPro.Views.Main.Configs.OtherOptions"
	Loaded="Page_Loaded">
	<Grid
		Margin="10,5,10,0">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<CheckBox
			Grid.Row="0"
			Margin="2,8,0,5"
			Content="{DynamicResource Ocr_EnableTestMode}"
			IsChecked="{Binding EnableTestMode}"
			Click="EnableTestMode_Click" />
		<CheckBox
			Grid.Row="1"
			Margin="2,1,0,15"
			Content="{DynamicResource Ocr_ApplyOnlyFilters}"
			IsChecked="{Binding ApplyOnlyFilters}" />
		<DockPanel
			Grid.Row="2"
			Margin="0,0,0,5">
			<TextBlock
				Margin="5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ocr_Tessdata}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Margin="2,0,0,0"
				Text="{Binding TessdataFolderPath, Mode=TwoWay}" />
		</DockPanel>
		<DockPanel
			Grid.Row="3"
			Margin="0,0,0,10">
			<TextBlock
				Margin="5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ocr_TessernetDataPath}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Margin="2,0,0,0"
				Text="{Binding TessernetDataPath, Mode=TwoWay}" />
		</DockPanel>
		<Grid
			Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<TextBlock
				Margin="5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ocr_VariableName}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="varName"
				Grid.Column="1"
				Margin="2,0,0,0" />
		</Grid>
		<Grid
			Row="5"
			Margin="0,5,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<TextBlock
				Margin="5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ocr_VariableValue}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Name="varValue"
				Grid.Column="1"
				Margin="5,0,0,0" />
		</Grid>
		<Grid
			Row="6"
			Margin="0,5,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<TextBlock
				Margin="5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ocr_ValueType}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="varValueType"
				Grid.Column="1"
				Margin="23,0,0,0"
				SelectedIndex="0" />
		</Grid>
		<Grid
			Row="7"
			Margin="0,5,0,7">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition
					Width="auto" />
			</Grid.ColumnDefinitions>
			<ListBox
				Name="variableLB"
				Height="140"
				Background="{DynamicResource BackgroundSecondary}"
				FontFamily="Consolas"
				Foreground="{DynamicResource ForegroundMain}"
				ItemsSource="{Binding VariableList}">
				<FrameworkElement.ContextMenu>
					<ContextMenu>
						<MenuItem
							Header="{DynamicResource Copy}"
							Click="MenuItem_Click">
							<MenuItem.Icon>
								<iconpacks:FontAwesomeExtension
									FontAwesomeExtension.Kind="CopySolid" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" />
							</MenuItem.Icon>
						</MenuItem>
					</ContextMenu>
				</FrameworkElement.ContextMenu>
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{Binding ElementName=variableLB, Path=Background}"
							x:Key="RegionBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ListBox>
			<StackPanel
				Grid.Column="1">
				<Button
					Width="50"
					Height="28"
					Padding="5,5,0,5"
					BorderElement.CornerRadius="0"
					IconElement.Geometry="M416,208 L272,208 L272,64 C272,46.33 257.67,32 240,32 L208,32 C190.32999999999998,32 176,46.33 176,64 L176,208 L32,208 C14.329999999999998,208 0,222.33 0,240 L0,272 C0,289.67 14.33,304 32,304 L176,304 L176,448 C176,465.67 190.33,480 208,480 L240,480 C257.67,480 272,465.67 272,448 L272,304 L416,304 C433.67,304 448,289.67 448,272 L448,240 C448,222.32999999999998 433.67,208 416,208"
					IconElement.Width="15"
					BorderThickness="0,1,1,1"
					ToolTip="{DynamicResource Ocr_AddVarsTip}"
					Click="btnVariableAdd_Click" />
				<Button
					Width="50"
					Height="28"
					Padding="5,5,0,5"
					BorderElement.CornerRadius="0"
					IconElement.Geometry="M128,320 L256,192 L384,320"
					IconElement.Width="15"
					BorderThickness="0,1,1,1"
					ToolTip="{DynamicResource Ocr_UpVarsTip}"
					Click="btnVariableUp_Click" />
				<Button
					Width="50"
					Height="28"
					Padding="5,5,0,5"
					BorderElement.CornerRadius="0"
					IconElement.Geometry="M128,192 L256,320 L384,192"
					IconElement.Width="15"
					BorderThickness="0,1,1,1"
					ToolTip="{DynamicResource Ocr_DownVarsTip}"
					Click="btnVariableDown_Click" />
				<Button
					Width="50"
					Height="28"
					Padding="5,5,0,5"
					BorderElement.CornerRadius="0"
					IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
					IconElement.Width="15"
					BorderThickness="0,1,1,1"
					ToolTip="{DynamicResource Ocr_RemoveVarsTip}"
					Click="btnVariableRemove_Click" />
				<Button
					Width="50"
					Height="28"
					Padding="0,5,5,5"
					BorderElement.CornerRadius="0"
					BorderThickness="0,1,1,1"
					ToolTip="{DynamicResource Ocr_ClearVarsTip}"
					Click="btnVariableClear_Click">
					<DockPanel>
						<iconpacks:PackIconCodicons
							FrameworkElement.Width="20"
							FrameworkElement.HorizontalAlignment="Center"
							FrameworkElement.VerticalAlignment="Center"
							PackIconCodicons.Kind="ClearAll" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Codicons" />
					</DockPanel>
				</Button>
			</StackPanel>
			<DockPanel
				Grid.Row="1"
				Margin="0,8,0,0">
				<TextBlock
					Margin="5"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource Ocr_VariableCount}" /> <Run
						Text=":" /> <TextBlock
						Text="{Binding VariableList.Count}" /></TextBlock>
			</DockPanel>
		</Grid>
	</Grid>
</Page>
