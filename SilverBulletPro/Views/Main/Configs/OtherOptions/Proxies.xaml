<Page
	x:Class="SilverBulletPro.Views.Main.Configs.OtherOptions.Proxies" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="ConfigOtherOptionsProxies" xmlns:otheroptions="clr-namespace:SilverBulletPro.Views.Main.Configs.OtherOptions">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<StackPanel
			Margin="10,11,0,0"
			HorizontalAlignment="Left">
			<CheckBox
				Margin="0,0,0,5"
				HorizontalAlignment="Left"
				Content="{DynamicResource Proxies_UseProxies}"
				Foreground="{DynamicResource ForegroundMain}"
				IsChecked="{Binding NeedsProxies}" />
			<CheckBox
				Margin="0,0,0,5"
				HorizontalAlignment="Left"
				Content="{DynamicResource Proxies_UseOnlySocksProxies}"
				IsChecked="{Binding OnlySocks}" />
			<CheckBox
				HorizontalAlignment="Left"
				Content="{DynamicResource Proxies_UseOnlySSLProxies}"
				Foreground="{DynamicResource ForegroundMain}"
				IsChecked="{Binding OnlySsl}" />
		</StackPanel>
		<DockPanel
			Grid.Row="1"
			Margin="10,8,0,0">
			<TextBlock
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Proxies_MaxUsesPerProxy}" /> <Run
					Text=":" /></TextBlock>
			<NumericUpDown
				FrameworkElement.MinWidth="75"
				FrameworkElement.Margin="21,2,0,0"
				FrameworkElement.HorizontalAlignment="Left"
				FrameworkElement.VerticalAlignment="Center"
				FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
				Control.Foreground="{DynamicResource ForegroundMain}"
				NumericUpDown.Minimum="0"
				NumericUpDown.Value="{Binding MaxProxyUses}" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
		</DockPanel>
		<DockPanel
			Grid.Row="2"
			Margin="10,5,0,0">
			<TextBlock
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Proxies_BanLoopEvasion}" /> <Run
					Text=":" /></TextBlock>
			<NumericUpDown
				FrameworkElement.MinWidth="75"
				FrameworkElement.Margin="21,2,0,0"
				FrameworkElement.HorizontalAlignment="Left"
				FrameworkElement.VerticalAlignment="Center"
				FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
				Control.Foreground="{DynamicResource ForegroundMain}"
				NumericUpDown.Minimum="-1"
				NumericUpDown.Value="{Binding BanLoopEvasionOverride}" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
		</DockPanel>
		<StackPanel
			Grid.Row="3"
			Margin="10,11,0,0">
			<TextBlock
				Margin="1,0,0,0"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Proxies_BanProxyOnStatuses}" /> <Run
					Text=":" /></TextBlock>
			<Grid
				Margin="0,5,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition
						Width="auto" />
				</Grid.ColumnDefinitions>
				<ComboBox
					Name="banProxyAfterStatusComboBox"
					Margin="0,0,0,0"
					BorderElement.CornerRadius="3"
					IsEditable="True"
					ItemsSource="{Binding BanProxyOnStatuses}" />
				<Button
					Grid.Column="1"
					Width="auto"
					Height="20"
					Margin="11,0,5,0"
					Padding="0"
					IconElement.Geometry="M512,960 C230.39999999999998,960 0,729.6 0,448 C0,166.39999999999998 230.4,-64 512,-64 C793.6,-64 1024,166.4 1024,448 C1024,729.6 793.6,960 512,960 M832,384 L576,384 L576,128 L448,128 L448,384 L192,384 L192,512 L448,512 L448,768 L576,768 L576,512 L832,512 L832,384"
					Background="#00FFFFFF"
					Foreground="{DynamicResource ForegroundMain}"
					Style="{StaticResource ButtonIcon}"
					Click="AddBanProxyOnStatuses_Click" />
				<Button
					Grid.Column="2"
					Width="auto"
					Height="20"
					Margin="0,0,6,0"
					Padding="0"
					IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
					Background="#00FFFFFF"
					Foreground="{DynamicResource ForegroundMain}"
					Style="{StaticResource ButtonIcon}"
					Click="RemoveBanProxyOnStatuses_Click" />
			</Grid>
		</StackPanel>
	</Grid>
</Page>
