<Page
	x:Class="SilverBulletPro.Views.Main.Configs.OtherOptions.Readme" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mdXam="clr-namespace:MdXaml;assembly=MdXaml"
	Title="Readme" xmlns:otheroptions="clr-namespace:SilverBulletPro.Views.Main.Configs.OtherOptions"
	Loaded="Page_Loaded"
	LostFocus="Page_LostFocus">
	<Grid
		Margin="5,10,5,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition />
			<ColumnDefinition
				Width="5" />
			<ColumnDefinition />
		</Grid.ColumnDefinitions>
		<Border
			Height="30"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			BorderBrush="{DynamicResource BorderBrush}"
			BorderThickness="1,1,1,0"
			Background="{Binding ElementName=richTextBox, Path=Background}">
			<CheckBox
				Name="chbMarkdown"
				Margin="5,0,0,0"
				HorizontalAlignment="Left"
				Content="Use Markdown"
				Foreground="{DynamicResource ForegroundMain}"
				IsChecked="{Binding UseMarkdown}"
				Click="MarkdownCheckBox_Click" />
		</Border>
		<RichTextBox
			Name="richTextBox"
			Grid.Row="1"
			BorderElement.CornerRadius="0"
			Background="{DynamicResource BackgroundSecondary}"
			Foreground="{DynamicResource ForegroundMain}"
			LostFocus="richTextBox_LostFocus"
			TextChanged="RichTextBox_TextChanged">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<Style
						TargetType="{x:Type Paragraph}"
						x:Key="{x:Type Paragraph}">
						<Setter
							Property="Block.Margin"
							Value="0" />
					</Style>
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</RichTextBox>
		<GridSplitter
			Grid.RowSpan="2"
			Grid.Column="1"
			HorizontalAlignment="Stretch"
			ResizeBehavior="PreviousAndNext"
			ResizeDirection="Columns"
			Style="{StaticResource GridSplitterStyle}" />
		<ScrollViewer
			Grid.RowSpan="2"
			Grid.Column="2"
			Margin="5,0,5,5">
			<TextBlock
				Name="preview"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				FontSize="14"
				Foreground="{DynamicResource ForegroundMain}"
				Visibility="Collapsed" />
		</ScrollViewer>
		<mdXam:MarkdownScrollViewer
			MarkdownScrollViewer.Name="previewMarkdown"
			Grid.RowSpan="2"
			Grid.Column="2"
			FrameworkElement.Margin="5,0,5,5"
			FrameworkElement.HorizontalAlignment="Stretch"
			FrameworkElement.VerticalAlignment="Stretch"
			ScrollViewerAttach.AutoHide="False"
			Control.Foreground="{DynamicResource ForegroundMain}"
			UIElement.Visibility="Collapsed"
			x:Name="previewMarkdown">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<Style
						BasedOn="{StaticResource ScrollViewerNativeBaseStyle}"
						TargetType="{x:Type ScrollViewer}"
						x:Key="{x:Type ScrollViewer}" />
					<Style
						BasedOn="{StaticResource ScrollBarBaseStyle}"
						TargetType="{x:Type ScrollBar}"
						x:Key="{x:Type ScrollBar}" />
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</mdXam:MarkdownScrollViewer>
	</Grid>
</Page>
