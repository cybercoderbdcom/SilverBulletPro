<Page
	x:Class="SilverBulletPro.Views.Main.PluginsSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Plugins" xmlns:main="clr-namespace:SilverBulletPro.Views.Main"
	Loaded="Page_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<Storyboard
				x:Key="WaitForReloadCompleted">
				<DoubleAnimation
					RepeatBehavior="Forever"
					Storyboard.TargetName="reloadIcon"
					Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
					From="0"
					To="360"
					Duration="0:0:3" />
			</Storyboard>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<controls:TransitioningContentControl
		FrameworkElement.Name="trans"
		TransitioningContentControl.TransitionMode="Fade" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
		x:Name="trans">
		<Grid
			Margin="2,5,2,0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="30" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<TextBlock
				Grid.Row="0"
				Margin="3,0,0,10"
				Foreground="{DynamicResource ForegroundCustom}">
				<Span>Remember that some plugins might contain</Span> <Span
					FontWeight="Bold"
					Foreground="{DynamicResource ForegroundBad}">MALICIOUS CODE</Span> <Span>that runs even without clicking any buttons!</Span> <Span
					FontWeight="Bold"
					TextDecorations="Underline">Only load plugins you can trust!</Span></TextBlock>
			<Grid
				Name="topMenu"
				Row="1"
				Margin="0,0,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition />
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition
						Width="auto" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Margin="5"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource SelectedPlugin}" /> <Run
						Text=":" /></TextBlock>
				<ComboBox
					Name="pluginSelector"
					Grid.Column="1"
					Margin="2,0,0,0"
					BorderElement.CornerRadius="3 0 0 3"
					Background="{DynamicResource BackgroundSecondary}"
					SelectionChanged="pluginSelector_SelectionChanged" />
				<Button
					Grid.Column="2"
					Width="75"
					BorderElement.CornerRadius="0"
					BorderThickness="0.5,1,0.5,0.5"
					Click="RefreshButton_Click">
					<DockPanel>
						<Path
							Name="reloadIcon"
							Width="16"
							Height="16"
							Margin="-3,0,0,0"
							VerticalAlignment="Stretch"
							Data="M370.72,133.28 C339.458,104.008 298.888,87.962 255.848,88 C178.39,88.068 111.52000000000001,141.178 93.05700000000002,214.85 C91.71300000000002,220.213 86.93500000000002,224 81.40600000000002,224 L24.103,224 C16.605,224 10.909,217.193 12.296000000000001,209.824 C33.933,94.924 134.813,8 256,8 C322.448,8 382.791,34.135999999999996 427.315,76.685 L463.03,40.97 C478.149,25.851 504,36.559 504,57.941 L504,192 C504,205.255 493.255,216 480,216 L345.941,216 C324.55899999999997,216 313.851,190.149 328.97,175.029 L370.72,133.28 M32,296 L166.059,296 C187.441,296 198.149,321.851 183.03,336.971 L141.28,378.721 C172.542,407.994 213.115,424.04 256.156,424.001 C333.574,423.931 400.471,370.857 418.943,297.152 C420.287,291.789 425.065,288.002 430.594,288.002 L487.898,288.002 C495.396,288.002 501.09200000000004,294.809 499.70500000000004,302.178 C478.067,417.076 377.187,504 256,504 C189.55200000000002,504 129.209,477.864 84.685,435.315 L48.97,471.03 C33.851,486.149 8,475.441 8,454.059 L8,320 C8,306.745 18.744999999999997,296 32,296"
							Fill="{DynamicResource ForegroundMain}"
							RenderTransformOrigin="0.5, 0.5"
							Stretch="Fill"
							Stroke="{DynamicResource BackgroundMain}"
							StrokeThickness="0.5">
							<UIElement.RenderTransform>
								<RotateTransform
									Angle="0" />
							</UIElement.RenderTransform>
						</Path>
						<TextBlock
							Margin="5,0,0,0"
							Text="{DynamicResource Plugins_Refresh}" />
					</DockPanel>
				</Button>
				<Button
					Grid.Column="3"
					Width="100"
					Padding="2,0,0,0"
					BorderElement.CornerRadius="0"
					IconElement.Geometry="M480,119 C480,105.7 470.6,96 457.2,96 L198.9,96 C196.1,96 194.6,95.4 192.8,93.6 L170.3,71.1 L170.10000000000002,70.89999999999999 C165.20000000000002,66.3 161.20000000000002,63.99999999999999 152.8,63.99999999999999 L56.7,63.99999999999999 C42.9,64 32,74.3 32,87 L32,160.7 C32,162.29999999999998 33.7,162.2 35,161.39999999999998 C36.3,160.59999999999997 40,159.99999999999997 42,159.99999999999997 L470,159.99999999999997 C472,159.99999999999997 475.7,160.59999999999997 477,161.39999999999998 C478.3,162.2 480,162.29999999999998 480,160.7 L480,119 M32,416.4 C32,433.9 46.2,448 63.6,448 L448,448 C465.6,448 480,433.6 480,416 L480,204 C480,195.2 472.8,188 464,188 L48,188 C39.2,188 32,195.2 32,204 L32,416.4"
					IconElement.Width="14"
					BorderThickness="0.5,1,0.5,0.5"
					Content="{DynamicResource Plugins_OpenFolder}"
					Click="OpenPluginsFolderButton_Click" />
				<Button
					Grid.Column="4"
					BorderElement.CornerRadius="0 3 0 0"
					IconElement.Geometry="M13.04,19.61 C12.67,18.55 11.68,17.8 10.5,17.8 C9,17.8 7.8,19 7.8,20.5 L7.8,22 L4,22 C2.9,22 2,21.11 2,20 L2,16.2 L3.5,16.2 C5,16.2 6.2,15 6.2,13.5 C6.2,12 5,10.8 3.5,10.8 L2,10.8 L2,7 C2,5.9 2.9,5 4,5 L8,5 L8,3.5 C8,2.12 9.12,1 10.5,1 C11.88,1 13,2.12 13,3.5 L13,5 L17,5 C18.1,5 19,5.89 19,7 L19,11 L20.5,11 C21.88,11 23,12.12 23,13.5 C23,13.82 22.94,14.12 22.83,14.39 C21.79,13.53 20.46,13 19,13 C15.69,13 13,15.69 13,19 C13,19.2 13,19.41 13.04,19.61 M18,15 L18,18 L15,18 L15,20 L18,20 L18,23 L20,23 L20,20 L23,20 L23,18 L20,18 L20,15 L18,15"
					IconElement.Width="15"
					BorderThickness="0.5,1,1,0.5"
					Content="{DynamicResource ShowPlugins}"
					ToolTip="{DynamicResource ShowPluginsTip}"
					Click="ShowPluginsButton_Click" />
			</Grid>
			<Frame
				Name="Main"
				Grid.Row="2"
				BorderElement.CornerRadius="1 1 1 1"
				NavigationUIVisibility="Hidden"
				Navigated="Main_Navigated" />
		</Grid>
	</controls:TransitioningContentControl>
</Page>
