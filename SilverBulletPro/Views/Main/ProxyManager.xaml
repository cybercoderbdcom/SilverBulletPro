					</MenuItem.Icon>
				</MenuItem>
			</ContextMenu>
			<ContextMenu
				x:Key="ProxyManagerItemContextMenu">
				<MenuItem
					Header="{DynamicResource ProxyManager_CopyNameMenuItem}">
					<MenuItem.Icon>
						<PackIconMaterial
							PackIconMaterial.Kind="ContentCopy" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Header="{DynamicResource ProxyManager_CopyPathMenuItem}">
					<MenuItem.Icon>
						<PackIconMaterial
							PackIconMaterial.Kind="ContentCopy" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Header="{DynamicResource ProxyManager_RefreshMenuItem}">
					<MenuItem.Icon>
						<iconpacks:PackIconForkAwesome
							PackIconForkAwesome.Kind="Refresh" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.ForkAwesome" />
					</MenuItem.Icon>
				</MenuItem>
			</ContextMenu>
		</ResourceDictionary>
	</FrameworkElement.Resources>
