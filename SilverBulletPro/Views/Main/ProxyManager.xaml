					<MenuItem.Icon>
						<iconpacks:PackIconMaterial
							PackIconMaterial.Kind="ContentCopy" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Name="copySelectedProxiesFull"
					Header="{DynamicResource ProxyManager_CopySelectedProxiesWithTypeAndCredentialsMenuItem}">
					<MenuItem.Icon>
						<iconpacks:PackIconTypicons
							PackIconTypicons.Kind="Clipboard" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Typicons" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Header="{DynamicResource ProxyManager_DeleteMenuItem}">
