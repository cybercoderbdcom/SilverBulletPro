							<ColumnDefinition
								Width="auto" />
							<ColumnDefinition
								Width="auto" />
						</Grid.ColumnDefinitions>
						<Label
							Foreground="{DynamicResource ForegroundToCheck}">
							<DockPanel>
								<TextBlock>
									<Run
										Text="{DynamicResource ProxyManager_ProxChecker_DefaultType}" /> <Run
										Text=":" /></TextBlock>
								<TextBlock
									Margin="3,0,0,0"
									Text="{Binding Type}" />
							</DockPanel>
						</Label>
						<Label
							Grid.Column="1"
							Margin="100,0,0,0"
							Foreground="{DynamicResource ForegroundMain}">
							<DockPanel>
								<TextBlock>
									<Run
										Text="{DynamicResource ProxyManager_ProxChecker_Total}" /> <Run
										Text=":" /></TextBlock>
								<TextBlock
									Margin="3,0,0,0"
									Text="{Binding Total}" />
							</DockPanel>
						</Label>
						<Label
							Grid.Column="2"
							Margin="100,0,0,0"
							Foreground="{DynamicResource ForegroundGood}">
							<DockPanel>
								<TextBlock>
									<Run
										Text="{DynamicResource ProxyManager_ProxChecker_Working}" /> <Run
										Text=":" /></TextBlock>
								<TextBlock
									Margin="3,0,0,0"
									Text="{Binding Working}" />
							</DockPanel>
						</Label>
						<Label
							Grid.Column="3"
							Margin="100,0,0,0"
							Foreground="{DynamicResource ForegroundBad}">
							<DockPanel>
								<TextBlock>
									<Run
										Text="{DynamicResource ProxyManager_ProxChecker_NotWorking}" /> <Run
										Text=":" /></TextBlock>
								<TextBlock
									Margin="3,0,0,0"
									Text="{Binding NotWorking}" />
							</DockPanel>
						</Label>
					</Grid>
				</Grid>
			</TabItem>
		</TabControl>
	</controls:TransitioningContentControl>
</Page>
