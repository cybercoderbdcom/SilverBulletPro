<Page
	x:Class="SilverBulletPro.Views.Main.Runner.Runner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:SilverBulletPro.Converters" xmlns:converters="clr-namespace:SilverBulletPro.Converters" xmlns:core="clr-namespace:SilverBulletPro.Core.Runners;assembly=SilverBulletPro.Core" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:helpers="clr-namespace:SilverBulletPro.Helpers" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="Runner" xmlns:runner="clr-namespace:SilverBulletPro.Views.Main.Runner"
	Loaded="Page_Loaded">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<ContextMenu
				x:Key="ItemContextMenu">
				<MenuItem
					Name="copySelectedData"
					Header="Copy Selected Data"
					Click="copySelectedData_Click">
					<MenuItem.Icon>
						<iconpacks:PackIconMaterialDesign
							PackIconMaterialDesign.Kind="ContentCopy" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.MaterialDesign" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Name="copySelectedCaptureOnly"
					Header="Copy Selected Capture"
					Click="copySelectedCaptureOnly_Click">
					<MenuItem.Icon>
						<iconpacks:PackIconMaterial
							PackIconMaterial.Kind="AccountDetails" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Name="copySelectedProxy"
					Header="Copy Selected Proxy"
					Click="copySelectedProxy_Click">
					<MenuItem.Icon>
						<iconpacks:PackIconUnicons
							PackIconUnicons.Kind="ServerConnection" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Unicons" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Name="copySelectedCapture"
					Header="Copy Selected Data with Capture"
					Click="copySelectedCapture_Click">
					<MenuItem.Icon>
						<PackIconMaterial
							PackIconMaterial.Kind="CardAccountDetails" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Name="sendToDebugger"
					Header="Send To Debugger"
					Click="sendToDebugger_Click">
					<MenuItem.Icon>
						<iconpacks:PackIconFontAwesome
							PackIconFontAwesome.Kind="ShareSolid" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Name="selectAll"
					Header="Select All"
					Click="selectAll_Click">
					<MenuItem.Icon>
						<iconpacks:PackIconModern
							PackIconModern.Kind="ListSelect" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Modern" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Name="showHTML"
					Header="Show Last Response in Browser"
					Click="showHTML_Click">
					<MenuItem.Icon>
						<iconpacks:PackIconIonicons
							PackIconIonicons.Kind="BrowsersMD" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Ionicons" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Name="showLog"
					Header="Show Full Log"
					Click="showLog_Click">
					<MenuItem.Icon>
						<PackIconFontAwesome
							PackIconFontAwesome.Kind="HistorySolid" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" />
					</MenuItem.Icon>
				</MenuItem>
				<MenuItem
					Header="Show Full Log in Notepad++"
					Click="showLogNotepadPlus_Click">
					<MenuItem.Icon>
						<iconpacks:BoxIconsExtension
							BoxIconsExtension.Kind="SolidNotepad" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.BoxIcons" />
					</MenuItem.Icon>
				</MenuItem>
			</ContextMenu>
			<converters:Base64ToImageConverter
				x:Key="Base64ToImageConverter" />
			<converters:DivisionConverter
				x:Key="DivisionConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<controls:TransitioningContentControl
		FrameworkElement.Name="trans"
		TransitioningContentControl.TransitionMode="Fade" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
		x:Name="trans">
		<Grid>
			<uc:ProgressDialog
				Name="progressDialog"
				Margin="50"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Panel.ZIndex="1"
				Background="#00FFFFFF"
				Description="Loading Wordlist"
				IsIndeterminate="True"
				Visibility="Collapsed"
				Width="{Binding ElementName=trans, Path=ActualWidth, Converter={StaticResource DivisionConverter}, ConverterParameter=2}" />
			<Grid
				Name="mainGrid">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<converters:EnumBooleanConverter
							x:Key="ComparisonConverter" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="80" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>
				<Grid
					Row="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="320" />
					</Grid.ColumnDefinitions>
					<Grid
						Row="0"
						Column="0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="189" />
							<ColumnDefinition />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<Grid
							Column="0"
							Height="30"
							VerticalAlignment="Center">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="auto" />
								<ColumnDefinition
									Width="auto" />
							</Grid.ColumnDefinitions>
							<Ellipse
								Width="33"
								Height="32"
								Margin="1,-4,3,-4"
								RenderOptions.BitmapScalingMode="HighQuality"
								SnapsToDevicePixels="True"
								Stroke="{DynamicResource BorderBrush}">
								<Shape.Fill>
									<ImageBrush
										x:Name="icon"
										Stretch="Fill"
										ImageSource="{Binding Icon, Converter={StaticResource Base64ToImageConverter}}" />
								</Shape.Fill>
							</Ellipse>
							<DockPanel
								Grid.Column="1">
								<TextBlock
									Margin="5,0,4,0"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundMain}">
									<Run
										Text="{DynamicResource Runner_StartPos}" /> <Run
										Text=":" /></TextBlock>
								<TextBox
									Name="labelStartingPoint"
									MinWidth="38"
									TextAlignment="Center"
									IsEnabled="{Binding ControlsEnabled}"
									Text="{Binding StartingPoint, Mode=TwoWay}" />
							</DockPanel>
						</Grid>
						<StackPanel
							Grid.Row="1"
							Grid.Column="0"
							Height="26"
							VerticalAlignment="Center"
							Orientation="Horizontal">
							<FrameworkElement.Resources>
								<ResourceDictionary>
									<Style
										TargetType="{x:Type Label}"
										x:Key="{x:Type Label}">
										<Setter
											Property="Margin"
											Value="0,0,-8,0" />
										<Setter
											Property="Foreground"
											Value="{DynamicResource ForegroundMain}" />
									</Style>
								</ResourceDictionary>
							</FrameworkElement.Resources>
							<TextBlock
								Margin="5,0,1,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundMain}">
								<Run
									Text="{DynamicResource Runner_Prog}" /> <Run
									Text=":" /></TextBlock>
							<Label
								Content="{Binding ProgressCount}" />
							<Label
								Content=" / " />
							<Label
								Content="{Binding Options.WordlistSize}" />
							<Label
								Content=" (" />
							<Label
								Content="{Binding Progress}" />
							<Label
								Content="%)" />
						</StackPanel>
						<Slider
							Name="startingPointSlider"
							Grid.Column="1"
							Height="18"
							Margin="5,0,5,0"
							VerticalAlignment="Center"
							Minimum="1"
							IsEnabled="{Binding ControlsEnabled}"
							Maximum="{Binding Options.WordlistSize}"
							Value="{Binding StartingPoint, Mode=TwoWay}" />
						<ProgressBar
							Grid.Row="1"
							Grid.Column="1"
							Margin="5,10,5,10"
							Background="{DynamicResource BackgroundSecondary}"
							Value="{Binding Progress, Mode=OneWay}" />
					</Grid>
					<Grid
						Row="0"
						Column="1">
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="2*" />
							<ColumnDefinition
								Width="*" />
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<DockPanel
							Grid.Row="0"
							Grid.Column="0">
							<TextBlock
								Margin="5,0,2,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundMain}">
								<Run
									Text="{DynamicResource Runner_Bots}" /> <Run
									Text=":" /></TextBlock>
							<TextBox
								Width="22"
								MinWidth="27"
								Margin="3,0"
								VerticalAlignment="Center"
								BorderElement.CornerRadius="5"
								Background="{DynamicResource BackgroundMain}"
								BorderThickness="0"
								DockPanel.Dock="Left"
								Foreground="{DynamicResource ForegroundMain}"
								MaxLength="3"
								TextAlignment="Center"
								Text="{Binding Options.BotsAmount, Mode=TwoWay}"
								PreviewTextInput="TextBoxBotsAmount_PreviewTextInput"
								TextChanged="TextBoxBotsAmount_TextChanged">
								<FrameworkElement.Style>
									<Style
										TargetType="{x:Type TextBox}">
										<Setter
											Property="FrameworkElement.ContextMenu">
											<Setter.Value>
												<ContextMenu />
											</Setter.Value>
										</Setter>
									</Style>
								</FrameworkElement.Style>
							</TextBox>
							<Slider
								Name="botsSlider"
								Margin="5,0,10,0"
								VerticalAlignment="Center"
								Maximum="200"
								Minimum="1"
								TickFrequency="20"
								TickPlacement="Both"
								Value="{Binding Options.BotsAmount, Mode=TwoWay}" />
						</DockPanel>
						<StackPanel
							Grid.Row="1"
							Grid.Column="0"
							Margin="0,0,0,0"
							Orientation="Horizontal">
							<TextBlock
								Margin="5,0,12,0"
								VerticalAlignment="Center"
								Foreground="{DynamicResource ForegroundMain}">
								<Run
									Text="{DynamicResource Runner_Proxy}" /> <Run
									Text=":" /></TextBlock>
							<RadioButton
								Name="proxyDefRadio"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Content="{DynamicResource Runner_ProxyDef}"
								GroupName="proxyRadio"
								ToolTip="Use the default proxy settings for the loaded config"
								IsChecked="{Binding Path=Options.ProxyMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static core:ProxyMode.Default}, Mode=TwoWay}"
								IsEnabled="{Binding ControlsEnabled}" />
							<RadioButton
								Name="proxyYesRadio"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Content="{DynamicResource Runner_ProxyOn}"
								GroupName="proxyRadio"
								ToolTip="Override the config default setting and force the use of proxies"
								IsChecked="{Binding Path=Options.ProxyMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static core:ProxyMode.On}, Mode=TwoWay}"
								IsEnabled="{Binding ControlsEnabled}" />
							<RadioButton
								Name="proxyNoRadio"
								Margin="0,0,6,0"
								VerticalAlignment="Center"
								Content="{DynamicResource Runner_ProxyOff}"
								GroupName="proxyRadio"
								ToolTip="Override the config default setting and remove proxy requirements"
								IsChecked="{Binding Path=Options.ProxyMode, Converter={StaticResource ComparisonConverter}, ConverterParameter={x:Static core:ProxyMode.Off}, Mode=TwoWay}"
								IsEnabled="{Binding ControlsEnabled}" />
						</StackPanel>
						<Grid
							RowSpan="2"
							Column="1">
							<Grid.RowDefinitions>
								<RowDefinition />
								<RowDefinition
									Height="auto" />
							</Grid.RowDefinitions>
							<Button
								Name="startButton"
								Grid.Row="0"
								Height="auto"
								Margin="2,0,1,6"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								BorderElement.CornerRadius="5"
								IconElement.Geometry="M13.0455,-8.659125 L5.887125,-12.812625 C5.279625,-13.16475 4.5,-12.738375 4.5,-12.0285 L4.5,-3.7215 C4.5,-3.01275 5.2785,-2.58525 5.887125,-2.9385 L13.0455,-7.092 A0.90225,0.90225 0 0 0 13.0455,-8.659125"
								IconElement.Width="12"
								BorderThickness="1"
								Foreground="{DynamicResource ForegroundMain}"
								Click="startButton_Click">
								<TextBlock
									VerticalAlignment="Center"
									Text="{DynamicResource StartRunner}"
									TextWrapping="Wrap" />
							</Button>
							<TextBlock
								Name="counter"
								Grid.Row="1"
								Margin="5,-2,5,5"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								FontSize="12.5"
								FontWeight="DemiBold"
								Foreground="{DynamicResource ForegroundCustom}"
								TextAlignment="Center"
								TextTrimming="CharacterEllipsis"
								TextWrapping="NoWrap"
								Visibility="Collapsed"
								Text="{Binding Counter}" />
						</Grid>
					</Grid>
				</Grid>
				<Grid
					Row="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="5" />
						<ColumnDefinition
							Width="305" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="*" />
						<RowDefinition
							Height="7" />
						<RowDefinition
							Height="171" />
					</Grid.RowDefinitions>
					<GridSplitter
						Grid.Row="0"
						Grid.Column="1"
						Width="5"
						VerticalAlignment="Stretch"
						ResizeBehavior="PreviousAndNext"
						ResizeDirection="Columns"
						Style="{StaticResource GridSplitterStyle}" />
					<Grid
						Name="rightGrid"
						Row="0"
						Column="2">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="*" />
							<RowDefinition
								Height="40" />
						</Grid.RowDefinitions>
						<ListView
							Name="validListView"
							Grid.Row="0"
							Background="#00FFFFFF"
							BorderThickness="1"
							Foreground="{DynamicResource ForegroundMain}"
							SelectionMode="Extended"
							ItemsSource="{Binding Path=HitsList, Mode=OneWay}">
							<FrameworkElement.Resources>
								<ResourceDictionary>
									<Style
										TargetType="{x:Type Thumb}"
										x:Key="GridViewColumnHeaderGripper">
										<Setter
											Property="Width"
											Value="18" />
										<Setter
											Property="Background">
											<Setter.Value>
												<LinearGradientBrush
													StartPoint="0,0"
													EndPoint="0,1">
													<GradientBrush.GradientStops>
														<GradientStopCollection>
															<GradientStop
																Offset="0.0"
																Color="{DynamicResource BorderLightColor}" />
															<GradientStop
																Offset="1.0"
																Color="{DynamicResource BorderDarkColor}" />
														</GradientStopCollection>
													</GradientBrush.GradientStops>
												</LinearGradientBrush>
											</Setter.Value>
										</Setter>
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type Thumb}">
													<Border
														Padding="{TemplateBinding Padding}"
														Background="#00FFFFFF">
														<Rectangle
															Width="1"
															HorizontalAlignment="Center"
															Fill="{TemplateBinding Background}" />
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Setter
											Property="BorderBrush">
											<Setter.Value>
												<LinearGradientBrush
													StartPoint="0.5,0"
													EndPoint="0.5,1">
													<GradientStop
														Offset="0"
														Color="Black" />
													<GradientStop
														Offset="1"
														Color="White" />
												</LinearGradientBrush>
											</Setter.Value>
										</Setter>
									</Style>
									<Style
										TargetType="{x:Type GridViewColumnHeader}"
										x:Key="{x:Type GridViewColumnHeader}">
										<Setter
											Property="HorizontalContentAlignment"
											Value="Left" />
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type GridViewColumnHeader}">
													<Grid>
														<Border
															Background="#00FFFFFF"
															BorderBrush="#FF000000"
															BorderThickness="0,0,0,1">
															<TextBlock
																Name="ContentHeader"
																Width="{TemplateBinding Width}"
																Padding="5,5,5,0"
																Text="{TemplateBinding Content}"
																TextAlignment="Left" />
														</Border>
														<Thumb
															Name="PART_HeaderGripper"
															Margin="0,0,-9,0"
															HorizontalAlignment="Right"
															Style="{StaticResource GridViewColumnHeaderGripper}" />
													</Grid>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Setter
											Property="FrameworkElement.OverridesDefaultStyle"
											Value="True" />
										<Setter
											Property="Foreground"
											Value="{DynamicResource ForegroundMain}" />
										<Setter
											Property="FontFamily"
											Value="pack://application:,,,/Fonts/#Century Gothic" />
										<Setter
											Property="FontSize"
											Value="14" />
									</Style>
									<!--Unknown connection ID: 26-->
									<Style
										TargetType="{x:Type ListViewItem}"
										x:Key="{x:Type ListViewItem}">
										<Setter
											Property="FrameworkElement.ContextMenu"
											Value="{StaticResource ItemContextMenu}" />
										<Setter
											Property="Template">
											<Setter.Value>
												<ControlTemplate
													TargetType="{x:Type ListViewItem}">
													<Border
														Name="Bd"
														Padding="0"
														Background="{TemplateBinding Background}"
														BorderBrush="{TemplateBinding BorderBrush}"
														BorderThickness="{TemplateBinding BorderThickness}"
														SnapsToDevicePixels="true">
														<GridViewRowPresenter
															HorizontalAlignment="Left"
															VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
															SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
													</Border>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
										<Style.Triggers>
											<Trigger
												Property="UIElement.IsMouseOver"
												Value="True">
												<Setter
													Property="Background"
													Value="{DynamicResource BackgroundSecondary}" />
											</Trigger>
											<Trigger
												Property="ListBoxItem.IsSelected"
												Value="True">
												<Setter
													Property="Background"
													Value="{DynamicResource BackgroundSecondary}" />
											</Trigger>
										</Style.Triggers>
									</Style>
									<Style
										BasedOn="{StaticResource ScrollViewerNativeBaseStyle}"
										TargetType="{x:Type ScrollViewer}"
										x:Key="{x:Type ScrollViewer}" />
									<Style
										BasedOn="{StaticResource ScrollBarBaseStyle}"
										TargetType="{x:Type ScrollBar}"
										x:Key="{x:Type ScrollBar}" />
								</ResourceDictionary>
							</FrameworkElement.Resources>
							<FrameworkElement.Style>
								<Style
									TargetType="{x:Type ListView}" />
							</FrameworkElement.Style>
							<ListView.View>
								<GridView>
									<GridViewColumn
										Header="{DynamicResource Runner_GridViewTime}"
										DisplayMemberBinding="{Binding Path=Time}" />
									<GridViewColumn
										Header="{DynamicResource Runner_GridViewData}"
										DisplayMemberBinding="{Binding Path=Data}" />
									<GridViewColumn
										Header="{DynamicResource Runner_GridViewProxy}"
										DisplayMemberBinding="{Binding Path=Proxy}" />
									<GridViewColumn
										Header="{DynamicResource Runner_GridViewProxType}"
										DisplayMemberBinding="{Binding Path=Type}" />
									<GridViewColumn
										Width="2000"
										Header="{DynamicResource Runner_GridViewCapture}"
										DisplayMemberBinding="{Binding Path=CapturedData}" />
								</GridView>
							</ListView.View>
						</ListView>
						<Grid
							Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="auto" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition
									Height="*" />
								<RowDefinition
									Height="*" />
							</Grid.RowDefinitions>
							<StackPanel
								Grid.Row="0"
								Grid.RowSpan="2"
								Grid.Column="0"
								Orientation="Horizontal">
								<controls:ButtonGroup xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl">
									<RadioButton
										Name="hitsFilterButton"
										Height="33"
										Padding="2"
										BorderElement.CornerRadius="1 0 0 1"
										Background="{DynamicResource BackgroundSecondary}"
										BorderThickness="0"
										Content="{DynamicResource Runner_BtnHits}"
										Foreground="{DynamicResource ForegroundMain}"
										IsChecked="True"
										Style="{StaticResource RadioGroupItemDefault}"
										Click="hitsFilterButton_Click" />
									<RadioButton
										Name="customFilterButton"
										Height="33"
										Padding="4"
										BorderElement.CornerRadius="0 0 0 0"
										Background="{DynamicResource BackgroundSecondary}"
										BorderThickness="0"
										Content="{DynamicResource Runner_BtnCustom}"
										Foreground="{DynamicResource ForegroundMain}"
										Style="{StaticResource RadioGroupItemDefault}"
										Click="customFilterButton_Click" />
									<RadioButton
										Name="toCheckFilterButton"
										Height="33"
										Padding="5"
										BorderElement.CornerRadius="0 4 4 0"
										Background="{DynamicResource BackgroundSecondary}"
										BorderThickness="0"
										Content="{DynamicResource Runner_BtnToCheck}"
										Foreground="{DynamicResource ForegroundMain}"
										Style="{StaticResource RadioGroupItemDefault}"
										Click="toCheckFilterButton_Click" />
								</controls:ButtonGroup>
							</StackPanel>
							<StackPanel
								Grid.Row="0"
								Grid.Column="1"
								Margin="1,-3,0,-3"
								HorizontalAlignment="Left"
								Orientation="Horizontal">
								<FrameworkElement.Resources>
									<ResourceDictionary>
										<Style
											TargetType="{x:Type Label}"
											x:Key="{x:Type Label}">
											<Setter
												Property="Margin"
												Value="-2,0" />
											<Setter
												Property="VerticalAlignment"
												Value="Center" />
											<Setter
												Property="Foreground"
												Value="{DynamicResource ForegroundMain}" />
											<Setter
												Property="FontSize"
												Value="12" />
										</Style>
									</ResourceDictionary>
								</FrameworkElement.Resources>
								<Label
									Name="daysLabel"
									Content="{Binding TimerDays}" />
								<Label
									Content="days" />
								<Label
									Name="hoursLabel"
									Content="{Binding TimerHours}" />
								<Label
