						Foreground="{DynamicResource ForegroundMain}">
						<Run
							Text="{DynamicResource Runner_NumberOfUsers}" /> <Run
							Text=": " /> <TextBlock
							Text="{Binding ElementName=botUsersListView, Path=Items.Count}" /></TextBlock>
				</Grid>
			</TabItem>
