<Page
	x:Class="SilverBulletPro.Views.Main.Settings.Core.Captchas" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="SBSettingsCaptchas" xmlns:core="clr-namespace:SilverBulletPro.Views.Main.Settings.Core">
	<Grid
		Margin="10">
		<StackPanel>
			<DockPanel
				Margin="0,0,0,2">
				<TextBlock
					Margin="0,0,5,0"
					VerticalAlignment="Center"
					DockPanel.Dock="Left"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource CoreSettings_Captchas_CaptchaService}" /> <Run
						Text=":" /></TextBlock>
				<ComboBox
					Name="currentServiceCombobox"
					DockPanel.Dock="Left"
					Foreground="{DynamicResource ForegroundMain}"
					SelectionChanged="currentServiceCombobox_SelectionChanged" />
			</DockPanel>
			<TabControl
				Name="captchaServiceTabControl"
				Grid.Row="1"
				Margin="-4,0,0,0"
				Background="#00FFFFFF"
				BorderThickness="0"
				Style="{StaticResource BaseStyle}">
				<ItemsControl.ItemContainerStyle>
					<Style
						TargetType="{x:Type TabItem}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</Style>
				</ItemsControl.ItemContainerStyle>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_2CaptchaApiKey}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							DockPanel.Dock="Left"
							Text="{Binding TwoCapToken}" />
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_AntiCaptchaApiKey}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							DockPanel.Dock="Left"
							Text="{Binding AntiCapToken}" />
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_Custom2CaptchaServer}" /> <Run
								Text=":" /></TextBlock>
						<Grid
							DockPanel.Dock="Left">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="auto" />
							</Grid.ColumnDefinitions>
							<TextBox
								Grid.Column="0"
								Margin="0,0,5,0"
								Text="{Binding CustomTwoCapToken}" />
							<TextBox
								Grid.Column="1"
								Margin="5,0,0,0"
								Text="{Binding CustomTwoCapDomain}" />
							<NumericUpDown
								Grid.Column="2"
								FrameworkElement.Width="100"
								FrameworkElement.Margin="5,0,0,0"
								FrameworkElement.HorizontalAlignment="Right"
								Control.Background="{DynamicResource BackgroundSecondary}"
								FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
								Control.Foreground="{DynamicResource ForegroundMain}"
								NumericUpDown.Maximum="65535"
								NumericUpDown.Minimum="0"
								NumericUpDown.Value="{Binding CustomTwoCapPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
						</Grid>
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_DeathByCaptchaCredentials}" /> <Run
								Text=":" /></TextBlock>
						<Grid
							DockPanel.Dock="Left">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<TextBox
								Grid.Column="0"
								Margin="0,0,5,0"
								Text="{Binding DBCUser}" />
							<TextBox
								Grid.Column="1"
								Margin="5,0,0,0"
								Text="{Binding DBCPass}" />
						</Grid>
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_DeCaptcherCredentials}" /> <Run
								Text=":" /></TextBlock>
						<Grid
							DockPanel.Dock="Left">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<TextBox
								Grid.Column="0"
								Margin="4,0,5,0"
								Text="{Binding DCUser}" />
							<TextBox
								Grid.Column="1"
								Margin="5,0,0,0"
								Text="{Binding DCPass}" />
						</Grid>
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_ImageTyperzApiKey}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							DockPanel.Dock="Left"
							Text="{Binding ImageTyperzToken}" />
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_AZCaptchaApiKey}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							DockPanel.Dock="Left"
							Text="{Binding AZCapToken}" />
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_CaptchasIOApikey}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							Grid.Column="0"
							Margin="0,0,5,0"
							Text="{Binding CIOToken}" />
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_RuCaptchaApiKey}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							DockPanel.Dock="Left"
							Text="{Binding RuCapToken}" />
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_SolveCaptchaApiKey}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							DockPanel.Dock="Left"
							Text="{Binding SCToken}" />
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_SolveRecaptchaCredentials}" /> <Run
								Text=":" /></TextBlock>
						<Grid
							DockPanel.Dock="Left">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<TextBox
								Grid.Column="0"
								Margin="4,0,5,0"
								Text="{Binding SRUserId}" />
							<TextBox
								Grid.Column="1"
								Margin="5,0,0,0"
								Text="{Binding SRToken}" />
						</Grid>
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_TrueCaptchaCredentials}" /> <Run
								Text=":" /></TextBlock>
						<Grid
							DockPanel.Dock="Left">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<TextBox
								Grid.Column="0"
								Margin="4,0,5,0"
								Text="{Binding TrueCapUser}" />
							<TextBox
								Grid.Column="1"
								Margin="5,0,0,0"
								Text="{Binding TrueCapToken}" />
						</Grid>
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_NineKWToken}" /> <Run
								Text=":" /></TextBlock>
						<TextBox
							DockPanel.Dock="Left"
							Text="{Binding NineKWToken}" />
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_CustomAntiCaptchaServer}" /> <Run
								Text=":" /></TextBlock>
						<Grid
							DockPanel.Dock="Left">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="auto" />
							</Grid.ColumnDefinitions>
							<TextBox
								Grid.Column="0"
								Margin="4,0,5,0"
								Text="{Binding CustomAntiCaptchaApiKey}" />
							<TextBox
								Grid.Column="1"
								Margin="5,0,0,0"
								Text="{Binding CustomAntiCaptchaDomain}" />
							<NumericUpDown
								Grid.Column="2"
								FrameworkElement.Width="100"
								FrameworkElement.Margin="5,0,0,0"
								FrameworkElement.HorizontalAlignment="Right"
								Control.Background="{DynamicResource BackgroundSecondary}"
								FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
								Control.Foreground="{DynamicResource ForegroundMain}"
								NumericUpDown.Maximum="65535"
								NumericUpDown.Minimum="0"
								NumericUpDown.Value="{Binding CustomAntiCaptchaPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
						</Grid>
					</DockPanel>
				</TabItem>
				<TabItem>
					<DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							DockPanel.Dock="Left"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource CoreSettings_Captchas_ApiToken}" /> <Run
								Text=":" /></TextBlock>
						<Grid
							DockPanel.Dock="Left">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
							</Grid.ColumnDefinitions>
							<TextBox
								Grid.Column="0"
								Margin="0,0,0,0"
								Text="{Binding AnyCaptchaApiKey}" />
						</Grid>
					</DockPanel>
				</TabItem>
			</TabControl>
			<DockPanel>
				<CheckBox
					Margin="0,8,0,8"
					HorizontalAlignment="Left"
					VerticalContentAlignment="Center"
					Content="{DynamicResource CoreSettings_Captchas_BypassBalanceCheck}"
					DockPanel.Dock="Top"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding BypassBalanceCheck}" />
				<StackPanel
					Orientation="Horizontal">
					<Button
						Name="checkBalanceButton"
						Width="121"
						Height="31"
						Margin="0,5,0,0"
						BorderElement.CornerRadius="4"
						IconElement.Geometry="M39.9317,58.3617 L39.9317,53.1984 C42.9656,52.6781 45.2439,51.5757 46.7665,49.8912 C48.2891,48.2067 49.0508,46.2045 49.0517,43.8847 C49.0819,41.5743 48.4428,39.652 47.1343,38.1177 C45.8259,36.5835 43.6669,35.2898 40.6573,34.2367 C38.4191,33.4616 36.8047,32.741 35.8143,32.0749 C34.8239,31.4088 34.3385,30.6754 34.3583,29.8746 C34.3347,29.124 34.6508,28.4567 35.3066,27.8726 C35.9625,27.2885 37.0998,26.9804 38.7187,26.9483 C40.6959,26.9847 42.2936,27.2073 43.5116,27.616 C44.7296,28.0248 45.6405,28.4013 46.2442,28.7456 L47.7221,23.0015 C46.8926,22.5841 45.8837,22.2172 44.6955,21.901 C43.5073,21.5847 42.082,21.395 40.4195,21.3317 L40.4195,16.8783 L35.4538,16.8783 L35.4538,21.6859 C32.6538,22.2213 30.5179,23.2883 29.046,24.8868 C27.5742,26.4853 26.8327,28.4387 26.8217,30.747 C26.8607,33.2007 27.6817,35.1573 29.2847,36.6167 C30.8876,38.076 33.0384,39.25 35.7369,40.1384 C37.636,40.7639 39.0728,41.4246 40.0474,42.1206 C41.0219,42.8167 41.5111,43.6442 41.515,44.6032 C41.4785,45.6114 40.9661,46.3919 39.9779,46.9446 C38.9896,47.4974 37.7444,47.7775 36.2423,47.785 C34.6009,47.7647 33.0786,47.5359 31.6755,47.0986 C30.2723,46.6613 29.0485,46.1374 28.004,45.527 L26.5176,51.4439 C27.4094,51.9849 28.6021,52.4569 30.0958,52.8601 C31.5894,53.2632 33.2003,53.5096 34.9282,53.5994 L34.9282,58.3617 L39.9317,58.3617"
						IconElement.Height="18"
						BorderThickness="1"
						Content="{DynamicResource CoreSettings_Captchas_CheckBalance}"
						Click="checkBalanceButton_Click" />
					<TextBlock
						Margin="8,4,0,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundMain}">
						<Run
							Text="{DynamicResource CoreSettings_Captchas_YourBalanceIs}" /> <Run
							Text=":" /></TextBlock>
					<Label
						Name="balanceLabel"
						Margin="1,5,0,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundMain}" />
				</StackPanel>
			</DockPanel>
			<DockPanel
				Margin="0,7,0,0"
				Dock="Top">
				<TextBlock
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource CoreSettings_Captchas_TimeoutForCaptchaSolutions}" /> <Run
						Text=":" /></TextBlock>
				<NumericUpDown
					FrameworkElement.Height="28"
					FrameworkElement.MinWidth="85"
					FrameworkElement.Margin="10,0,0,0"
					FrameworkElement.HorizontalAlignment="Left"
					Control.Background="{DynamicResource BackgroundSecondary}"
					FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
					Control.Foreground="{DynamicResource ForegroundMain}"
					NumericUpDown.Value="{Binding Timeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
			</DockPanel>
		</StackPanel>
	</Grid>
</Page>
