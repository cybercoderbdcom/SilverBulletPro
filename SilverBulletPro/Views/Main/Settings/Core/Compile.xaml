<Page
	x:Class="SilverBulletPro.Views.Main.Settings.Core.Compile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Compile" xmlns:core="clr-namespace:SilverBulletPro.Views.Main.Settings.Core">
	<Grid
		Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<DockPanel
			Margin="0,0,0,5">
			<TextBlock
				Margin="5,0,5,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Core_Compile_DotNetFrameworkPath}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Foreground="{DynamicResource ForegroundMain}"
				Text="{Binding DotNetFrameworkPath}" />
		</DockPanel>
	</Grid>
</Page>
