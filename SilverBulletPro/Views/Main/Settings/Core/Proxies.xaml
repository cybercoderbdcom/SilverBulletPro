<Page
	x:Class="SilverBulletPro.Views.Main.Settings.Core.Proxies" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="SBSettingsProxies" xmlns:core="clr-namespace:SilverBulletPro.Views.Main.Settings.Core">
	<ScrollViewer>
		<Grid
			Margin="10">
			<StackPanel>
				<Grid
					Margin="0,0,0,8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="auto" />
						<ColumnDefinition />
						<ColumnDefinition
							Width="auto" />
						<ColumnDefinition
							Width="auto" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Margin="3,0,0,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundBad}">
						<Run
							Text="{DynamicResource Proxies_GlobalBanKeys}" /> <Run
							Text=":" /></TextBlock>
					<ComboBox
						Name="globalBanKeysComboBox"
						Grid.Column="1"
						Margin="12,0,0,0"
						ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
						IsEditable="True"
						ItemsSource="{Binding GlobalBanKeys}" />
					<Button
						Grid.Column="2"
						Width="auto"
						Height="20"
						Margin="9,0,7,0"
						Padding="0"
						IconElement.Geometry="M512,960 C230.39999999999998,960 0,729.6 0,448 C0,166.39999999999998 230.4,-64 512,-64 C793.6,-64 1024,166.4 1024,448 C1024,729.6 793.6,960 512,960 M832,384 L576,384 L576,128 L448,128 L448,384 L192,384 L192,512 L448,512 L448,768 L576,768 L576,512 L832,512 L832,384"
						Foreground="{DynamicResource ForegroundMain}"
						Style="{StaticResource ButtonIcon}"
						Click="AddGlobalBanKeysButton_Click" />
					<Button
						Grid.Column="3"
						Width="auto"
						Height="20"
						Margin="0,0,5,0"
						Padding="0"
						IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
						Foreground="{DynamicResource ForegroundMain}"
						Style="{StaticResource ButtonIcon}"
						Click="RemoveGlobalBanKeysButton_Click" />
				</Grid>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="auto" />
						<ColumnDefinition />
						<ColumnDefinition
							Width="auto" />
						<ColumnDefinition
							Width="auto" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Margin="3,0,0,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundRetry}">
						<Run
							Text="{DynamicResource Proxies_GlobalRetryKeys}" /> <Run
							Text=":" /></TextBlock>
					<ComboBox
						Name="globalRetryKeysComboBox"
						Grid.Column="1"
						Margin="5,0,0,0"
						ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
						IsEditable="True"
						ItemsSource="{Binding GlobalRetryKeys}" />
					<Button
						Grid.Column="2"
						Width="auto"
						Height="20"
						Margin="9,0,7,0"
						Padding="0"
						IconElement.Geometry="M512,960 C230.39999999999998,960 0,729.6 0,448 C0,166.39999999999998 230.4,-64 512,-64 C793.6,-64 1024,166.4 1024,448 C1024,729.6 793.6,960 512,960 M832,384 L576,384 L576,128 L448,128 L448,384 L192,384 L192,512 L448,512 L448,768 L576,768 L576,512 L832,512 L832,384"
						Foreground="{DynamicResource ForegroundMain}"
						Style="{StaticResource ButtonIcon}"
						Click="AddGlobalRetryKeysButton_Click" />
					<Button
						Grid.Column="3"
						Width="auto"
						Height="20"
						Margin="0,0,5,0"
						Padding="0"
						IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M124,296 C117.4,296 112,290.6 112,284 L112,228 C112,221.4 117.4,216 124,216 L388,216 C394.6,216 400,221.4 400,228 L400,284 C400,290.6 394.6,296 388,296 L124,296"
						Foreground="{DynamicResource ForegroundMain}"
						Style="{StaticResource ButtonIcon}"
						Click="RemoveGlobalRetryKeysButton_Click" />
				</Grid>
			</StackPanel>
		</Grid>
	</ScrollViewer>
</Page>
