<Page
	x:Class="SilverBulletPro.Views.Main.Settings.Core.Puppeteer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="CoreSettingsPuppeteer" xmlns:core="clr-namespace:SilverBulletPro.Views.Main.Settings.Core">
	<Grid
		Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<DockPanel>
			<TextBlock
				Margin="0,0,5,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource CoreSettings_Puppeteer_PathChromeBinaryOnDisk}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				VerticalAlignment="Top"
				Foreground="{DynamicResource ForegroundMain}"
				Text="{Binding ChromeBinaryLocation}" />
		</DockPanel>
	</Grid>
</Page>
