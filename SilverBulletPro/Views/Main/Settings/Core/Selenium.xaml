<Page
	x:Class="SilverBulletPro.Views.Main.Settings.Core.Selenium" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="Selenium" xmlns:core="clr-namespace:SilverBulletPro.Views.Main.Settings.Core">
	<Grid
		Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<DockPanel
			Grid.Row="0">
			<TextBlock
				Margin="0,0,5,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource CoreSettings_Selenium_BrowserType}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="browserType"
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}"
				SelectedItem="{Binding BrowserType}" />
		</DockPanel>
		<DockPanel
			Grid.Row="1"
			Margin="0,5,0,0">
			<TextBlock
				Margin="0,0,5,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource CoreSettings_Selenium_PathChromeBinaryOnDisk}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				VerticalAlignment="Top"
				Foreground="{DynamicResource ForegroundMain}"
				Text="{Binding ChromeBinaryLocation}" />
		</DockPanel>
		<DockPanel
			Grid.Row="2"
			Margin="0,5,0,0">
			<TextBlock
				Margin="0,0,5,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource CoreSettings_Selenium_PathFirefoxBinaryOnDisk}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				VerticalAlignment="Top"
				Foreground="{DynamicResource ForegroundMain}"
				Text="{Binding FirefoxBinaryLocation}" />
		</DockPanel>
	</Grid>
</Page>
