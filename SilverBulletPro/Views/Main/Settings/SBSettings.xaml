<Page
	x:Class="SilverBulletPro.Views.Main.Settings.SBSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="OBSettingsPage" xmlns:settings="clr-namespace:SilverBulletPro.Views.Main.Settings"
	Loaded="Page_Loaded">
	<controls:TransitioningContentControl
		FrameworkElement.Name="trans"
		Control.Background="#00FFFFFF"
		TransitioningContentControl.TransitionMode="Fade" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
		x:Name="trans">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<TabControl
				Name="tabControl"
				Background="#00FFFFFF"
				SelectionChanged="TabControl_SelectionChanged">
				<TabItem
					Background="{DynamicResource BackgroundMain}"
					Style="{StaticResource TabItemCustomStyle}">
					<HeaderedContentControl.Header>
						<DockPanel
							Background="#00FFFFFF">
							<iconpacks:PackIconVaadinIcons
								PackIconVaadinIcons.Kind="Globe" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.VaadinIcons" />
							<TextBlock
								Margin="5,0,0,0"
								Text="{DynamicResource General}"
								Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}}" />
						</DockPanel>
					</HeaderedContentControl.Header>
					<Frame
						BorderElement.CornerRadius=" 0 3 0 0"
						NavigationUIVisibility="Hidden"
						Navigated="Frame_Navigated" />
				</TabItem>
				<TabItem
					Background="{DynamicResource BackgroundMain}"
					Style="{StaticResource TabItemCustomStyle}">
					<HeaderedContentControl.Header>
						<DockPanel
							Background="#00FFFFFF">
							<iconpacks:PackIconIonicons
								FrameworkElement.Height="16.5"
								PackIconIonicons.Kind="MusicalNotesiOS" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Ionicons" />
							<TextBlock
								Margin="5,0,0,0"
								Text="{DynamicResource Sounds}"
								Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}}" />
						</DockPanel>
					</HeaderedContentControl.Header>
					<Frame
						BorderElement.CornerRadius=" 0 3 0 0"
						NavigationUIVisibility="Hidden"
						Navigated="Frame_Navigated" />
				</TabItem>
				<TabItem
					Background="{DynamicResource BackgroundMain}"
					Style="{StaticResource TabItemCustomStyle}">
					<HeaderedContentControl.Header>
						<DockPanel
							Background="#00FFFFFF">
							<iconpacks:PackIconModern
								PackIconModern.Kind="Resource" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Modern" />
							<TextBlock
								Margin="5,0,0,0"
								Text="{DynamicResource Sources}"
								Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}}" />
						</DockPanel>
					</HeaderedContentControl.Header>
					<Frame
						BorderElement.CornerRadius=" 0 3 0 0"
						NavigationUIVisibility="Hidden"
						Navigated="Frame_Navigated" />
				</TabItem>
				<TabItem
					Background="{DynamicResource BackgroundMain}"
					Style="{StaticResource TabItemCustomStyle}">
					<HeaderedContentControl.Header>
						<DockPanel
							Background="#00FFFFFF">
							<iconpacks:PackIconFontAwesome
								PackIconFontAwesome.Kind="BrushSolid" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" />
							<TextBlock
								Margin="4,0,0,0"
								Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabItem}}}">
								<Run
									Text="{DynamicResource Themes}" />
							</TextBlock>
						</DockPanel>
					</HeaderedContentControl.Header>
					<Frame
						BorderElement.CornerRadius=" 0 3 0 0"
						NavigationUIVisibility="Hidden"
						Navigated="Frame_Navigated" />
				</TabItem>
			</TabControl>
			<Grid
				Row="1"
				Height="30"
				Margin="0,0,0,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition
						Width="0.22*" />
				</Grid.ColumnDefinitions>
				<Button
					Padding="1,0,0,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					BorderElement.CornerRadius="0 0 0 5"
					IconElement.Geometry="M20.5833,20.5833 L55.4167,20.5833 L55.4167,55.4167 L45.9167,55.4167 L45.9167,44.3333 L30.0833,44.3333 L30.0833,55.4167 L20.5833,55.4167 L20.5833,20.5833 M33.25,55.4167 L33.25,50.6667 L39.5833,50.6667 L39.5833,55.4167 L33.25,55.4167 M26.9167,23.75 L26.9167,33.25 L49.0833,33.25 L49.0833,23.75 L26.9167,23.75"
					IconElement.Width="16"
					BorderThickness="1,0,0,1"
					Content="{DynamicResource SBSettings_BtnSave}"
					FontWeight="Bold"
					Click="saveButton_Click" />
				<Button
					Grid.Column="1"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					BorderElement.CornerRadius="0 0 5 0"
					IconElement.Geometry="M1511,480 C1511,478 1511,475 1510,473 C1425,119 1133,-128 764,-128 C569,-128 380,-51 238,84 L109,-45 C97,-57 81,-64 64,-64 C29,-64 0,-35 0,0 L0,448 C0,483 29,512 64,512 L512,512 C547,512 576,483 576,448 C576,431 569,415 557,403 L420,266 C514,178 639,128 768,128 C946,128 1111,220 1204,372 C1228,411 1240,449 1257,489 C1262,503 1272,512 1287,512 L1479,512 C1497,512 1511,497 1511,480 M1536,1280 L1536,832 C1536,797 1507,768 1472,768 L1024,768 C989,768 960,797 960,832 C960,849 967,865 979,877 L1117,1015 C1022,1103 897,1152 768,1152 C590,1152 425,1060 332,908 C308,869 296,831 279,791 C274,777 264,768 249,768 L50,768 C32,768 18,783 18,800 L18,807 C104,1162 399,1408 768,1408 C964,1408 1155,1330 1297,1196 L1427,1325 C1439,1337 1455,1344 1472,1344 C1507,1344 1536,1315 1536,1280"
					IconElement.Width="16"
					BorderThickness="1,0,1,1"
					Content="{DynamicResource SBSettings_BtnReset}"
					Click="resetButton_Click" />
			</Grid>
		</Grid>
	</controls:TransitioningContentControl>
</Page>
