<Page
	x:Class="SilverBulletPro.Views.Main.Settings.General" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="SBSettingsGeneral" xmlns:settings="clr-namespace:SilverBulletPro.Views.Main.Settings">
	<ScrollViewer
		Background="#00FFFFFF"
		CanContentScroll="True"
		HorizontalScrollBarVisibility="Auto"
		VerticalScrollBarVisibility="Auto">
		<Grid
			Margin="10,10,0,10">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition
					Width="auto" />
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="0.33*" />
			</Grid.ColumnDefinitions>
			<Grid
				Margin="0,0,13,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="auto" />
					<ColumnDefinition
						MaxWidth="220" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Margin="0,0,5,1"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource SBSettings_General_OnConfigEditNavigateTo}" /> <Run
						Text=":" /></TextBlock>
				<ComboBox
					Name="comboBox"
					Grid.Column="1"
					MinWidth="220"
					SelectedIndex="1"
					SelectionChanged="ComboBox_SelectionChanged">
					<ComboBoxItem>Script</ComboBoxItem>
					<ComboBoxItem>Blocks</ComboBoxItem>
				</ComboBox>
			</Grid>
			<StackPanel
				Grid.Row="1"
				Margin="0,10,5,0"
				HorizontalAlignment="Left">
				<CheckBox
					Margin="0,0,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_AutomaticallySetRecommendedBots}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding RecommendedBots}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_ChangeRunnerInterface}"
					Foreground="{DynamicResource ForegroundMain}"
					ToolTip="Whether to swap the log and the hits list in the UI"
					IsChecked="{Binding ChangeRunnerInterface}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_DisableAnimationMode}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding DisableAnimationMode}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_DisableWarningOnQuit}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding DisableQuitWarning}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_DisableWarningOnConfigNotSaved}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding DisableNotSavedWarning}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_AllowLiveConfigEditing}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding LiveConfigUpdates}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_DisableBrowser}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding DisableHTMLView}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_LocalHtmlViewer}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding LocalHTMLViewer}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_EnableCookiesInBrowser}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding EnableCookiesInBrowser}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_AlwaysOnTop}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding AlwaysOnTop}"
					Click="AlwaysOnTop_Click" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_MinimizeToSystemTray}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding MinimizeToSysTray}"
					Click="MinimizeToSysTray_Click" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_AutomaticallyCreateRunnerOnStart}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding AutoCreateRunner}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_DisableDebuggerLog}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding DisableDebuggerLog}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_SendDebuggerLogToNotepadPlus}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding SendDebuggerLogToNotepadPlus}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_BackupTheDataBaseDailyUponStart}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding BackupDB}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_AutoSaveConfigOnStacker}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding AutoSaveConfigOnStacker}"
					Click="AutoSaveCfg_Click" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_AutoCompleteDefinedVariables}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding AutoCompleteDefinedVariables}" />
				<CheckBox
					Margin="0,8,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_ScriptCompletion}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding ScriptCompletion}" />
			</StackPanel>
			<Rectangle
				Grid.RowSpan="2"
				Grid.Column="1"
				Width="1"
				Margin="2"
				HorizontalAlignment="Left"
				VerticalAlignment="Stretch"
				Stroke="{DynamicResource BorderBrush}" />
			<StackPanel
				Grid.RowSpan="2"
				Grid.Column="2"
				Margin="11,0,0,0">
				<DockPanel
					Margin="0,0,14,5">
					<TextBlock
						Margin="0,0,5,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundMain}">
						<Run
							Text="{DynamicResource SBSettings_General_DefaultAuthorForNewConfigs}" /> <Run
							Text=":" /></TextBlock>
					<TextBox
						MinWidth="100"
						Foreground="{DynamicResource ForegroundMain}"
						Text="{Binding DefaultAuthor}" />
				</DockPanel>
				<DockPanel
					Margin="0,5,0,0"
					Dock="Top">
					<TextBlock
						Margin="5"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundMain}">
						<Run
							Text="{DynamicResource SBSettings_General_StartingWindowWidth}" /> <Run
							Text=":" /></TextBlock>
					<NumericUpDown
						FrameworkElement.Width="70"
						FrameworkElement.MinWidth="65"
						FrameworkElement.Margin="37,0,0,0"
						FrameworkElement.HorizontalAlignment="Left"
						Control.Background="{DynamicResource BackgroundSecondary}"
						FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
						Control.Foreground="{DynamicResource ForegroundMain}"
						NumericUpDown.Maximum="10000"
						NumericUpDown.Minimum="10"
						FrameworkElement.Tag="Width"
						NumericUpDown.Value="{Binding StartingWidth}"
						TextBoxBase.TextChanged="NumericUpDown_TextChanged" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
				</DockPanel>
				<DockPanel
					Margin="0,5,0,0"
					Dock="Top">
					<TextBlock
						Margin="5"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundMain}">
						<Run
							Text="{DynamicResource SBSettings_General_StartingWindowHeight}" /> <Run
							Text=":" /></TextBlock>
					<NumericUpDown
						FrameworkElement.Width="70"
						FrameworkElement.MinWidth="65"
						FrameworkElement.Margin="34,0,0,0"
						FrameworkElement.HorizontalAlignment="Left"
						Control.Background="{DynamicResource BackgroundSecondary}"
						FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
						Control.Foreground="{DynamicResource ForegroundMain}"
						NumericUpDown.Maximum="10000"
						NumericUpDown.Minimum="10"
						FrameworkElement.Tag="Height"
						NumericUpDown.Value="{Binding StartingHeight}"
						TextBoxBase.TextChanged="NumericUpDown_TextChanged" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
				</DockPanel>
				<CheckBox
					Margin="0,7,0,0"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					VerticalContentAlignment="Center"
					Content="{DynamicResource SBSettings_General_DisableCtrl_V_OnBlocks}"
					IsChecked="{Binding DisableCopyPasteBlocks}" />
				<TextBlock
					Margin="0,9,0,8"
					VerticalAlignment="Center"
					FontWeight="Bold"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource SBSettings_General_ProgramLog}" /> <Run
						Text=":" /></TextBlock>
				<CheckBox
					Margin="0,1,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_EnableLogging}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding EnableLogging}" />
				<CheckBox
					Margin="0,9,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_LogToFile}"
					Foreground="{DynamicResource ForegroundMain}"
					ToolTip="CARE: gets cleared on start"
					IsChecked="{Binding LogToFile}" />
				<DockPanel
					Margin="0,8,0,0">
					<TextBlock
						Margin="0,0,6,0"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ForegroundMain}">
						<Run
							Text="{DynamicResource SBSettings_General_LogBufferSize}" /> <Run
							Text=":" /></TextBlock>
					<NumericUpDown
						FrameworkElement.MinWidth="87"
						FrameworkElement.HorizontalAlignment="Left"
						FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
						NumericUpDown.Maximum="100000"
						NumericUpDown.Minimum="10"
						NumericUpDown.Value="{Binding LogBufferSize}" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
				</DockPanel>
				<CheckBox
					Margin="0,9,0,0"
					HorizontalAlignment="Left"
					Content="{DynamicResource SBSettings_General_IgnoreWordlistNameOnHitsdedupe}"
					Foreground="{DynamicResource ForegroundMain}"
					IsChecked="{Binding IgnoreWordlistOnHitDedupe}" />
			</StackPanel>
		</Grid>
	</ScrollViewer>
</Page>
