<Page
	x:Class="SilverBulletPro.Views.Main.Settings.Sounds" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="SBSettingsSounds" xmlns:settings="clr-namespace:SilverBulletPro.Views.Main.Settings">
	<Grid
		Background="#00FFFFFF">
		<StackPanel
			Margin="10">
			<CheckBox
				Margin="2,2,0,8"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				VerticalContentAlignment="Center"
				Content="{DynamicResource SBSettings_Sounds_Enable}"
				IsChecked="{Binding EnableSounds}" />
			<TextBlock
				Margin="5"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource SBSettings_Sounds_OnHitSound}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Text="{Binding OnHitSound}" />
			<TextBlock
				Margin="5"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource SBSettings_Sounds_OnReloadSound}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Text="{Binding OnReloadSound}" />
			<TextBlock
				Margin="5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundCustom}"
				Text="{DynamicResource SBSettings_Sounds_NoteSounds}" />
		</StackPanel>
	</Grid>
</Page>
