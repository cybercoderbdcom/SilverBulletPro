<Page
	x:Class="SilverBulletPro.Views.Main.Tools.ConfigConverter" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="ConfigConverter" xmlns:tools="clr-namespace:SilverBulletPro.Views.Main.Tools">
	<Grid
		Margin="8">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
			<RowDefinition
				Height="auto" />
			<RowDefinition />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<DockPanel>
			<TextBlock
				Margin="5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Tools_CfgConverter_ConfigPath}" /> <Run
					Text=":" /></TextBlock>
			<Button
				MinWidth="83"
				BorderElement.CornerRadius="0 4 4 0"
				IconElement.Geometry="M6,2 C4.89,2 4,2.89 4,4 L4,20 A2,2 0 0 0 6,22L12.68,22 A7,7 0 0 1 12,19A7,7 0 0 1 19,12A7,7 0 0 1 20,12.08L20,8 L14,2 L6,2 M13,3.5 L18.5,9 L13,9 L13,3.5 M18,14 C17.87,14 17.76,14.09 17.74,14.21 L17.55,15.53 C17.25,15.66 16.96,15.82 16.7,16 L15.46,15.5 C15.35,15.5 15.22,15.5 15.15,15.63 L14.15,17.36 C14.09,17.47 14.11,17.6 14.21,17.68 L15.27,18.5 C15.25,18.67 15.24,18.83 15.24,19 C15.24,19.17 15.25,19.33 15.27,19.5 L14.21,20.32 C14.12,20.4 14.09,20.53 14.15,20.64 L15.15,22.37 C15.21,22.5 15.34,22.5 15.46,22.5 L16.7,22 C16.96,22.18 17.24,22.35 17.55,22.47 L17.74,23.79 C17.76,23.91 17.86,24 18,24 L20,24 C20.11,24 20.22,23.91 20.24,23.79 L20.43,22.47 C20.73,22.34 21,22.18 21.27,22 L22.5,22.5 C22.63,22.5 22.76,22.5 22.83,22.37 L23.83,20.64 C23.89,20.53 23.86,20.4 23.77,20.32 L22.7,19.5 C22.72,19.33 22.74,19.17 22.74,19 C22.74,18.83 22.73,18.67 22.7,18.5 L23.76,17.68 C23.85,17.6 23.88,17.47 23.82,17.36 L22.82,15.63 C22.76,15.5 22.63,15.5 22.5,15.5 L21.27,16 C21,15.82 20.73,15.65 20.42,15.53 L20.23,14.21 C20.22,14.09 20.11,14 20,14 L18,14 M19,17.5 C19.83,17.5 20.5,18.17 20.5,19 C20.5,19.83 19.83,20.5 19,20.5 C18.16,20.5 17.5,19.83 17.5,19 C17.5,18.17 18.17,17.5 19,17.5"
				IconElement.Width="17"
				BorderThickness="0,1,1,1"
				Content="{DynamicResource Tools_CfgConverter_Select}"
				DockPanel.Dock="Right"
				Click="SelectCfgButton_Click" />
			<TextBox
				Name="txtConfigPath"
				BorderElement.CornerRadius="4 0 0 4"
				AllowDrop="True"
				Drop="TextBox_Drop"
				PreviewDragOver="TextBox_PreviewDragOver" />
		</DockPanel>
		<ListBox
			Name="listBoxConfigs"
			Grid.Row="1"
			Margin="0,5,0,0"
			AllowDrop="True"
			Background="{DynamicResource BackgroundSecondary}"
			Foreground="{DynamicResource ForegroundMain}"
			SelectionMode="Extended"
			ItemsSource="{Binding ConfigsCollection}"
			DragEnter="ListBox_DragEnter"
			Drop="ListBox_Drop">
			<FrameworkElement.ContextMenu>
				<ContextMenu>
					<MenuItem
						Header="{DynamicResource Remove}"
						Tag="listBoxConfigs"
						Click="RemoveSelMenuItem_Click">
						<MenuItem.Icon>
							<iconpacks:PackIconIonicons
								PackIconIonicons.Kind="CloseiOS" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Ionicons" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem
						Header="{DynamicResource Clear}"
						Tag="listBoxConfigs"
						Click="ClearMenuItem_Click">
						<MenuItem.Icon>
							<iconpacks:PackIconMaterial
								PackIconMaterial.Kind="DeleteForever" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
						</MenuItem.Icon>
					</MenuItem>
				</ContextMenu>
			</FrameworkElement.ContextMenu>
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<SolidColorBrush
						Color="{Binding ElementName=listBoxConfigs, Path=Background}"
						x:Key="RegionBrush" />
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</ListBox>
		<Grid
			Row="2"
			Margin="0,0,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Button
				Height="33"
				HorizontalAlignment="Stretch"
				BorderElement.CornerRadius="0"
				IconElement.Geometry="M15,10.001 C15,10.299999999999999 14.695,10.514999999999999 14.695,10.514999999999999 L6.134,15.817999999999998 C5.51,16.227 5,15.924 5,15.149 L5,4.852 C5,4.075 5.51,3.774 6.135,4.182 L14.696,9.487 C14.695,9.487 15,9.702 15,10.001"
				IconElement.Width="13"
				BorderThickness="1,0,0.5,0"
				Content="{DynamicResource Tools_CfgConverter_Start}"
				Command="{Binding StartCommand}"
				CommandParameter="{Binding ElementName=listBoxConfigs, Path=SelectedItems}"
				IsEnabled="{Binding ControlsEnabled}" />
			<Button
				Grid.Column="1"
				Height="33"
				HorizontalAlignment="Stretch"
				BorderElement.CornerRadius="0"
				IconElement.Geometry="M417,550 Q452,550 476,526 Q500,502 500,467 L500,133 Q500,98 476,74 Q452,50 417,50 L83,50 Q48,50 24,74 Q0,98 0,133 L0,467 Q0,502 24,526 Q48,550 83,550 L417,550"
				IconElement.Width="13"
				BorderThickness="0.5,0,1,0"
				Content="{DynamicResource Tools_CfgConverter_Stop}"
				Command="{Binding StopCommand}" />
		</Grid>
		<ListBox
			Name="listBoxConvConfigs"
			Grid.Row="3"
			Margin="0,0,0,0"
			AllowDrop="True"
			Background="{DynamicResource BackgroundSecondary}"
			Foreground="{DynamicResource ForegroundMain}"
			SelectionMode="Single"
			ItemsSource="{Binding ConvertedConfigsCollection}">
			<FrameworkElement.ContextMenu>
				<ContextMenu>
					<MenuItem
						Header="{DynamicResource Remove}"
						Tag="listBoxConvConfigs"
						Click="RemoveSelMenuItem_Click">
						<MenuItem.Icon>
							<PackIconIonicons
								PackIconIonicons.Kind="CloseiOS" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Ionicons" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem
						Header="{DynamicResource Clear}"
						Tag="listBoxConvConfigs"
						Click="ClearMenuItem_Click">
						<MenuItem.Icon>
							<PackIconMaterial
								PackIconMaterial.Kind="DeleteForever" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" />
						</MenuItem.Icon>
					</MenuItem>
				</ContextMenu>
			</FrameworkElement.ContextMenu>
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<SolidColorBrush
						Color="{Binding ElementName=listBoxConvConfigs, Path=Background}"
						x:Key="RegionBrush" />
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</ListBox>
		<Grid
			Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Button
				Height="32"
				Padding="10,5,10,5"
				HorizontalAlignment="Stretch"
				BorderElement.CornerRadius="0 0 0 4"
				IconElement.Geometry="M21,11.7 L21,7 L17,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L11.7,21 C11.4,20.3 11.2,19.6 11.1,18.8 C9.9,18.4 9,17.3 9,16 C9,14.3 10.3,13 12,13 C12.3,13 12.6,13.1 12.9,13.2 C14.2,11.8 16,11 18,11 C19.1,11 20.1,11.2 21,11.7 M15,9 L5,9 L5,5 L15,5 L15,9 M21.7,18.6 L21.7,17.6 L22.8,16.8 C22.9,16.7 23,16.6 22.9,16.5 L21.9,14.8 C21.9,14.7 21.7,14.7 21.6,14.7 L20.4,15.2 C20.1,15 19.8,14.8 19.5,14.7 L19.3,13.4 C19.3,13.3 19.2,13.2 19.1,13.2 L17.1,13.2 C16.9,13.2 16.8,13.3 16.8,13.4 L16.6,14.7 C16.3,14.9 16.1,15 15.8,15.2 L14.6,14.7 C14.5,14.7 14.4,14.7 14.3,14.8 L13.3,16.5 C13.3,16.6 13.3,16.7 13.4,16.8 L14.5,17.6 L14.5,18.6 L13.4,19.4 C13.3,19.5 13.2,19.6 13.3,19.7 L14.3,21.4 C14.4,21.5 14.5,21.5 14.6,21.5 L15.8,21 C16,21.2 16.3,21.4 16.6,21.5 L16.8,22.8 C16.9,22.9 17,23 17.1,23 L19.1,23 C19.2,23 19.3,22.9 19.3,22.8 L19.5,21.5 C19.8,21.3 20,21.2 20.3,21 L21.5,21.4 C21.6,21.4 21.7,21.4 21.8,21.3 L22.8,19.6 C22.9,19.5 22.9,19.4 22.8,19.4 L21.7,18.6 M18,19.5 C17.2,19.5 16.5,18.8 16.5,18 C16.5,17.2 17.2,16.5 18,16.5 C18.8,16.5 19.5,17.2 19.5,18 C19.5,18.8 18.8,19.5 18,19.5"
				IconElement.Width="17"
				BorderThickness="1,0,0.5,1"
				Content="{DynamicResource Tools_CfgConverter_SaveSelected}"
				Command="{Binding SaveSelectedCommand}"
				CommandParameter="{Binding ElementName=listBoxConvConfigs, Path=SelectedIndex}" />
			<Button
				Grid.Column="1"
				Height="32"
				Padding="10,5,10,5"
				HorizontalAlignment="Stretch"
				BorderElement.CornerRadius="0 0 4 0"
				IconElement.Geometry="M17,7 L17,3 L7,3 L7,7 L17,7 M14,17 A3,3 0 0 0 17,14A3,3 0 0 0 14,11A3,3 0 0 0 11,14A3,3 0 0 0 14,17M19,1 L23,5 L23,17 A2,2 0 0 1 21,19L7,19 C5.89,19 5,18.1 5,17 L5,3 A2,2 0 0 1 7,1L19,1 M1,7 L3,7 L3,21 L17,21 L17,23 L3,23 A2,2 0 0 1 1,21L1,7"
				IconElement.Width="17"
				BorderThickness="0.5,0,1,1"
				Content="{DynamicResource Tools_CfgConverter_SaveAll}"
				Command="{Binding SaveAllCommand}"
				IsEnabled="{Binding ControlsEnabled}" />
		</Grid>
		<CheckBox
			Grid.Row="5"
			Margin="1,16,0,8"
			Content="{DynamicResource Tools_CfgConverter_AddConvertedConfigToListOfConfigs}"
			IsChecked="{Binding AddConvertedConfigToListOfConfigs}"
			IsEnabled="{Binding ControlsEnabled}" />
		<ProgressBar
			Name="progressBar"
			Grid.Row="6"
			Height="24"
			Margin="0,5,0,5"
			Value="{Binding Progress}" />
	</Grid>
</Page>
