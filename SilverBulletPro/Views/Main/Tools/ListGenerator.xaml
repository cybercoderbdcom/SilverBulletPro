<Page
	x:Class="SilverBulletPro.Views.Main.Tools.ListGenerator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="ToolsListGenerator" xmlns:tools="clr-namespace:SilverBulletPro.Views.Main.Tools">
	<Grid
		Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<StackPanel
			Margin="0,0,0,10">
			<TextBlock
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Tools_ListGenerator_Mask}" /> <Run
					Text=":" /></TextBlock>
			<TextBox
				Margin="0,4,0,0"
				Foreground="{DynamicResource ForegroundMain}"
				Text="{Binding Mask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
		</StackPanel>
		<StackPanel
			Grid.Row="1">
			<TextBlock
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Tools_ListGenerator_AllowedChars}" /> <Run
					Text=":" /></TextBlock>
			<Grid
				Margin="0,4,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="auto" />
				</Grid.ColumnDefinitions>
				<TextBox
					BorderElement.CornerRadius="3 0 0 0"
					Foreground="{DynamicResource ForegroundMain}"
					Text="{Binding AllowedCharacters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				<Button
					Grid.Column="1"
					Width="70"
					Height="30"
					VerticalAlignment="Center"
					BorderElement.CornerRadius="0 3 3 0"
					IconElement.Geometry="M264,456 Q210,456 164,429 Q118,402 91,356 Q64,310 64,256 Q64,202 91,156 Q118,110 164,83 Q210,56 264,56 Q318,56 364,83 Q410,110 437,156 Q464,202 464,256 Q464,310 437,356 Q410,402 364,429 Q318,456 264,456 M264,288 L328,352 L360,320 L296,256 L360,192 L328,160 L264,224 L200,160 L168,192 L232,256 L168,320 L200,352 L264,288"
