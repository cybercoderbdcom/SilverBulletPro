				Click="generateListButton_Click" />
		</Grid>
		<TextBox
			Name="generatedTextBox"
			Grid.Row="4"
			Width="300"
			Margin="0,15,0,0"
			HorizontalAlignment="Center"
			VerticalAlignment="Top"
			Visibility="Collapsed" />
	</Grid>
