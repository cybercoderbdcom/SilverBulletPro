					BorderThickness="1"
					Content="{DynamicResource Tools_ListGenerator_Clear}"
					Click="clearButton_Click" />
			</Grid>
			<DockPanel
				HorizontalAlignment="Left">
				<Button
					Width="76"
					Height="28"
					BorderElement.CornerRadius="0 0 0 3"
					IconElement.Geometry="M20,14 L14,14 L14,20 L10,20 L10,14 L4,14 L4,10 L10,10 L10,4 L14,4 L14,10 L20,10 L20,14"
					IconElement.Width="13"
					BorderThickness="1,0,0.5,1"
					Content="{DynamicResource Tools_ListGenerator_Digits}"
					Click="digitsButton_Click" />
				<Button
					Width="96"
					Height="28"
					BorderElement.CornerRadius="0 0 0 0"
					IconElement.Geometry="M20,14 L14,14 L14,20 L10,20 L10,14 L4,14 L4,10 L10,10 L10,4 L14,4 L14,10 L20,10 L20,14"
					IconElement.Width="13"
					BorderThickness="0,0,0.5,1"
					Content="{DynamicResource Tools_ListGenerator_Lowercase}"
					Click="lowercaseButton_Click" />
				<Button
					Width="96"
					Height="28"
					BorderElement.CornerRadius="0 0 3 0"
					IconElement.Geometry="M20,14 L14,14 L14,20 L10,20 L10,14 L4,14 L4,10 L10,10 L10,4 L14,4 L14,10 L20,10 L20,14"
					IconElement.Width="13"
					BorderThickness="0,0,1,1"
					Content="{DynamicResource Tools_ListGenerator_Uppercase}"
					Click="uppercaseButton_Click" />
			</DockPanel>
			<StackPanel
				Name="PanelGeneratedTextBox"
				Margin="0,10,0,0"
				Visibility="Collapsed">
				<TextBlock
					Foreground="{DynamicResource ForegroundLabelStacker}">
					<Run
						Text="{DynamicResource Tools_ListGenerator_Generated}" /> <Run
						Text=":" /></TextBlock>
				<TextBox
					Margin="0,4,0,0" />
			</StackPanel>
		</StackPanel>
		<StackPanel
			Grid.Row="2"
			Margin="0,13,0,0"
			HorizontalAlignment="Left">
			<CheckBox
				Margin="0,0,0,11"
				HorizontalAlignment="Left"
				Content="{DynamicResource Tools_ListGenerator_OnlyOutputLuhnValidNumbers}"
				Foreground="{DynamicResource ForegroundMain}"
				IsChecked="{Binding OnlyLuhn}" />
			<CheckBox
				Margin="0,0,0,12"
				HorizontalAlignment="Left"
				Content="{DynamicResource Tools_ListGenerator_AutoAddToWordlistManager}"
				Foreground="{DynamicResource ForegroundMain}"
				IsChecked="{Binding AutoImport}" />
			<TextBlock
				Margin="0,0,0,8"
				Foreground="{DynamicResource ForegroundMain}"
				Text="{Binding OutputLines, StringFormat=Expeted Number Of Lines: {0}}" />
			<TextBlock
				Margin="0,0,0,8"
				Foreground="{DynamicResource ForegroundMain}"
				Text="{Binding OutputSize, StringFormat=Expected FileSize: {0}}" />
		</StackPanel>
