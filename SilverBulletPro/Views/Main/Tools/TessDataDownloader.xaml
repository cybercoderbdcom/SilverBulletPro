<Page
	x:Class="SilverBulletPro.Views.Main.Tools.TessDataDownloader" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="TessDataDownloader" xmlns:tools="clr-namespace:SilverBulletPro.Views.Main.Tools"
	Loaded="Page_Loaded">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="3*" />
			<RowDefinition
				Height=".5*"
				MaxHeight="41" />
			<RowDefinition
				Height="4*" />
		</Grid.RowDefinitions>
		<StackPanel
			Name="topMenu"
			Orientation="Horizontal">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<Style
						TargetType="{x:Type Label}"
						x:Key="{x:Type Label}">
						<Setter
							Property="FontWeight"
							Value="Bold" />
						<Setter
							Property="Margin"
							Value="0,0,5,0" />
						<Setter
							Property="Foreground"
							Value="{DynamicResource ForegroundMain}" />
						<Setter
							Property="FontFamily"
							Value="pack://application:,,,/Fonts/#Century Gothic" />
						<Setter
							Property="FontSize"
							Value="12" />
						<Setter
							Property="VerticalAlignment"
							Value="Center" />
					</Style>
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</StackPanel>
		<Grid
			Row="0">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="0*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width=".1*"
					MaxWidth="60" />
				<ColumnDefinition
					Width="*" />
			</Grid.ColumnDefinitions>
			<ListBox
				Name="LanguageList"
				Grid.Column="0"
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{Binding ElementName=LanguageList, Path=Background}"
							x:Key="RegionBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ListBox>
			<Grid
				Column="1">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="auto" />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Button
					Width="auto"
					Height="45"
					Padding="3,0,0,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					BorderElement.CornerRadius="0"
					IconElement.Geometry="M480,119 C480,105.7 470.6,96 457.2,96 L198.9,96 C196.1,96 194.6,95.4 192.8,93.6 L170.3,71.1 L170.10000000000002,70.89999999999999 C165.20000000000002,66.3 161.20000000000002,63.99999999999999 152.8,63.99999999999999 L56.7,63.99999999999999 C42.9,64 32,74.3 32,87 L32,160.7 C32,162.29999999999998 33.7,162.2 35,161.39999999999998 C36.3,160.59999999999997 40,159.99999999999997 42,159.99999999999997 L470,159.99999999999997 C472,159.99999999999997 475.7,160.59999999999997 477,161.39999999999998 C478.3,162.2 480,162.29999999999998 480,160.7 L480,119 M32,416.4 C32,433.9 46.2,448 63.6,448 L448,448 C465.6,448 480,433.6 480,416 L480,204 C480,195.2 472.8,188 464,188 L48,188 C39.2,188 32,195.2 32,204 L32,416.4"
					IconElement.Width="16"
					BorderThickness="0,0,0,1"
					ToolTip="{DynamicResource Tools_Tessdata_OpenTessdataFolderTip}"
					Click="OpenFolderButton_Click" />
				<Button
					Grid.Row="1"
					Height="auto"
					Padding="7,0,0,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					BorderElement.CornerRadius="0"
					IconElement.Geometry="M224.3,273 L88.30000000000001,409 C78.9,418.4 63.70000000000001,418.4 54.40000000000001,409 L31.80000000000001,386.4 C22.400000000000013,377 22.400000000000013,361.79999999999995 31.80000000000001,352.5 L128.20000000000002,256.1 L31.80000000000001,159.70000000000002 C22.400000000000013,150.3 22.400000000000013,135.10000000000002 31.80000000000001,125.80000000000001 L54.3,103 C63.699999999999996,93.6 78.9,93.6 88.19999999999999,103 L224.2,239 C233.7,248.4 233.7,263.6 224.29999999999998,273"
					IconElement.Width="9"
					BorderThickness="0,1,0,1"
					ToolTip="{DynamicResource Tools_Tessdata_RightClickToAddAllTip}"
					Click="Button_Click"
					MouseRightButtonDown="Button_MouseRightButtonDown" />
				<Button
					Grid.Row="2"
					Height="auto"
					Padding="7,0,0,0"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					BorderElement.CornerRadius="0"
					IconElement.Geometry="M83.2125,75.625 L105.30625,97.725 A6.25,6.25 1 1 1 96.46875,106.5625L74.36875,84.46875 L52.275,106.5625 A6.25,6.25 1 1 1 43.4375,97.725L65.53125,75.63125 L43.4375,53.53125 A6.25,6.25 1 1 1 52.275,44.69375L74.36875,66.7875 L96.46875,44.69375 A6.25,6.25 1 1 1 105.30625,53.53125L83.2125,75.63125"
					IconElement.Width="11"
					BorderThickness="0,0,0,1"
					ToolTip="Right click to remove all"
					Click="Button_Click_1"
					MouseRightButtonDown="Button_MouseRightButtonDown_1" />
			</Grid>
			<ListBox
				Name="DownloadList"
				Grid.Column="2"
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}" />
		</Grid>
		<DockPanel
			Grid.Row="1">
			<Button
				Name="DownloadBtn"
				Height="auto"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				BorderElement.CornerRadius="0"
				IconElement.Geometry="M5,20 L19,20 L19,18 L5,18 M19,9 L15,9 L15,3 L9,3 L9,9 L5,9 L12,16 L19,9"
				IconElement.Width="13"
				Content="{DynamicResource Tools_Tessdata_Download}"
				Click="DownloadBtn_Click" />
		</DockPanel>
		<Grid
			Row="2">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<TextBox
				Name="LogsText"
				HorizontalContentAlignment="Left"
				VerticalContentAlignment="Top"
				BorderElement.CornerRadius="0"
				Background="{DynamicResource BackgroundSecondary}"
				FontSize="9.5pt"
				Foreground="{DynamicResource ForegroundMain}"
				IsReadOnly="True" />
			<ProgressBar
				Name="progressBar"
				Grid.Row="1"
				Height="20"
				BorderElement.CornerRadius="0 0 3 3"
				Background="{DynamicResource BackgroundMain}" />
		</Grid>
	</Grid>
</Page>
