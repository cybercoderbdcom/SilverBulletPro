<!--Class 'SilverBulletPro.Views.Main.WordlistManager' has IComponentConnector.Connect method, but cannot be parsed.-->
<Page
	x:Class="SilverBulletPro.Views.Main.WordlistManager" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:SilverBulletPro.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="WordlistManager" xmlns:main="clr-namespace:SilverBulletPro.Views.Main"
	Resources="{converters:DivisionConverter Key=DivisionConverter}">
	<controls:TransitioningContentControl
		FrameworkElement.Name="trans"
		Control.Background="{DynamicResource BackgroundWordlistManager}"
		TransitioningContentControl.TransitionMode="Fade" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl">
		<Grid
			Margin="0,6,0,0">
			<uc:ProgressDialog
				Name="progressDialog"
				Margin="50"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Panel.ZIndex="1"
				Background="#00FFFFFF"
				Description="Loading Wordlist"
				IsIndeterminate="True"
				Visibility="Collapsed"
				Width="{Binding ElementName=trans, Path=ActualWidth, Converter={StaticResource DivisionConverter}, ConverterParameter=2}" />
			<Grid
				Name="mainGrid">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="auto" />
					<RowDefinition
						Height="auto" />
					<RowDefinition />
				</Grid.RowDefinitions>
				<DockPanel
					HorizontalAlignment="Left">
					<Button
						Name="addWordlistButton"
						Width="110"
						Height="34"
						BorderElement.CornerRadius="3 0 0 0"
						IconElement.Geometry="M13,9 L18.5,9 L13,3.5 L13,9 M6,2 L14,2 L20,8 L20,20 A2,2 0 0 1 18,22L6,22 C4.89,22 4,21.1 4,20 L4,4 C4,2.89 4.89,2 6,2 M15,18 L15,16 L6,16 L6,18 L15,18 M18,14 L18,12 L6,12 L6,14 L18,14"
						IconElement.Width="14"
						BorderThickness="1,1,0.5,0.5"
						Content="{DynamicResource Add}" />
					<Button
						Name="editWordlistButton"
						Width="110"
						Height="34"
						BorderElement.CornerRadius="0"
						IconElement.Geometry="M6,2 C4.89,2 4,2.89 4,4 L4,20 A2,2 0 0 0 6,22L10,22 L10,20.09 L12.09,18 L6,18 L6,16 L14.09,16 L16.09,14 L6,14 L6,12 L18.09,12 L20,10.09 L20,8 L14,2 L6,2 M13,3.5 L18.5,9 L13,9 L13,3.5 M20.15,13 C20,13 19.86,13.05 19.75,13.16 L18.73,14.18 L20.82,16.26 L21.84,15.25 C22.05,15.03 22.05,14.67 21.84,14.46 L20.54,13.16 C20.43,13.05 20.29,13 20.15,13 M18.14,14.77 L12,20.92 L12,23 L14.08,23 L20.23,16.85 L18.14,14.77"
						IconElement.Width="15.3"
						BorderThickness="0.5,1,0.5,0.5"
						Content="{DynamicResource Edit}" />
					<Button
						Name="delteWordlistButton"
						Width="120"
						Height="34"
						BorderElement.CornerRadius="0"
						IconElement.Geometry="M14.46,15.88 L15.88,14.46 L18,16.59 L20.12,14.46 L21.54,15.88 L19.41,18 L21.54,20.12 L20.12,21.54 L18,19.41 L15.88,21.54 L14.46,20.12 L16.59,18 L14.46,15.88 M12,17 L12,15 L7,15 L7,17 L12,17 M17,11 L7,11 L7,13 L14.69,13 C13.07,14.07 12,15.91 12,18 C12,19.09 12.29,20.12 12.8,21 L5,21 C3.89,21 3,20.1 3,19 L3,5 C3,3.89 3.89,3 5,3 L19,3 A2,2 0 0 1 21,5L21,12.8 C20.12,12.29 19.09,12 18,12 L17,12.08 L17,11 M17,9 L17,7 L7,7 L7,9 L17,9"
						IconElement.Width="16"
						BorderThickness="0.5,1,0.5,0.5"
						Content="{DynamicResource Delete}" />
					<Button
						Name="deleteAllProxyButton"
						Width="110"
						Height="34"
						BorderElement.CornerRadius="0"
						IconElement.Geometry="M6,19 A2,2 0 0 0 8,21L16,21 A2,2 0 0 0 18,19L18,7 L6,7 L6,19 M8.46,11.88 L9.87,10.47 L12,12.59 L14.12,10.47 L15.53,11.88 L13.41,14 L15.53,16.12 L14.12,17.53 L12,15.41 L9.88,17.53 L8.47,16.12 L10.59,14 L8.46,11.88 M15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 L19,4 L15.5,4"
						IconElement.Width="13"
						BorderThickness="0.5,1,0.5,0.5"
						Content="{DynamicResource DeleteAll}" />
					<Button
						Name="deleteNotFoundProxyButton"
						Width="147"
						Height="34"
						BorderElement.CornerRadius="0 3 0 0"
						IconElement.Geometry="M99,248.32334 C96.658787,247.36225 78.875194,233.53814 50.5,210.62175 C-1.6120646,168.53498 0.02185871,170.3043 0.00816071,155.94578 C0.00083116825,148.26281 0.28864314,146.93642 2.834002,142.9228 C4.6339695,140.08455 7.279257,137.6312 10.084002,136.19886 C12.512801,134.95851 41.5,125.82762 74.5,115.908 C107.5,105.98839 134.89363,97.484928 135.37474,97.011427 C136.2748,96.125603 133.28399,92.622931 93.21587,47.637219 C69.303201,20.789731 67.739205,18.446342 69.914718,12.724309 C72.433017,6.1006792 78.548834,5.5132723 93.246191,10.483387 C112.94297,17.144122 167.51555,37.997385 170,39.812532 C172.2999,41.492844999999996 213.99653,96.293283 242.5,135.09676 C254.09397,150.88031999999998 254.50914,151.6203 254.77018,156.96653999999998 C254.91879,160.00993999999997 255.29882,166.60259 255.61471,171.61685999999997 C256.24205,181.57495999999998 255.31003,184.78664999999998 250.21119,190.23700999999997 C247.62767,192.99864999999997 228.59607,201.37319999999997 150.5,234.11334999999997 C117.45316,247.96754999999996 116.27573000000001,248.37515999999997 108.5,248.65311999999997 C104.1,248.81040999999996 99.825,248.66211999999996 99,248.32333999999997 M88.965111,219.12957 C90.18881599999999,214.58507 88.801825,209.49949 85.917735,207.95597 C83.002092,206.39557 80,210.00238 80,215.06574 C80,224.95472 86.591951,227.94281 88.965111,219.12957 M136.74988,192.1333 C149.53731,187.38499 159.99981,183.24289 159.99988,182.92865 C160.00010999999998,181.82729 91.61316199999999,136.54606 83.33320099999999,132.16514 C81.51786899999999,131.20465000000002 77.5452,132.16614 58.84164299999999,138.09484 C46.563025999999994,141.98672 35.93751599999999,145.49522000000002 35.22939799999999,145.8915 C33.21440199999999,147.01915 108.92831,202.05191000000002 111.49999999999999,201.3289 C112.59999999999998,201.01964 123.96244999999999,196.88162 136.74988,192.1333 M199.10440999999997,168.48236 C211.34972999999997,163.79765 221.53201,159.80132 221.73169999999996,159.60163 C222.08657999999997,159.24675 190.71901999999997,140.54925 158.21721999999997,121.74208 L141.93443999999997,112.32004 L119.09094999999996,119.41002 L96.24745799999997,126.5 L100.82901999999997,129.5 C152.56537999999998,163.37688 173.80551999999997,176.93854 175.1701,176.96618 C176.08865,176.98478 186.85908999999998,173.16706000000002 199.10441,168.48236"
						IconElement.Width="16"
						BorderThickness="0.5,1,1,0.5"
						Content="{DynamicResource DeleteNotFound}" />
				</DockPanel>
				<controls:SearchBar
					FrameworkElement.Name="filterTextbox"
					Grid.Row="1"
					BorderElement.CornerRadius="0 3 0 0"
					InfoElement.Placeholder="Search"
					Control.Background="{DynamicResource BackgroundSecondary}"
					Control.Foreground="{DynamicResource ForegroundMain}"
					FrameworkElement.Style="{StaticResource SearchBarExtend}"
					SearchBar.CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}" />
				<ListView
					Name="wordlistListView"
					Grid.Row="2"
					AllowDrop="True"
					Background="#00FFFFFF"
					Foreground="{DynamicResource ForegroundMain}"
					SelectionMode="Extended"
					ItemsSource="{Binding Path=WordlistsCollection}">
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<Style
								TargetType="{x:Type Thumb}"
								x:Key="GridViewColumnHeaderGripper">
								<Setter
									Property="Width"
									Value="18" />
								<Setter
									Property="Background">
									<Setter.Value>
										<LinearGradientBrush
											StartPoint="0,0"
											EndPoint="0,1">
											<GradientBrush.GradientStops>
												<GradientStopCollection>
													<GradientStop
														Offset="0.0"
														Color="{DynamicResource BorderLightColor}" />
													<GradientStop
														Offset="1.0"
														Color="{DynamicResource BorderDarkColor}" />
												</GradientStopCollection>
											</GradientBrush.GradientStops>
										</LinearGradientBrush>
									</Setter.Value>
								</Setter>
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type Thumb}">
											<Border
												Padding="{TemplateBinding Padding}"
												Background="#00FFFFFF">
												<Rectangle
													Width="1"
													HorizontalAlignment="Center"
													Fill="{TemplateBinding Background}" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Setter
									Property="BorderBrush">
									<Setter.Value>
										<LinearGradientBrush
											StartPoint="0.5,0"
											EndPoint="0.5,1">
											<GradientStop
												Offset="0"
												Color="Black" />
											<GradientStop
												Offset="1"
												Color="White" />
										</LinearGradientBrush>
									</Setter.Value>
								</Setter>
							</Style>
							<Style
								TargetType="{x:Type GridViewColumnHeader}"
								x:Key="{x:Type GridViewColumnHeader}">
								<Setter
									Property="HorizontalContentAlignment"
									Value="Left" />
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type GridViewColumnHeader}">
											<Grid>
												<Border
													Background="#00FFFFFF"
													BorderBrush="#FF000000"
													BorderThickness="0,0,0,1">
													<TextBlock
														Name="ContentHeader"
														Width="{TemplateBinding Width}"
														Padding="5,5,5,0"
														Text="{TemplateBinding Content}"
														TextAlignment="Left" />
												</Border>
												<Thumb
													Name="PART_HeaderGripper"
													Margin="0,0,-9,0"
													HorizontalAlignment="Right"
													Style="{StaticResource GridViewColumnHeaderGripper}" />
											</Grid>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Setter
									Property="FrameworkElement.OverridesDefaultStyle"
									Value="True" />
								<Setter
									Property="Foreground"
									Value="{DynamicResource ForegroundMain}" />
								<Setter
									Property="FontFamily"
									Value="pack://application:,,,/Fonts/#Century Gothic" />
								<Setter
									Property="FontSize"
									Value="14" />
							</Style>
							<Style
								TargetType="{x:Type ListViewItem}"
								x:Key="{x:Type ListViewItem}">
								<Setter
									Property="Template">
									<Setter.Value>
										<ControlTemplate
											TargetType="{x:Type ListViewItem}">
											<Border
												Name="Bd"
												Padding="0"
												Background="{TemplateBinding Background}"
												BorderBrush="{TemplateBinding BorderBrush}"
												BorderThickness="{TemplateBinding BorderThickness}"
												SnapsToDevicePixels="true">
												<GridViewRowPresenter
													HorizontalAlignment="Left"
													VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
													SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<Trigger
										Property="UIElement.IsMouseOver"
										Value="True">
										<Setter
											Property="Background"
											Value="{DynamicResource BackgroundSecondary}" />
									</Trigger>
									<Trigger
										Property="ListBoxItem.IsSelected"
										Value="True">
										<Setter
											Property="Background"
											Value="{DynamicResource BackgroundSecondary}" />
									</Trigger>
								</Style.Triggers>
							</Style>
							<Style
								BasedOn="{StaticResource ScrollViewerNativeBaseStyle}"
								TargetType="{x:Type ScrollViewer}"
								x:Key="{x:Type ScrollViewer}" />
							<Style
								BasedOn="{StaticResource ScrollBarBaseStyle}"
								TargetType="{x:Type ScrollBar}"
								x:Key="{x:Type ScrollBar}" />
						</ResourceDictionary>
					</FrameworkElement.Resources>
					<FrameworkElement.Style>
						<Style
							TargetType="{x:Type ListView}" />
					</FrameworkElement.Style>
					<ListView.View>
						<GridView>
							<GridViewColumn
								DisplayMemberBinding="{Binding Path=Name}">
								<GridViewColumn.Header>
									<GridViewColumnHeader
										Content="{DynamicResource Name}"
										Tag="Name" />
								</GridViewColumn.Header>
							</GridViewColumn>
							<GridViewColumn
								Width="250"
								DisplayMemberBinding="{Binding Path=Path}">
								<GridViewColumn.Header>
									<GridViewColumnHeader
										Content="{DynamicResource Path}"
										Tag="Path" />
								</GridViewColumn.Header>
							</GridViewColumn>
							<GridViewColumn
								DisplayMemberBinding="{Binding Path=Type}">
								<GridViewColumn.Header>
									<GridViewColumnHeader
										Content="{DynamicResource Type}"
										Tag="Type" />
								</GridViewColumn.Header>
							</GridViewColumn>
							<GridViewColumn
								DisplayMemberBinding="{Binding Path=Purpose}">
								<GridViewColumn.Header>
									<GridViewColumnHeader
										Content="{DynamicResource Purpose}"
										Tag="Purpose" />
								</GridViewColumn.Header>
							</GridViewColumn>
							<GridViewColumn
								DisplayMemberBinding="{Binding Path=Total}">
								<GridViewColumn.Header>
									<GridViewColumnHeader
										Content="{DynamicResource Total}"
										Tag="Total" />
								</GridViewColumn.Header>
							</GridViewColumn>
						</GridView>
					</ListView.View>
				</ListView>
			</Grid>
		</Grid>
	</controls:TransitioningContentControl>
</Page>
