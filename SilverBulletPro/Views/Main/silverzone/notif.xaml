<!--Class 'SilverBulletPro.Views.Main.Notif' has IComponentConnector.Connect method, but cannot be parsed.-->
<Page
	x:Class="SilverBulletPro.Views.Main.Notif" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:SilverBulletPro.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
	Title="Notif" xmlns:main="clr-namespace:SilverBulletPro.Views.Main">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<converters:Base64ToImageConverter
				x:Key="Base64ToImageConverter" />
			<converters:CalcDateTimeDifferenceConverter
				x:Key="CalcDateTimeDifferenceConverter" />
			<converters:IntToBoolConverter
				x:Key="IntToBoolConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="4,10,0,0">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<controls:SearchBar
			FrameworkElement.Margin="5,0,15,5"
			InfoElement.Placeholder="{DynamicResource Search}"
			Control.Background="{DynamicResource BackgroundSecondary}"
			FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
			Control.FontSize="13.5"
			Control.Foreground="{DynamicResource ForegroundMain}"
			FrameworkElement.Style="{StaticResource SearchBarExtend}" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
			UIElement.IsEnabled="{Binding NotifDataList.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" />
		<ScrollViewer
			Grid.Row="1"
			Margin="0,5,0,0">
			<ItemsControl
				Name="itemsControl"
				Margin="5,0,15,0"
				ScrollViewer.HorizontalScrollBarVisibility="Auto"
				ScrollViewer.VerticalScrollBarVisibility="Auto"
				ItemsSource="{Binding NotifDataList}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border
							MinHeight="140"
							MaxHeight="230"
							Margin="0,0,0,8"
							Padding="9,11,9,3"
							Background="{Binding BackColor}"
							BorderBrush="{Binding BorderColor}"
							BorderThickness="{Binding BorderThickness}"
							CornerRadius="{Binding BorderRadius}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="auto" />
									<RowDefinition />
								</Grid.RowDefinitions>
								<Grid
									Margin="0,-5,0,11">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="auto" />
										<ColumnDefinition />
										<ColumnDefinition
											Width="auto" />
									</Grid.ColumnDefinitions>
									<Ellipse
										Width="30"
										Height="30"
										Margin="0,0,8,0"
										HorizontalAlignment="Center"
										RenderOptions.BitmapScalingMode="HighQuality"
										Stretch="Fill"
										StrokeThickness="1.5"
										Stroke="{Binding IconBorderColor}">
										<Shape.Fill>
											<ImageBrush
												ImageSource="{Binding Icon, Converter={StaticResource Base64ToImageConverter}, ConverterParameter=Notif}" />
										</Shape.Fill>
									</Ellipse>
									<TextBlock
										Grid.Column="1"
										Margin="0,5,0,0"
										FontSize="15"
										FontWeight="Bold"
										RenderOptions.BitmapScalingMode="HighQuality"
										Foreground="{Binding SenderForeColor}"
										Text="{Binding Sender}" />
									<TextBlock
										Grid.Column="2"
										HorizontalAlignment="Right"
										FontWeight="DemiBold"
										Foreground="{Binding DateForeColor}"
										Text="{Binding Date, Converter={StaticResource CalcDateTimeDifferenceConverter}}" />
								</Grid>
								<md:MarkdownScrollViewer
									Grid.Row="1"
									Control.Foreground="{Binding Color}"
									MarkdownScrollViewer.Markdown="{Binding Message}"
									UIElement.Visibility="{Binding MarkDown, Converter={StaticResource Boolean2VisibilityConverter}}" />
								<TextBlock
									Grid.Row="1"
									FontSize="14"
									TextWrapping="Wrap"
									Foreground="{Binding Color}"
									Text="{Binding Message}"
									Visibility="{Binding MarkDown, Converter={StaticResource Boolean2VisibilityReConverter}}" />
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel
							IsItemsHost="True" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</ScrollViewer>
		<controls:CircleProgressBar
			CircleProgressBar.Name="progressBar"
			Grid.RowSpan="2"
			FrameworkElement.Width="86"
			FrameworkElement.Height="86"
			FrameworkElement.Margin="16,0,0,0"
			Panel.ZIndex="1"
			CircleProgressBar.ArcThickness="6"
			CircleProgressBar.IsIndeterminate="True"
			FrameworkElement.Style="{StaticResource ProgressBarInfoCircle}" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
	</Grid>
</Page>
