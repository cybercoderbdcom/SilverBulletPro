<!--Class 'SilverBulletPro.Views.Main.VerifiedMarket' has IComponentConnector.Connect method, but cannot be parsed.-->
<Page
	x:Class="SilverBulletPro.Views.Main.VerifiedMarket" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:SilverBulletPro.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="VerifiedMarket" xmlns:main="clr-namespace:SilverBulletPro.Views.Main">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<converters:CalcDiscountConverter
				x:Key="CalcDiscountConverter" />
			<converters:HasDiscountConverter
				x:Key="HasDiscountConverter" />
			<converters:StringEmptyToIsEnabledConverter
				x:Key="StringEmptyToIsEnabledConverter" />
			<converters:IntToBoolConverter
				x:Key="IntToBoolConverter" />
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid
		Margin="4,10,0,0">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<controls:SearchBar
			FrameworkElement.Margin="5,0,15,5"
			InfoElement.Placeholder="{DynamicResource Search}"
			Control.Background="{DynamicResource BackgroundSecondary}"
			FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
			Control.FontSize="13.5"
			Control.Foreground="{DynamicResource ForegroundMain}"
			FrameworkElement.Style="{StaticResource SearchBarExtend}" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
			UIElement.IsEnabled="{Binding MarketDataList.Count, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" />
		<ScrollViewer
			Grid.Row="1"
			Margin="0,5,0,0">
			<ItemsControl
				Name="itemsControl"
				Margin="5,0,15,0"
				ScrollViewer.HorizontalScrollBarVisibility="Auto"
				ScrollViewer.VerticalScrollBarVisibility="Auto"
				ItemsSource="{Binding MarketDataList}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border
							MinHeight="140"
							MaxHeight="230"
							Margin="0,0,0,8"
							Padding="9,11,9,3"
							CornerRadius="2 6 6 2"
							Background="{Binding BackColor}"
							BorderBrush="{Binding BorderColor}"
							BorderThickness="{Binding BorderThickness}">
							<Grid
								Name="Main">
								<Grid.RowDefinitions>
									<RowDefinition
										Height="auto" />
									<RowDefinition
										MaxHeight="63" />
									<RowDefinition
										Height="auto" />
								</Grid.RowDefinitions>
								<Border
									Name="SellerRank"
									Margin="-11,-12,-10,0"
									Padding="4,1,6,3"
									HorizontalAlignment="Left"
									VerticalAlignment="Top"
									BorderThickness="1"
									CornerRadius="2 0 5 0"
									Background="{Binding SellerRankBackColor}"
									BorderBrush="{Binding SellerRankBackColor}">
									<TextBlock
										FontSize="9.5"
										FontWeight="Bold"
										Foreground="{Binding SellerRankForeColor}"
										Text="{Binding SellerRank}" />
								</Border>
								<Border
									Name="PriceBorder"
									Margin="0,-12,-10,0"
									Padding="10,1,10,2"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									BorderThickness="1"
									CornerRadius="1 3 0 5"
									Background="{Binding BorderColor}"
									BorderBrush="{Binding BorderColor}">
									<TextBlock>
										<Run
											FontSize="16"
											FontWeight="Bold"
											Foreground="{Binding PriceForeColor}"
											Text="{Binding ., Converter={StaticResource CalcDiscountConverter}}" /> <TextBlock
											Margin="2,1,0,0"
											FontSize="11"
											FontWeight="DemiBold"
											TextDecorations="Strikethrough"
											Foreground="{Binding DiscountForeColor}"
											Text="{Binding Price}"
											Visibility="{Binding Discount, Converter={StaticResource HasDiscountConverter}}" /></TextBlock>
								</Border>
								<Grid
									Margin="0,26,0,-40"
									HorizontalAlignment="Right"
									VerticalAlignment="Top">
									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition
											Height="auto" />
									</Grid.RowDefinitions>
									<Button
										Name="mediaControlBtn"
										Width="28"
										Height="28"
										Padding="0"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Panel.ZIndex="1"
										BorderElement.CornerRadius="5"
										IconElement.Geometry="M256,8 C119,8 8,119 8,256 C8,393 119,504 256,504 C393,504 504,393 504,256 C504,119 393,8 256,8 M371.7,280 L195.7,381 C179.89999999999998,389.8 160,378.5 160,360 L160,152 C160,133.6 179.8,122.2 195.7,131 L371.7,238 C388.09999999999997,247.2 388.09999999999997,270.9 371.7,280"
										IconElement.Width="15.5"
										BorderThickness="0"
										CommandParameter="Play"
										Style="{StaticResource ButtonIconCircular}"
										Background="{Binding BorderColor}"
										BorderBrush="{x:Null}"
										Tag="{Binding ElementName=mediaElement}" />
									<Border
										Name="VideoBorder"
										Padding="2"
										BorderThickness="1"
										CornerRadius="6">
										<Grid>
											<Border
												Name="mask"
												Background="{Binding MediaElementBackColor}"
												CornerRadius="{Binding ElementName=VideoBorder, Path=CornerRadius}" />
											<Grid
												Tag="{Binding ElementName=mediaControlBtn}">
												<UIElement.OpacityMask>
													<VisualBrush
														Visual="{Binding ElementName=mask}" />
												</UIElement.OpacityMask>
												<MediaElement
													Name="mediaElement"
													MinWidth="187"
													MinHeight="92"
													IsMuted="False"
													LoadedBehavior="Manual"
													SpeedRatio="1"
													Stretch="Fill"
													Source="{Binding MediaElement}" />
											</Grid>
										</Grid>
									</Border>
								</Grid>
								<Grid
									Name="Info"
									Margin="2,2,0,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition
											Width="auto" />
										<ColumnDefinition
											Width="auto" />
									</Grid.ColumnDefinitions>
									<Ellipse
										Width="60"
										Height="60"
										Margin="0,3,3,0"
										HorizontalAlignment="Center"
										RenderOptions.BitmapScalingMode="HighQuality"
										Stretch="Fill"
										StrokeThickness="1.5"
										Stroke="{Binding IconBorderColor}">
										<Shape.Fill>
											<ImageBrush
												ImageSource="{Binding Path=Icon}" />
										</Shape.Fill>
									</Ellipse>
									<StackPanel
										Grid.Column="1"
										Margin="10,2,0,0">
										<TextBlock
											Margin="0,0,0,5"
											FontSize="15"
											FontWeight="Bold"
											TextTrimming="CharacterEllipsis"
											Foreground="{Binding TextForeColor}"
											Text="{Binding Text}" />
										<TextBlock
											MaxWidth="450"
											FontSize="13"
											TextTrimming="CharacterEllipsis"
											Foreground="{Binding SellerForeColor}"
											Text="{Binding Seller, StringFormat=Seller: {0}}" />
										<TextBlock
											MaxWidth="450"
											FontSize="13"
											TextTrimming="CharacterEllipsis"
											Foreground="{Binding CreationDateForeColor}"
											Text="{Binding CreationDate, StringFormat=Creation Date: {0}}" />
										<TextBlock
											MaxWidth="450"
											FontSize="13"
											Foreground="{DynamicResource ForegroundMain}"
											TextTrimming="CharacterEllipsis">
											<Run
												Text="Category:" /> <Run
												FontWeight="DemiBold"
												Foreground="{Binding CategoryForeColor}"
												Text="{Binding Category}" /></TextBlock>
									</StackPanel>
								</Grid>
								<TextBlock
									Grid.Row="1"
									Margin="6,10,200,0"
									HorizontalAlignment="Left"
									TextAlignment="Justify"
									TextTrimming="CharacterEllipsis"
									TextWrapping="Wrap"
									Foreground="{Binding DescForeColor}"
									Text="{Binding Description}" />
								<Border
									Name="Footer"
									Grid.Row="2"
									Height="40"
									Margin="-9,16,-9,-1"
									BorderThickness="0,2,0,0"
									CornerRadius="0 0 3 0.5"
									Background="{Binding FooterBackColor}"
									BorderBrush="{x:Null}">
									<Grid>
										<DockPanel
											Margin="8,0,0,3"
											HorizontalAlignment="Left">
											<Button
												Width="28"
												Height="28"
												Padding="0,0,2,0"
												BorderElement.CornerRadius="5"
												IconElement.Geometry="M446.7,98.6 L379.1,417.4 C374,439.9 360.70000000000005,445.5 341.8,434.9 L238.8,359 L189.10000000000002,406.8 C183.60000000000002,412.3 179.00000000000003,416.90000000000003 168.40000000000003,416.90000000000003 L175.80000000000004,312 L366.70000000000005,139.5 C375.00000000000006,132.1 364.90000000000003,128 353.80000000000007,135.4 L117.8,284 L16.2,252.2 C-5.900000000000002,245.29999999999998 -6.300000000000001,230.1 20.799999999999997,219.5 L418.2,66.4 C436.59999999999997,59.50000000000001 452.7,70.5 446.7,98.60000000000001"
												IconElement.Width="15.5"
												BorderThickness="1,1,1,1"
												Style="{StaticResource ButtonIconCircular}"
												Background="{Binding TlgBackColor}"
												BorderBrush="{x:Null}"
												Foreground="{Binding TlgForeColor}"
												IsEnabled="{Binding Telegram, Converter={StaticResource StringEmptyToIsEnabledConverter}}"
												Tag="{Binding Telegram}" />
											<Button
												Width="29"
												Height="29"
												Margin="5,0,0,0"
												Padding="0"
												BorderElement.CornerRadius="5"
												IconElement.Geometry="M20.317,4.3698 A19.7913,19.7913 0 0 0 15.431899999999999,2.8545999999999996A0.0741,0.0741 0 0 0 15.353399999999999,2.8916999999999997C15.142399999999999,3.267 14.9087,3.7565 14.745099999999999,4.1411999999999995 C12.9004,3.8649999999999993 11.0651,3.8649999999999993 9.258299999999998,4.1411999999999995 C9.094699999999998,3.7478999999999996 8.8525,3.2669999999999995 8.6406,2.8916999999999993 A0.077,0.077 0 0 0 8.5621,2.8546999999999993A19.7363,19.7363 0 0 0 3.676899999999999,4.369699999999999A0.0699,0.0699 0 0 0 3.644799999999999,4.397399999999999C0.5334,9.0458 -0.319,13.5799 0.0992,18.0578 A0.0824,0.0824 0 0 0 0.1304,18.1139C2.1832,19.6215 4.1716999999999995,20.5367 6.1232999999999995,21.1433 A0.0777,0.0777 0 0 0 6.2075,21.1157C6.669099999999999,20.4853 7.0806,19.8205 7.4335,19.1215 A0.076,0.076 0 0 0 7.3919,19.015800000000002C6.7391,18.768200000000004 6.1175999999999995,18.466300000000004 5.519699999999999,18.123500000000003 A0.077,0.077 0 0 1 5.512099999999999,17.995800000000003C5.637899999999999,17.901500000000002 5.763799999999999,17.803500000000003 5.8839,17.704400000000003 A0.0743,0.0743 0 0 1 5.9615,17.693900000000003C9.8893,19.4872 14.1415,19.4872 18.0229,17.693900000000003 A0.0739,0.0739 0 0 1 18.1014,17.703400000000002C18.2216,17.802400000000002 18.347399999999997,17.901500000000002 18.4742,17.995800000000003 A0.077,0.077 0 0 1 18.4676,18.123400000000004A12.2986,12.2986 0 0 1 16.5946,19.014800000000005A0.0766,0.0766 0 0 0 16.5539,19.121500000000005C16.914299999999997,19.819500000000005 17.325799999999997,20.484300000000005 17.7789,21.114700000000006 A0.076,0.076 0 0 0 17.8631,21.143300000000007C19.824099999999998,20.536600000000007 21.8126,19.62140000000001 23.8654,18.113900000000008 A0.077,0.077 0 0 0 23.896700000000003,18.05870000000001C24.3971,12.88170000000001 23.058500000000002,8.38480000000001 20.348200000000002,4.39830000000001 A0.061,0.061 0 0 0 20.317000000000004,4.36970000000001M8.02,15.3312 C6.8374999999999995,15.3312 5.863099999999999,14.2455 5.863099999999999,12.9122 C5.863099999999999,11.579 6.818599999999999,10.493300000000001 8.0201,10.493300000000001 C9.2309,10.493300000000001 10.195799999999998,11.588500000000002 10.1769,12.912300000000002 C10.1769,14.245500000000002 9.2214,15.331200000000003 8.02,15.331200000000003 M15.9948,15.3312 C14.8123,15.3312 13.8379,14.2455 13.8379,12.9122 C13.8379,11.579 14.793299999999999,10.493300000000001 15.9948,10.493300000000001 C17.2056,10.493300000000001 18.1705,11.588500000000002 18.1516,12.912300000000002 C18.1516,14.245500000000002 17.205599999999997,15.331200000000003 15.994799999999998,15.331200000000003"
												IconElement.Width="17"
												BorderThickness="1,1,1,1"
												Style="{StaticResource ButtonIconCircular}"
												Background="{Binding DiscordBackColor}"
												BorderBrush="{x:Null}"
												Foreground="{Binding DiscordForeColor}"
												IsEnabled="{Binding Discord, Converter={StaticResource StringEmptyToIsEnabledConverter}}"
												Tag="{Binding Discord}" />
										</DockPanel>
										<Grid
											Margin="0,0,10,0"
											HorizontalAlignment="Right">
											<Grid.ColumnDefinitions>
												<ColumnDefinition
													Width="auto" />
												<ColumnDefinition
													Width="auto" />
											</Grid.ColumnDefinitions>
											<Button
												Grid.Column="0"
												Width="90"
												Height="27"
												Padding="0"
												BorderElement.CornerRadius="5"
												IconElement.Geometry="M528.12,301.319 L575.393,93.31900000000002 C578.806,78.301 567.391,64 551.99,64 L159.208,64 L150.042,19.189999999999998 C147.758,8.021 137.93,0 126.529,0 L24,0 C10.745,0 0,10.745 0,24 L0,40 C0,53.255 10.745,64 24,64 L93.883,64 L164.131,407.435 C147.325,417.1 136,435.222 136,456 C136,486.928 161.072,512 192,512 C222.928,512 248,486.928 248,456 C248,440.326 241.553,426.165 231.176,416 L440.823,416 C430.447,426.165 424,440.326 424,456 C424,486.928 449.072,512 480,512 C510.928,512 536,486.928 536,456 C536,433.828 523.112,414.668 504.421,405.595 L509.938,381.319 C513.351,366.30100000000004 501.936,352 486.53499999999997,352 L218.117,352 L211.572,320 L504.717,320 C515.923,320 525.637,312.246 528.12,301.319"
												IconElement.Width="18"
												BorderThickness="1,1,1,1"
												Content="Buy"
												Style="{StaticResource ButtonSuccess}"
												BorderBrush="{x:Null}"
												Tag="{Binding Buy}" />
											<Button
												Grid.Column="1"
												Width="90"
												Height="27"
												Margin="8,0,0,0"
												Padding="0"
												BorderElement.CornerRadius="5"
												IconElement.Geometry="M277,235 L277,363 L235,363 L235,235 L277,235 M256,143 C271,143 284,156 284,171 C284,186 271,198 256,198 C241,198 228,186 228,171 C228,156 241,143 256,143 M336,448 L448,336 L448,176 L336,64 L176,64 L64,176 L64,336 L176,448 L336,448"
												IconElement.Width="17"
												BorderThickness="1"
												Content="Report"
												Style="{StaticResource ButtonDanger}"
												BorderBrush="{x:Null}"
												Tag="{Binding Report}" />
										</Grid>
									</Grid>
								</Border>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel
							IsItemsHost="True" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</ScrollViewer>
		<controls:CircleProgressBar
			CircleProgressBar.Name="progressBar"
			Grid.RowSpan="2"
			FrameworkElement.Width="86"
			FrameworkElement.Height="86"
			FrameworkElement.Margin="16,0,0,0"
			Panel.ZIndex="1"
			CircleProgressBar.ArcThickness="6"
			CircleProgressBar.IsIndeterminate="True"
			FrameworkElement.Style="{StaticResource ProgressBarInfoCircle}" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
	</Grid>
</Page>
