<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockKeycheck" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="PageBlockKeycheck" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<StackPanel
			Grid.Row="0"
			Margin="6,10,6,0">
			<DockPanel>
				<CheckBox
					Margin="0,0,20,0"
					VerticalContentAlignment="Center"
					Content="{DynamicResource InstaBan4xx}"
					IsChecked="{Binding Block.BanOn4XX}" />
				<CheckBox
					VerticalContentAlignment="Center"
					Content="{DynamicResource BanIfNoKeyFound}"
					IsChecked="{Binding Block.BanOnToCheck}" />
			</DockPanel>
			<TextBlock
				Margin="3,10,5,5"
				VerticalAlignment="Center"
				FontWeight="Bold"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Keychains}" /> <Run
					Text=":" /></TextBlock>
			<DockPanel
				Margin="2,5,0,0">
				<Button
					Width="72"
					Height="29"
					Margin="1,1,5,0"
					Padding="0"
					HorizontalAlignment="Left"
					IconElement.Geometry="M16,10 C16,10.553 15.952,11 15.399,11 L11,11 L11,15.399 C11,15.951 10.553,16 10,16 C9.447,16 9,15.951 9,15.399 L9,11 L4.601,11 C4.049,11 4,10.553 4,10 C4,9.447 4.049,9 4.601,9 L9,9 L9,4.601 C9,4.048 9.447,4 10,4 C10.553,4 11,4.048 11,4.601 L11,9 L15.399,9 C15.952,9 16,9.447 16,10"
					IconElement.Width="14"
					Background="{DynamicResource PrimaryBrush}"
					Content="{DynamicResource Add}"
					FontWeight="Bold"
					Click="AddKeychainButton_Click" />
				<Button
					Width="72"
					Height="29"
					Margin="3,1,5,0"
					Padding="0"
					HorizontalAlignment="Left"
					IconElement.Geometry="M32,464 A48,48 0 0 0 80,512L368,512 A48,48 0 0 0 416,464L416,128 L32,128 M304,208 A16,16 0 0 1 336,208L336,432 A16,16 0 0 1 304,432M208,208 A16,16 0 0 1 240,208L240,432 A16,16 0 0 1 208,432M112,208 A16,16 0 0 1 144,208L144,432 A16,16 0 0 1 112,432M432,32 L312,32 L302.6,13.3 A24,24 0 0 0 281.1,0L166.8,0 A23.72,23.72 0 0 0 145.4,13.3L136,32 L16,32 A16,16 0 0 0 0,48L0,80 A16,16 0 0 0 16,96L432,96 A16,16 0 0 0 448,80L448,48 A16,16 0 0 0 432,32"
					IconElement.Width="12"
					Background="{DynamicResource DangerBrush}"
					Content="{DynamicResource Clear}"
					FontWeight="Bold"
					Click="ClearKeychainsButton_Click" />
			</DockPanel>
		</StackPanel>
		<ScrollViewer
			Grid.Row="1"
			Margin="0,5,0,0"
			CanContentScroll="True"
			VerticalScrollBarVisibility="Auto">
			<ItemsControl
				Name="keychainsControl"
				Grid.Row="1"
				Background="#00FFFFFF"
				ItemsSource="{Binding KeychainList}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel
							Orientation="Vertical"
							ScrollViewer.CanContentScroll="True"
							ScrollViewer.IsDeferredScrollingEnabled="True"
							VirtualizingPanel.IsVirtualizing="True"
							VirtualizingPanel.VirtualizationMode="Recycling" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Grid
							Margin="5"
							Background="{Binding KeychainColor}">
							<Grid.RowDefinitions>
								<RowDefinition
									Height="40" />
								<RowDefinition
									Height="40" />
								<RowDefinition
									Height="160" />
							</Grid.RowDefinitions>
							<StackPanel
								Grid.Row="0"
								Orientation="Horizontal">
								<!--Unknown connection ID: 5-->
								<Button
									Width="16"
									Margin="5,2,3,0"
									Padding="0"
									IconElement.Geometry="M1408,800 L1408,608 C1408,555 1365,512 1312,512 L96,512 C43,512 0,555 0,608 L0,800 C0,853 43,896 96,896 L1312,896 C1365,896 1408,853 1408,800"
									Foreground="{DynamicResource ForegroundMain}"
									Style="{StaticResource ButtonIcon}"
									Tag="{Binding Id}" />
								<TextBlock
									Margin="4,5,5,5"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundMain}">
									<Run
										Text="{DynamicResource Type}" /> <Run
										Text=":" /></TextBlock>
								<!--Unknown connection ID: 6-->
								<ComboBox
									Name="keychainTypeCombobox"
									Height="34"
									Tag="{Binding Id}" />
								<TextBlock
									Margin="4,5,5,5"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundMain}">
									<Run
										Text="{DynamicResource Mode}" /> <Run
										Text=":" /></TextBlock>
								<!--Unknown connection ID: 7-->
								<ComboBox
									Name="keychainModeCombobox"
									Height="34"
									Tag="{Binding Id}" />
								<TextBlock
									Margin="4,5,5,5"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundMain}">
									<Run
										Text="{DynamicResource ExecutionPriority}" /> <Run
										Text=":" /></TextBlock>
								<!--Unknown connection ID: 8-->
								<ComboBox
									Name="execPriorityCombobox"
									Height="34"
									Tag="{Binding Id}" />
							</StackPanel>
							<StackPanel
								Grid.Row="1"
								Margin="0,5"
								Orientation="Horizontal">
								<DockPanel
									Visibility="{Binding CustomVisibility}">
									<TextBlock
										Margin="4,5,5,5"
										VerticalAlignment="Center"
										Foreground="{DynamicResource ForegroundMain}">
										<Run
											Text="{DynamicResource CustomType}" /> <Run
											Text=":" /></TextBlock>
									<!--Unknown connection ID: 9-->
									<ComboBox
										Name="customTypeCombobox"
										DropDownElement.ConsistentWidth="False"
										IsEditable="True"
										Text="CUSTOM"
										Tag="{Binding Id}" />
								</DockPanel>
								<TextBlock
									Margin="4,5,5,5"
									VerticalAlignment="Center"
									Foreground="{DynamicResource ForegroundMain}">
									<Run
										Text="{DynamicResource Keys}" /> <Run
										Text=":" /></TextBlock>
								<!--Unknown connection ID: 10-->
								<Button
									Width="18"
									Margin="2,3,0,0"
									Padding="0,0,1,0"
									IconElement.Geometry="M1216,576 L1216,704 C1216,739 1187,768 1152,768 L896,768 L896,1024 C896,1059 867,1088 832,1088 L704,1088 C669,1088 640,1059 640,1024 L640,768 L384,768 C349,768 320,739 320,704 L320,576 C320,541 349,512 384,512 L640,512 L640,256 C640,221 669,192 704,192 L832,192 C867,192 896,221 896,256 L896,512 L1152,512 C1187,512 1216,541 1216,576 M1536,640 C1536,216 1192,-128 768,-128 C344,-128 0,216 0,640 C0,1064 344,1408 768,1408 C1192,1408 1536,1064 1536,640"
									Foreground="{DynamicResource ForegroundMain}"
									Style="{StaticResource ButtonIcon}"
									Tag="{Binding Id}" />
							</StackPanel>
							<ScrollViewer
								Grid.Row="2">
								<ItemsControl
									ItemsSource="{Binding KeyList}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel
												Orientation="Vertical" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid
												Margin="0,0,0,2">
												<Grid.ColumnDefinitions>
													<ColumnDefinition
														Width="auto" />
													<ColumnDefinition
														Width="*" />
													<ColumnDefinition
														Width="auto" />
													<ColumnDefinition
														Width="*" />
												</Grid.ColumnDefinitions>
												<!--Unknown connection ID: 11-->
												<Button
													Grid.Column="0"
													Width="16"
													Margin="5,2,4,0"
													Padding="0"
													IconElement.Geometry="M1408,800 L1408,608 C1408,555 1365,512 1312,512 L96,512 C43,512 0,555 0,608 L0,800 C0,853 43,896 96,896 L1312,896 C1365,896 1408,853 1408,800"
													Foreground="{DynamicResource ForegroundMain}"
													Style="{StaticResource ButtonIcon}"
													Tag="{Binding Id}" />
												<!--Unknown connection ID: 12-->
												<ComboBox
													Name="leftTermCombobox"
													Grid.Column="1"
													DropDownElement.ConsistentWidth="False"
													IsEditable="True"
													Tag="{Binding Id}"
													Text="{Binding LeftTerm}" />
												<!--Unknown connection ID: 13-->
												<ComboBox
													Name="conditionCombobox"
													Grid.Column="2"
													Margin="1,0,1,0"
													DropDownElement.ConsistentWidth="False"
													Tag="{Binding Id}" />
												<DockPanel
													Grid.Column="3"
													Margin="0,0,2,0">
													<!--Unknown connection ID: 14-->
													<Button
														Width="32"
														Padding="10,0,5,0"
														BorderElement.CornerRadius="0 4 4 0"
														IconElement.Geometry="M23.75,20.5833 L52.25,20.5833 L52.25,26.9167 L41.1667,26.9167 L41.1667,58.5833 L34.8333,58.5833 L34.8333,26.9167 L23.75,26.9167 L23.75,20.5833"
														IconElement.Width="8.5"
														BorderThickness="0,1,1,1"
														Content=""
														DockPanel.Dock="Right"
														FontSize="11"
														FontWeight="DemiBold"
														Foreground="{DynamicResource ForegroundMain}"
														Height="{Binding ElementName=inputTextBox, Path=ActualHeight}"
														Background="{Binding ElementName=inputTextBox, Path=Background}"
														Tag="{Binding Id}" />
													<controls:TextBox
														FrameworkElement.Name="inputTextBox"
														BorderElement.CornerRadius="4 0 0 4"
														Control.Background="{DynamicResource BackgroundSecondary}"
														FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
														Control.Foreground="{DynamicResource ForegroundMain}"
														TextBox.TextWrapping="NoWrap" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
														TextBox.Text="{Binding Path=RightTerm, UpdateSourceTrigger=PropertyChanged}" />
												</DockPanel>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</Page>
