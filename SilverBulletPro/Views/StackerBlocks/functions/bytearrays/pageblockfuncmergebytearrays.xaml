<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncMergeByteArrays" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFunctionMergeByteArrays" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			EnableHiddenVar="True"
			ModesOfOutput="ByteArray"
			OutputMode="ByteArray"
			HiddenVar="{Binding HiddenVar, Mode=TwoWay}"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Name="first"
			Grid.Row="2"
			Margin="0,10,0,0"
			EnableEncoding="True"
			Label="{DynamicResource FirstByteArray}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding FirstEncoding, Mode=TwoWay}"
			InputMode="{Binding FirstInputMode, Mode=TwoWay}"
			Text="{Binding FirstByteArray, Mode=TwoWay}" />
		<uc:TextInputBox
			Name="second"
			Grid.Row="3"
			Margin="0,5,0,5"
			EnableEncoding="True"
			Label="{DynamicResource SecondByteArray}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding SecondEncoding, Mode=TwoWay}"
			InputMode="{Binding SecondInputMode, Mode=TwoWay}"
			Text="{Binding SecondByteArray, Mode=TwoWay}" />
	</Grid>
</Page>
