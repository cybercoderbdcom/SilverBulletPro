<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncConstantDictionary" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncConstantDictionary" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="Dictionary"
			OutputMode="Dictionary"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:RichTextInputBox
			Name="rtValues"
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource Value}">
			<uc:RichTextInputBox.RichTextBoxToolTip>
				<TextBlock>key: value</TextBlock>
			</uc:RichTextInputBox.RichTextBoxToolTip>
		</uc:RichTextInputBox>
	</Grid>
</Page>
