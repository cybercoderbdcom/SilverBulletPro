<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncAesDecrypt" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ucv="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncAesDecrypt" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<ucv:VarCapOutputBox
			Name="outputVar"
			EnableEncoding="True"
			EnableHiddenVar="True"
			EnableOutputMode="True"
			ModesOfOutput="ByteArray,Base64,Hex,String"
			Encoding="{Binding OutputEncoding, Mode=TwoWay}"
			HiddenVar="{Binding HiddenVar, Mode=TwoWay}"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			OutputMode="{Binding OutputType, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<ucv:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			EnableEncoding="True"
			Label="{DynamicResource CipherText}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding CipherTextEncoding, Mode=TwoWay}"
			InputMode="{Binding CipherTextInputMode, Mode=TwoWay}"
			Text="{Binding CipherText, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			EnableEncoding="True"
			Label="{DynamicResource Key}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding KeyEncoding, Mode=TwoWay}"
			InputMode="{Binding KeyInputMode, Mode=TwoWay}"
			Text="{Binding Key, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="4"
			Margin="0,5,0,0"
			EnableEncoding="True"
			Label="{DynamicResource Aes_IV}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding IvEncoding, Mode=TwoWay}"
			InputMode="{Binding IvInputMode, Mode=TwoWay}"
			Text="{Binding IV, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="5"
			Margin="0,5,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Mode}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="cipherModeBox"
				Background="{DynamicResource BackgroundSecondary}"
				SelectedItem="{Binding CipherMode}" />
		</DockPanel>
		<DockPanel
			Grid.Row="6"
			Margin="0,5,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Padding}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="paddingModeBox"
				Background="{DynamicResource BackgroundSecondary}"
				SelectedItem="{Binding PaddingMode}" />
		</DockPanel>
		<ucv:NumStrInputBox
			Grid.Row="7"
			Height="29"
			Margin="3,5,0,0"
			Label="{DynamicResource KeySize}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding KeySizeInputMode, Mode=TwoWay}"
			NumericValue="{Binding KeySize, Mode=TwoWay}"
			StringValue="{Binding KeySizeString, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="8"
			Height="29"
			Margin="3,5,0,0"
			Label="{DynamicResource BlockSize}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding BlockSizeInputMode, Mode=TwoWay}"
			NumericValue="{Binding BlockSize, Mode=TwoWay}"
			StringValue="{Binding BlockSizeString, Mode=TwoWay}" />
	</Grid>
</Page>
