<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncPbkdf2Pkcs5" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ucv="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncPBKDF2PKCS5" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<ucv:VarCapOutputBox
			Name="outputVar"
			EnableEncoding="True"
			EnableHiddenVar="True"
			EnableOutputMode="True"
			ModesOfOutput="ByteArray,Base64,Hex,String"
			Encoding="{Binding OutputEncoding, Mode=TwoWay}"
			HiddenVar="{Binding HiddenVar, Mode=TwoWay}"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			OutputMode="{Binding OutputType, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<ucv:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="2"
			Margin="0,10,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Type}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="typeBox"
				SelectionChanged="TypeFuncBox_SelectionChanged" />
		</DockPanel>
		<ucv:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			EnableEncoding="True"
			Label="{DynamicResource Password}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding PasswordEncoding, Mode=TwoWay}"
			InputMode="{Binding PasswordInputMode, Mode=TwoWay}"
			Text="{Binding Password, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="4"
			Margin="0,5,0,0"
			EnableEncoding="True"
			Label="{DynamicResource Salt}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding SaltEncoding, Mode=TwoWay}"
			InputMode="{Binding SaltInputMode, Mode=TwoWay}"
			Text="{Binding Salt, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="5"
			Height="29"
			Margin="4,5,0,0"
			Label="{DynamicResource SaltSize}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding SaltSizeInputMode, Mode=TwoWay}"
			NumericValue="{Binding SaltSize, Mode=TwoWay}"
			StringValue="{Binding SaltSizeString, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="6"
			Height="29"
			Margin="4,5,0,0"
			Label="{DynamicResource Iterations}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding IterationsInputMode, Mode=TwoWay}"
			NumericValue="{Binding Iterations, Mode=TwoWay}"
			StringValue="{Binding IterationsString, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="7"
			Height="29"
			Margin="4,5,0,0"
			Label="{DynamicResource KeyLength}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding KeyLengthInputMode, Mode=TwoWay}"
			NumericValue="{Binding KeyLength, Mode=TwoWay}"
			StringValue="{Binding KeyLengthString, Mode=TwoWay}" />
	</Grid>
</Page>
