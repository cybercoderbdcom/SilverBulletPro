<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncRsaPkcs1Pad2" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ucv="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncRsaPkcs1Pad2" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<ucv:VarCapOutputBox
			Name="outputVar"
			EnableEncoding="True"
			EnableHiddenVar="True"
			EnableOutputMode="True"
			ModesOfOutput="ByteArray,Base64,Hex,String"
			Encoding="{Binding OutputEncoding, Mode=TwoWay}"
			HiddenVar="{Binding HiddenVar, Mode=TwoWay}"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			OutputMode="{Binding OutputType, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<ucv:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			EnableEncoding="True"
			Label="{DynamicResource PlainText}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding PlainTextEncoding, Mode=TwoWay}"
			InputMode="{Binding PlainTextInputMode, Mode=TwoWay}"
			Text="{Binding PlainText, Mode=TwoWay}" />
		<ucv:TextInputBox
			Name="modulusControl"
			Grid.Row="3"
			Margin="0,5,0,0"
			EnableEncoding="True"
			Label="{DynamicResource Rsa_Modulus}"
			ModesOfInput="Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding ModulusEncoding, Mode=TwoWay}"
			InputMode="{Binding ModulusInputMode, Mode=TwoWay}"
			Text="{Binding Modulus, Mode=TwoWay}" />
		<ucv:TextInputBox
			Name="exponentControl"
			Grid.Row="4"
			Margin="0,5,0,0"
			EnableEncoding="True"
			Label="{DynamicResource Rsa_Exponent}"
			ModesOfInput="Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding ExponentEncoding, Mode=TwoWay}"
			InputMode="{Binding ExponentInputMode, Mode=TwoWay}"
			Text="{Binding Exponent, Mode=TwoWay}" />
	</Grid>
</Page>
