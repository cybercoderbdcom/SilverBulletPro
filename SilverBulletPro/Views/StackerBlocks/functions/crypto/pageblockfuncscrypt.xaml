<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncScrypt" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ucv="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncScrypt" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<ucv:VarCapOutputBox
			Name="outputVar"
			EnableEncoding="True"
			EnableHiddenVar="True"
			EnableOutputMode="True"
			ModesOfOutput="ByteArray,Base64,Hex,String"
			Encoding="{Binding OutputEncoding, Mode=TwoWay}"
			HiddenVar="{Binding HiddenVar, Mode=TwoWay}"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			OutputMode="{Binding OutputType, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<ucv:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			EnableEncoding="True"
			Label="{DynamicResource Password}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding PasswordEncoding, Mode=TwoWay}"
			InputMode="{Binding PassInputMode, Mode=TwoWay}"
			Text="{Binding Password, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			EnableEncoding="True"
			Label="{DynamicResource Salt}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding SaltEncoding, Mode=TwoWay}"
			InputMode="{Binding SaltInputMode, Mode=TwoWay}"
			Text="{Binding Salt, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="4"
			Height="29"
			Margin="4,5,0,0"
			Label="{DynamicResource Scrypt_Cost}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding CostInputMode, Mode=TwoWay}"
			NumericValue="{Binding Cost, Mode=TwoWay}"
			StringValue="{Binding CostString, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="5"
			Height="29"
			Margin="4,5,0,0"
			Label="{DynamicResource BlockSize}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding BlockSizeInputMode, Mode=TwoWay}"
			NumericValue="{Binding BlockSize, Mode=TwoWay}"
			StringValue="{Binding BlockSizeString, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="6"
			Height="29"
			Margin="4,5,0,0"
			Label="{DynamicResource Scrypt_ThreadCount}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ThreadCountInputMode, Mode=TwoWay}"
			NumericValue="{Binding ThreadCount, Mode=TwoWay}"
			StringValue="{Binding ThreadCountString, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="7"
			Height="29"
			Margin="4,5,0,0"
			Label="{DynamicResource Scrypt_OutputLength}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding OutputLengthInputMode, Mode=TwoWay}"
			NumericValue="{Binding OutputLength, Mode=TwoWay}"
			StringValue="{Binding OutputLengthString, Mode=TwoWay}" />
	</Grid>
</Page>
