<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncDictionaryToList" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncDictionaryToList" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="ListString"
			OutputMode="ListString"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource KeyValue_Dictionary}"
			ModesOfInput="Var,CSharp,JavaScript,Python"
			InputMode="{Binding DictionaryInputMode, Mode=TwoWay}"
			Text="{Binding Dictionary, Mode=TwoWay}" />
		<StackPanel
			Grid.Row="3"
			Margin="5,11,0,0">
			<RadioButton
				Margin="0,0,0,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource Dict_Keys}"
				IsChecked="{Binding Keys}" />
			<RadioButton
				Margin="0,5,0,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource Dict_Values}"
				IsChecked="{Binding Values}" />
		</StackPanel>
	</Grid>
</Page>
