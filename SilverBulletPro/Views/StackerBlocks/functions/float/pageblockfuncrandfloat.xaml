<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncRandFloat" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncRandFloat" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Name="inputControl1"
			Grid.Row="2"
			Height="29"
			Margin="3,10,0,0"
			DecimalPlaces="1"
			Label="{DynamicResource Minimum}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding MinInputMode, Mode=TwoWay}"
			NumericValue="{Binding MinDec, Mode=TwoWay}"
			StringValue="{Binding MinString, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Name="inputControl2"
			Grid.Row="3"
			Height="29"
			Margin="3,5,0,0"
			DecimalPlaces="1"
			Label="{DynamicResource Maximum}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding MaxInputMode, Mode=TwoWay}"
			NumericValue="{Binding MaxDec, Mode=TwoWay}"
			StringValue="{Binding MaxString, Mode=TwoWay}" />
	</Grid>
</Page>
