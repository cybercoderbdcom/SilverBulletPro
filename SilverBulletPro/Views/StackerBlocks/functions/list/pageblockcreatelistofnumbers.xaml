<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockCreateListOfNumbers" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockCreateListOfNumbers" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="ListString"
			OutputMode="ListString"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Name="inputControl"
			Grid.Row="2"
			Height="29"
			Margin="0,10,0,0"
			Label="{DynamicResource StartNum}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding StartInputMode}"
			NumericValue="{Binding Start, Mode=TwoWay}"
			StringValue="{Binding StartString, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="3"
			Height="29"
			Margin="0,5,0,0"
			Label="{DynamicResource Count}"
			Minimum="0"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding CountInputMode}"
			NumericValue="{Binding Count, Mode=TwoWay}"
			StringValue="{Binding CountString, Mode=TwoWay}" />
	</Grid>
</Page>
