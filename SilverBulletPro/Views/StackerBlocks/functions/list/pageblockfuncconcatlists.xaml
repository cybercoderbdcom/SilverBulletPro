<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncConcatLists" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncConcatLists" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			EnableHiddenVar="True"
			ModesOfOutput="ListString"
			OutputMode="ListString"
			HiddenVar="{Binding HiddenVar, Mode=TwoWay}"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="3,10,0,0"
			Label="{DynamicResource FirstListStr}"
			ModesOfInput="Var,CSharp,JavaScript,Python"
			InputMode="{Binding FirstInputMode, Mode=TwoWay}"
			Text="{Binding FirstList, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="3,5,0,0"
			Label="{DynamicResource SecondListStr}"
			ModesOfInput="Var,CSharp,JavaScript,Python"
			InputMode="{Binding SecondInputMode, Mode=TwoWay}"
			Text="{Binding SecondList, Mode=TwoWay}" />
	</Grid>
</Page>
