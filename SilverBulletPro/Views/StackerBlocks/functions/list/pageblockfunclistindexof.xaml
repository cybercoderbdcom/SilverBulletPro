<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncListIndexOf" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncListIndexOf" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="3,10,0,0"
			Label="{DynamicResource List}"
			ModesOfInput="Var,CSharp,JavaScript,Python"
			InputMode="{Binding ListInputMode, Mode=TwoWay}"
			Text="{Binding List, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="3,5,0,0"
			Label="{DynamicResource Item}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ItemInputMode, Mode=TwoWay}"
			Text="{Binding Item, Mode=TwoWay}" />
		<StackPanel
			Grid.Row="5"
			Margin="2,6,0,0">
			<CheckBox
				Margin="0,6,20,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource ExactMatch}"
				IsChecked="{Binding ExactMatch}" />
			<CheckBox
				Margin="0,8,0,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource CaseSensitive}"
				IsChecked="{Binding CaseSensitive}" />
		</StackPanel>
	</Grid>
</Page>
