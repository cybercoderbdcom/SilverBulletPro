<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncCharAt" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="BlockFuncCharAt" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource Input}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding InputMode, Mode=TwoWay}"
			Text="{Binding Input, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Name="indexNum"
			Grid.Row="3"
			Height="29"
			Margin="2,5,0,0"
			Label="{DynamicResource Index}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding IndexInputMode, Mode=TwoWay}"
			NumericValue="{Binding Index, Mode=TwoWay}"
			StringValue="{Binding IndexString, Mode=TwoWay}" />
	</Grid>
</Page>
