<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncRandomString" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncRandomString" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<uc:VarCapOutputBox
				ModesOfOutput="String"
				OutputMode="String"
				IsCapture="{Binding IsCapture, Mode=TwoWay}"
				Text="{Binding VariableName, Mode=TwoWay}" />
			<uc:SafeModeCtrl
				Grid.Row="1"
				Margin="0,6,0,0"
				HorizontalAlignment="Left"
				SafeMode="{Binding SafeMode, Mode=TwoWay}" />
			<uc:TextInputBox
				Grid.Row="2"
				Margin="0,10,0,0"
				Label="{DynamicResource Input}"
				ModesOfInput="Const,Var,CSharp,JavaScript,Python"
				InputMode="{Binding InputMode, Mode=TwoWay}"
				Text="{Binding Input, Mode=TwoWay}" />
			<uc:TextInputBox
				Grid.Row="3"
				Margin="0,5,0,5"
				Label="{DynamicResource CustomCharset}"
				ModesOfInput="Const,Var,CSharp,JavaScript,Python"
				InputMode="{Binding CustomCharsetInputMode, Mode=TwoWay}"
				Text="{Binding CustomCharset, Mode=TwoWay}" />
		</Grid>
		<TextBlock
			Margin="10"
			HorizontalAlignment="Center"
			VerticalAlignment="Bottom"
			FontWeight="DemiBold"
			Foreground="{DynamicResource ForegroundMain}"
			TextAlignment="Center"
			TextTrimming="CharacterEllipsis"
			TextWrapping="WrapWithOverflow">?l = Lowercase, ?u = Uppercase, ?d = Digit, ?f = Uppercase + Lowercase, ?s = Symbol, ?h = Hex (Lowercase), ?m = Upper + Digits, ?n = Lower + Digits ?i = Lower + Upper + Digits, ?a = Any</TextBlock>
	</Grid>
</Page>
