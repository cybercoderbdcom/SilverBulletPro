<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncRegexReplace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncRegexReplace" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource Input}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding InputMode, Mode=TwoWay}"
			Text="{Binding Input, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource RegexPattern}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding PatternInputMode, Mode=TwoWay}"
			Text="{Binding Pattern, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="4"
			Margin="0,5,0,0"
			Label="{DynamicResource Replacement}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ReplacementInputMode, Mode=TwoWay}"
			Text="{Binding Replacement, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="5"
			Margin="0,5,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource RegexOption}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="regexOptionComboBox"
				Margin="1,0,0,0"
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}"
				IsEditable="True"
				SelectedItem="{Binding RegexOptions}"
				LostFocus="RegexOptionComboBox_LostFocus" />
		</DockPanel>
	</Grid>
</Page>
