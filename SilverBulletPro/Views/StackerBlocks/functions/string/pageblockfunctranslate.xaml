<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncTranslate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncTranslate" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks"
	Unloaded="Page_Unloaded">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,5"
			Label="{DynamicResource Input}"
			InputMode="{Binding InputMode, Mode=TwoWay}"
			Text="{Binding Input, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="3"
			Margin="-3,2,0,2"
			HorizontalAlignment="Left">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Trans_ReplaceOne}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="5,0,0,0"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding ReplaceOne}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
		<uc:RichTextInputBox
			Name="rtValues"
			Grid.Row="4"
			Margin="0,4,0,0"
			Label="{DynamicResource Value}" />
	</Grid>
</Page>
