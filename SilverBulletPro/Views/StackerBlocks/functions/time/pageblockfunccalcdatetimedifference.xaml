<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockFuncCalcDateTimeDifference" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncCalcDateTimeDifference" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource FirstDateTime}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding FirstInputMode, Mode=TwoWay}"
			Text="{Binding First, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource SecondDateTime}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding SecondInputMode, Mode=TwoWay}"
			Text="{Binding Second, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="4"
			Margin="0,5,0,5"
			Label="{DynamicResource Format}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding FormatInputMode, Mode=TwoWay}"
			Text="{Binding Format, Mode=TwoWay}" />
	</Grid>
</Page>
