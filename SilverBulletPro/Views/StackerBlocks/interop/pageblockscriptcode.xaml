<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockScript" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Title="PageBlockScript" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks"
	Loaded="Page_Loaded"
	LostFocus="Page_LostFocus"
	Unloaded="Page_Unloaded">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<StackPanel>
			<DockPanel
				Margin="2,5,5,0">
				<TextBlock
					Margin="4,5,5,5"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundRetry}">
					<Run
						Text="{DynamicResource OutputVariable}" /> <Run
						Text=":" /></TextBlock>
				<Button
					Width="35"
					Padding="6,0,0,0"
					BorderElement.CornerRadius="0 4 4 0"
					IconElement.Geometry="M512,960 C230.39999999999998,960 0,729.6 0,448 C0,166.39999999999998 230.4,-64 512,-64 C793.6,-64 1024,166.4 1024,448 C1024,729.6 793.6,960 512,960 M832,384 L576,384 L576,128 L448,128 L448,384 L192,384 L192,512 L448,512 L448,768 L576,768 L576,512 L832,512 L832,384"
					IconElement.Width="17"
					Background="{DynamicResource BackgroundSecondary}"
					BorderThickness="0,1,1,1"
					DockPanel.Dock="Right"
					Click="ChangeOutVar_Click" />
				<TextBox
					Name="outputVariable"
					BorderElement.CornerRadius="4 0 0 4"
					KeyDown="OutputVariable_KeyDown" />
			</DockPanel>
			<DockPanel
				Margin="2,5,5,5">
				<TextBlock
					Margin="4,5,5,5"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource Interpreter}" /> <Run
						Text=":" /></TextBlock>
				<ComboBox
					Name="interpreterBox"
					Margin="27,0,0,0"
					SelectionChanged="InterpreterBox_SelectionChanged" />
			</DockPanel>
		</StackPanel>
		<avalonedit:TextEditor
			TextEditor.Name="scriptEditor"
			Grid.Row="1"
			Control.Padding="0"
			FrameworkElement.HorizontalAlignment="Stretch"
			FrameworkElement.VerticalAlignment="Stretch"
			Control.Background="{DynamicResource BackgroundSecondary}"
			Control.FontFamily="Consolas"
			Control.FontSize="10pt"
			TextEditor.WordWrap="False" xmlns:avalonedit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
			x:Name="scriptEditor"
			LostFocus="ScriptEditor_LostFocus" />
	</Grid>
</Page>
