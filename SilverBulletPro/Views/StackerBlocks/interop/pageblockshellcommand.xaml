<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockShellCommand" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockShellCommand" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			EnableEncoding="True"
			EnableOutputMode="False"
			Encoding="{Binding OutputEncoding, Mode=TwoWay}"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource ShellCmd_Executable}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ExecInputMode, Mode=TwoWay}"
			Text="{Binding Executable, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource ShellCmd_Arguments}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ArgsInputMode, Mode=TwoWay}"
			Text="{Binding Arguments, Mode=TwoWay}" />
		<StackPanel
			Grid.Row="4"
			Margin="2,6,0,0">
			<CheckBox
				Margin="0,6,20,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource ShellCmd_WaitForExit}"
				IsChecked="{Binding WaitForExit}" />
		</StackPanel>
	</Grid>
</Page>
