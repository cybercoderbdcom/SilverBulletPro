<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockParse" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:SilverBulletPro.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockParse" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks"
	Loaded="Page_Loaded">
	<Grid
		Margin="5">
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<conv:EnumToIntConverter
					x:Key="EnumToIntConverter" />
				<conv:BooleanBrushConverter
					x:Key="BrushConverter" />
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<StackPanel
			Grid.Row="0">
			<DockPanel>
				<TextBlock
					Margin="5"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource Parse}" /> <Run
						Text=":" /></TextBlock>
				<Button
					Name="parseTargetInputMode"
					Width="32"
					Padding="0,0,5,0"
					BorderElement.CornerRadius="0 4 4 0"
					IconElement.Geometry="M23.75,20.5833 L52.25,20.5833 L52.25,26.9167 L41.1667,26.9167 L41.1667,58.5833 L34.8333,58.5833 L34.8333,26.9167 L23.75,26.9167 L23.75,20.5833"
					IconElement.Width="0"
					BorderThickness="0,1,1,1"
					Content=""
					DockPanel.Dock="Right"
					FontSize="11"
					FontWeight="DemiBold"
					Foreground="{DynamicResource ForegroundMain}"
					Background="{Binding ElementName=parseTargetCombobox, Path=Background}"
					Click="ParseTargetInputModeButton_Click" />
				<ComboBox
					Name="parseTargetCombobox"
					BorderElement.CornerRadius="4 0 0 4"
					DropDownElement.ConsistentWidth="False"
					IsEditable="True"
					Text="{Binding ParseTarget}" />
			</DockPanel>
			<uc:VarCapOutputBox
				VarCapChanged="VarCapChanged"
				Margin="0,5,0,3"
				ModesOfOutput="String"
				OutputMode="String"
				IsCapture="{Binding IsCapture, Mode=TwoWay}"
				Text="{Binding VariableName, Mode=TwoWay}" />
			<uc:SafeModeCtrl
				Margin="3,6,0,8"
				HorizontalAlignment="Left"
				SafeMode="{Binding SafeMode, Mode=TwoWay}" />
			<Grid
				Margin="0,5">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="auto" />
					<RowDefinition
						Height="auto" />
				</Grid.RowDefinitions>
				<uc:TextInputBox
					Label="{DynamicResource Prefix}"
					ModesOfInput="Const,Var,CSharp,JavaScript,Python"
					InputMode="{Binding PrefixInputMode, Mode=TwoWay}"
					Text="{Binding Prefix, Mode=TwoWay}" />
				<uc:TextInputBox
					Grid.Row="1"
					Margin="0,4,0,0"
					Label="{DynamicResource Suffix}"
					ModesOfInput="Const,Var,CSharp,JavaScript,Python"
					InputMode="{Binding SuffixInputMode, Mode=TwoWay}"
					Text="{Binding Suffix, Mode=TwoWay}" />
			</Grid>
			<DockPanel
				Margin="0,2,0,2">
				<TextBlock
					Margin="3,5,5,5"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource Mode}" /> <Run
						Text=":" /></TextBlock>
				<ComboBox
					Name="parseTypeComboBox"
					Margin="3,0,0,0"
					FontWeight="Medium"
					Style="{StaticResource ComboBoxCapsule}"
					SelectedItem="{Binding Type}" />
			</DockPanel>
			<TabControl
				Name="typeTabControl"
				Margin="0,2,0,0"
				Background="#00FFFFFF"
				BorderThickness="0"
				Style="{StaticResource BaseStyle}"
				SelectedIndex="{Binding Type, Converter={StaticResource EnumToIntConverter}, ConverterParameter=0}">
				<ItemsControl.ItemContainerStyle>
					<Style
						TargetType="{x:Type TabItem}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
					</Style>
				</ItemsControl.ItemContainerStyle>
				<TabItem>
					<StackPanel>
						<uc:TextInputBox
							Label="{DynamicResource LeftString}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding LeftStringInputMode, Mode=TwoWay}"
							Text="{Binding LeftString, Mode=TwoWay}" />
						<uc:TextInputBox
							Margin="0,6,0,0"
							Label="{DynamicResource RightString}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding RightStringInputMode, Mode=TwoWay}"
							Text="{Binding RightString, Mode=TwoWay}" />
						<DockPanel
							Margin="5,10,0,6"
							HorizontalAlignment="Left">
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource Recursive}"
								IsChecked="{Binding Recursive}" />
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource EncOutput}"
								IsChecked="{Binding EncodeOutput}" />
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource CreateEmpty}"
								IsChecked="{Binding CreateEmpty}" />
							<CheckBox
								VerticalContentAlignment="Center"
								Content="{DynamicResource UseRegex}"
								IsChecked="{Binding UseRegexLR}">
								<FrameworkElement.ToolTip>
									<TextBlock>Whether the program matches the LEFT and RIGHT strings through a regex pattern<LineBreak />or with simple string in string searches</TextBlock>
								</FrameworkElement.ToolTip>
							</CheckBox>
						</DockPanel>
						<TextBlock
							Margin="5"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ForegroundMain}">
							<Run
								Text="{DynamicResource AutomaticMode}" /> <Run
								Text=":" /></TextBlock>
						<RichTextBox
							Name="LRRTB"
							Height="200"
							Background="{DynamicResource BackgroundSecondary}"
							FontFamily="Consolas"
							Foreground="{DynamicResource ForegroundMain}"
							KeyUp="LRRTB_KeyUp">
							<FrameworkElement.Resources>
								<ResourceDictionary>
									<Style
										TargetType="{x:Type Paragraph}"
										x:Key="{x:Type Paragraph}">
										<Setter
											Property="Block.Margin"
											Value="0" />
									</Style>
								</ResourceDictionary>
							</FrameworkElement.Resources>
							<FrameworkElement.ToolTip>
								<TextBlock>You can paste the source code in this box, and highlight the part you want to parse.<LineBreak />When the SHIFT key is released, the program will try to automatically determine the LEFT and RIGHT strings</TextBlock>
							</FrameworkElement.ToolTip>
						</RichTextBox>
					</StackPanel>
				</TabItem>
				<TabItem>
					<StackPanel>
						<uc:TextInputBox
							Label="{DynamicResource CssSelector}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding CssSelectorInputMode, Mode=TwoWay}"
							Text="{Binding CssSelector, Mode=TwoWay}" />
						<uc:TextInputBox
							Margin="0,6,0,0"
							Label="{DynamicResource CssAttribute}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							ToolTip="{DynamicResource AttributeTip}"
							InputMode="{Binding AttributeNameInputMode, Mode=TwoWay}"
							Text="{Binding AttributeName, Mode=TwoWay}" />
						<uc:NumStrInputBox
							Height="29"
							Margin="0,6,0,13"
							Label="{DynamicResource Index}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding CssElementIndexInputMode, Mode=TwoWay}"
							IsEnabled="{Binding Recursive, Converter={StaticResource InverseBooleanConverter}}"
							NumericValue="{Binding CssElementIndex, Mode=TwoWay}"
							StringValue="{Binding CssElementIndexString, Mode=TwoWay}" />
						<StackPanel
							Margin="4,0,0,0"
							HorizontalAlignment="Left"
							Orientation="Horizontal">
							<CheckBox
								Margin="0,0,15,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource Recursive}"
								IsChecked="{Binding Recursive}" />
							<CheckBox
								Margin="0,0,15,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource EncOutput}"
								IsChecked="{Binding EncodeOutput}" />
							<CheckBox
								VerticalContentAlignment="Center"
								Content="{DynamicResource CreateEmpty}"
								IsChecked="{Binding CreateEmpty}" />
						</StackPanel>
					</StackPanel>
				</TabItem>
				<TabItem>
					<StackPanel>
						<uc:TextInputBox
							Label="{DynamicResource FieldName}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding JsonFieldInputMode, Mode=TwoWay}"
							Text="{Binding JsonField, Mode=TwoWay}" />
						<CheckBox
							Margin="3,8,0,5"
							HorizontalAlignment="Left"
							VerticalContentAlignment="Center"
							Content="{DynamicResource UseJTokenParsing}"
							ToolTip="{DynamicResource UseJTokenParsingTip}"
							IsChecked="{Binding JTokenParsing}" />
						<StackPanel
							Margin="4,6,0,0"
							Orientation="Horizontal">
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource Recursive}"
								IsChecked="{Binding Recursive}" />
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource EncOutput}"
								IsChecked="{Binding EncodeOutput}" />
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource CreateEmpty}"
								IsChecked="{Binding CreateEmpty}" />
						</StackPanel>
					</StackPanel>
				</TabItem>
				<TabItem>
					<StackPanel>
						<uc:TextInputBox
							Label="{DynamicResource XPath}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding XPathInputMode, Mode=TwoWay}"
							Text="{Binding XPath, Mode=TwoWay}" />
						<uc:TextInputBox
							Margin="0,6,0,0"
							Label="{DynamicResource XPathAttribute}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							ToolTip="{DynamicResource XPathAttributeTip}"
							InputMode="{Binding XPathAttribNameInputMode, Mode=TwoWay}"
							Text="{Binding XPathAttribName, Mode=TwoWay}" />
						<uc:NumStrInputBox
							Height="29"
							Margin="0,6,0,13"
							Label="{DynamicResource Index}"
							Minimum="-1"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding XPathElementIndexInputMode, Mode=TwoWay}"
							IsEnabled="{Binding Recursive, Converter={StaticResource InverseBooleanConverter}}"
							NumericValue="{Binding XPathElementIndex, Mode=TwoWay}"
							StringValue="{Binding XPathElementIndexString, Mode=TwoWay}" />
						<StackPanel
							Margin="4,0,0,0"
							HorizontalAlignment="Left"
							Orientation="Horizontal">
							<CheckBox
								Margin="0,0,15,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource Recursive}"
								IsChecked="{Binding Recursive}" />
							<CheckBox
								Margin="0,0,15,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource EncOutput}"
								IsChecked="{Binding EncodeOutput}" />
							<CheckBox
								VerticalContentAlignment="Center"
								Content="{DynamicResource CreateEmpty}"
								IsChecked="{Binding CreateEmpty}" />
						</StackPanel>
					</StackPanel>
				</TabItem>
				<TabItem>
					<StackPanel>
						<uc:TextInputBox
							Label="{DynamicResource Parse_Regex}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding RegexStringInputMode, Mode=TwoWay}"
							Text="{Binding RegexString, Mode=TwoWay}" />
						<uc:TextInputBox
							Margin="0,6,0,0"
							Label="{DynamicResource Parse_RegexOutput}"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							ToolTip="You can write: [0] = Full Match, [1] = First group etc."
							InputMode="{Binding RegexOutputInputMode, Mode=TwoWay}"
							Text="{Binding RegexOutput, Mode=TwoWay}" />
						<uc:NumStrInputBox
							Height="29"
							Margin="0,6,0,5"
							Label="{DynamicResource Index}"
							Minimum="-1"
							ModesOfInput="Const,Var,CSharp,JavaScript,Python"
							InputMode="{Binding RegexIndexInputMode, Mode=TwoWay}"
							NumericValue="{Binding RegexIndex, Mode=TwoWay}"
							StringValue="{Binding RegexIndexString, Mode=TwoWay}" />
						<StackPanel
							Margin="3,8,0,5"
							Orientation="Horizontal">
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource Recursive}"
								IsChecked="{Binding Recursive}" />
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource EncOutput}"
								IsChecked="{Binding EncodeOutput}" />
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource CreateEmpty}"
								IsChecked="{Binding CreateEmpty}" />
						</StackPanel>
						<StackPanel
							Margin="3,6,0,0"
							Orientation="Horizontal">
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource DotMatches}"
								IsChecked="{Binding DotMatches}" />
							<CheckBox
								Margin="0,0,10,0"
								VerticalContentAlignment="Center"
								Content="{DynamicResource CaseSensitive}"
								IsChecked="{Binding CaseSensitive}" />
						</StackPanel>
					</StackPanel>
				</TabItem>
			</TabControl>
		</StackPanel>
	</Grid>
</Page>
