<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockPuppeteerOpenBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockPuppeteerOpenBrowser" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="1"
			Margin="0,10,0,0"
			Label="{DynamicResource Browser_ExtraCmdLineArgs}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ExtraCmdLineArgsInputMode, Mode=TwoWay}"
			Text="{Binding ExtraCmdLineArgs, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="2"
			Margin="0,5,0,0"
			Visibility="Collapsed">
			<CheckBox
				IsChecked="{Binding UseCaptchaSolver}">
				<TextBlock>
					<Run
						Text="{DynamicResource Puppeteer_UseCaptchaSolver}" /> <Run
						Text=":" /></TextBlock>
			</CheckBox>
			<ComboBox
				Name="captchaTypeBox"
				Margin="5,0,0,0"
				Background="{DynamicResource BackgroundSecondary}"
				ToolTip="{DynamicResource Type}"
				IsEnabled="{Binding UseCaptchaSolver}"
				SelectedItem="{Binding CaptchaType}" />
		</DockPanel>
		<StackPanel
			Grid.Row="3"
			Margin="3,11,0,0">
			<DockPanel>
				<TextBlock
					Margin="0,2,0,0"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource Puppeteer_StartMaximized}" /> <Run
						Text=":" /></TextBlock>
				<ToggleButton
					Margin="13,0,0,0"
					HorizontalAlignment="Left"
					Background="{DynamicResource BackgroundMain}"
					Style="{StaticResource ToggleButtonSwitch}"
					IsChecked="{Binding StartMaximized}">
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<SolidColorBrush
								Color="{DynamicResource DarkSuccessColor}"
								x:Key="PrimaryBrush" />
						</ResourceDictionary>
					</FrameworkElement.Resources>
				</ToggleButton>
			</DockPanel>
			<DockPanel
				Margin="0,7,0,0">
				<TextBlock
					Margin="0,2,0,0"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource Puppeteer_StartFullScreen}" /> <Run
						Text=":" /></TextBlock>
				<ToggleButton
					Margin="13,0,0,0"
					HorizontalAlignment="Left"
					Background="{DynamicResource BackgroundMain}"
					Style="{StaticResource ToggleButtonSwitch}"
					IsChecked="{Binding StartFullScreen}">
					<FrameworkElement.Resources>
						<ResourceDictionary>
							<SolidColorBrush
								Color="{DynamicResource DarkSuccessColor}"
								x:Key="PrimaryBrush" />
						</ResourceDictionary>
					</FrameworkElement.Resources>
				</ToggleButton>
			</DockPanel>
		</StackPanel>
	</Grid>
</Page>
