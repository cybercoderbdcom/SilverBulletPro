<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockPuppeteerNavigateTo" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockPuppeteerNavigateTo" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="1"
			Margin="0,10,0,0"
			Label="{DynamicResource Puppeteer_Url}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding UrlInputMode, Mode=TwoWay}"
			Text="{Binding Url, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="2"
			Margin="0,5,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Puppeteer_LoadedEvent}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="loadedEventComboBox"
				Margin="1,0,0,0"
				Background="{DynamicResource BackgroundSecondary}"
				Foreground="{DynamicResource ForegroundMain}"
				SelectedItem="{Binding LoadedEvent}" />
		</DockPanel>
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource Puppeteer_Referer}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding RefererInputMode, Mode=TwoWay}"
			Text="{Binding Referer, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="4"
			Height="29"
			Margin="0,5,0,0"
			Label="{DynamicResource TimeoutMs}"
			Minimum="0"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding TimeoutInputMode, Mode=TwoWay}"
			NumericValue="{Binding Timeout, Mode=TwoWay}"
			StringValue="{Binding TimeoutString, Mode=TwoWay}" />
		<CheckBox
			Grid.Row="5"
			Margin="2,10,0,5"
			Content="{DynamicResource Selenium_BanOnTimeout}"
			Foreground="{DynamicResource ForegroundMain}"
			IsChecked="{Binding BanOnTimeout}" />
		<uc:RichTextInputBox
			Name="rtCustomHeaders"
			Grid.Row="6"
			Margin="0,5,0,0"
			Label="{DynamicResource Http_CustomHeaders}" />
	</Grid>
</Page>
