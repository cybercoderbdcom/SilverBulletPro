<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockPuppeteerSetCookies" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockPuppeteerSetCookies" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="1"
			Margin="0,10,0,0"
			Label="{DynamicResource Puppeteer_Domain}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding DomainInputMode, Mode=TwoWay}"
			Text="{Binding Domain, Mode=TwoWay}" />
		<uc:RichTextInputBox
			Name="rtCookies"
			Grid.Row="2"
			Margin="0,5,0,0"
			Label="{DynamicResource Puppeteer_Cookies}">
			<uc:RichTextInputBox.RichTextBoxToolTip>
				<TextBlock>
					<Run
						Text="{DynamicResource SyntaxTip}" /> <Run
						Text=":" /><LineBreak />name: value</TextBlock>
			</uc:RichTextInputBox.RichTextBoxToolTip>
		</uc:RichTextInputBox>
	</Grid>
</Page>
