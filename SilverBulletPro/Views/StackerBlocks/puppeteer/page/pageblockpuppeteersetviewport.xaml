<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockPuppeteerSetViewport" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PagePuppeteerSetViewport" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="1"
			Height="29"
			Margin="0,10,0,0"
			Label="{DynamicResource Puppeteer_Width}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding WidthInputMode, Mode=TwoWay}"
			NumericValue="{Binding Width, Mode=TwoWay}"
			StringValue="{Binding WidthString, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="2"
			Height="29"
			Margin="0,5,0,0"
			Label="{DynamicResource Puppeteer_Height}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding HeightInputMode, Mode=TwoWay}"
			NumericValue="{Binding Height, Mode=TwoWay}"
			StringValue="{Binding HeightString, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="3"
			Height="29"
			Margin="0,5,0,0"
			DecimalPlaces="1"
			Label="{DynamicResource Puppeteer_ScaleFactor}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ScaleFactorInputMode, Mode=TwoWay}"
			NumericValue="{Binding ScaleFactor, Mode=TwoWay}"
			StringValue="{Binding ScaleFactorString, Mode=TwoWay}" />
		<StackPanel
			Grid.Row="4"
			Margin="2,6,0,0">
			<CheckBox
				Margin="0,6,20,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource Puppeteer_IsMobile}"
				IsChecked="{Binding IsMobile}" />
			<CheckBox
				Margin="0,8,0,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource Puppeteer_IsLandscape}"
				IsChecked="{Binding IsLandscape}" />
		</StackPanel>
	</Grid>
</Page>
