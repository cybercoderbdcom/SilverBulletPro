<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockReqsFtpDownload" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockReqsFtpDownloadFolder" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="1"
			Margin="0,10,0,0"
			Label="{DynamicResource Ftp_RemotePath}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding RemotePathInputMode, Mode=TwoWay}"
			Text="{Binding RemotePath, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,5,0,0"
			Label="{DynamicResource Ftp_LocalDir}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding LocalDirInputMode, Mode=TwoWay}"
			Text="{Binding LocalDirectoryPath, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="3"
			Margin="-2,5,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ftp_TraversalMode}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="traversalModeBox"
				Background="{DynamicResource BackgroundSecondary}"
				SelectedItem="{Binding TraversalMode}" />
		</DockPanel>
		<DockPanel
			Grid.Row="4"
			Margin="-2,5,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ftp_TransferMethod}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="transferMethodBox"
				Background="{DynamicResource BackgroundSecondary}"
				SelectedItem="{Binding TransferMethod}" />
		</DockPanel>
		<DockPanel
			Grid.Row="5"
			Margin="-2,5,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ftp_ActionOnExistingFiles}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="actionOnExistingFilesBox"
				Background="{DynamicResource BackgroundSecondary}"
				SelectedItem="{Binding ActionOnExistingFiles}" />
		</DockPanel>
		<uc:NumStrInputBox
			Grid.Row="6"
			Height="29"
			Margin="0,5,0,0"
			Label="{DynamicResource Ftp_MaxDownloadSpeed}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			ToolTip="For unlimited speed, set to zero."
			InputMode="{Binding MaxDownloadSpeedInputMode, Mode=TwoWay}"
			NumericValue="{Binding MaxDownloadSpeed, Mode=TwoWay}"
			StringValue="{Binding MaxDownloadSpeedString, Mode=TwoWay}" />
	</Grid>
</Page>
