<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockReqsFtpReadResponse" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockReqsFtpReadResponse" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="2"
			Margin="0,10,0,0"
			HorizontalAlignment="Left">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ftp_ReadRaw}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="40,0,0,0"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding Raw}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
		<DockPanel
			Grid.Row="3"
			Margin="0,5,0,0"
			HorizontalAlignment="Left">
			<TextBlock
				Margin="3,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ftp_ReadDescription}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="4,0,0,0"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding Description}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
		<DockPanel
			Grid.Row="4"
			Margin="0,5,0,0"
			HorizontalAlignment="Left">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ftp_ReadGroup}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="30,0,0,0"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding Group}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
		<DockPanel
			Grid.Row="5"
			Margin="0,5,0,0"
			HorizontalAlignment="Left">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Ftp_ReadCode}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="35,0,0,0"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding Code}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
	</Grid>
</Page>
