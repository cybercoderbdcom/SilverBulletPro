<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockCFBypass" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockCFBypass" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,8,0,0"
			Label="{DynamicResource Http_ApiUrl}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ApiUrlInputMode, Mode=TwoWay}"
			Text="{Binding ApiUrl, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource Http_ProxyUrl}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ProxUrlInputMode, Mode=TwoWay}"
			Text="{Binding ProxyUrl, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="4"
			Margin="0,5,0,0"
			Label="{DynamicResource Http_Url}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding UrlInputMode, Mode=TwoWay}"
			Text="{Binding Url, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="5"
			Margin="0,5,0,0">
			<TextBlock
				Margin="3,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Http_Method}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="methodComboBox"
				SelectedItem="{Binding Method}"
				SelectionChanged="MethodComboBox_SelectionChanged" />
		</DockPanel>
		<uc:NumStrInputBox
			Grid.Row="6"
			Height="29"
			Margin="0,5,0,0"
			Label="{DynamicResource MaxTimeout}"
			Minimum="1"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			ToolTip="{DynamicResource MaxTimeoutTip}"
			InputMode="{Binding MaxTimeoutInputMode, Mode=TwoWay}"
			NumericValue="{Binding MaxTimeout, Mode=TwoWay}"
			StringValue="{Binding MaxTimeoutString, Mode=TwoWay}" />
		<Separator
			Grid.Row="7"
			Height="1"
			Margin="0,6,0,2"
			Background="{DynamicResource BorderBrush}" />
		<uc:TextInputBox
			Grid.Row="8"
			Margin="0,5,0,0"
			Label="{DynamicResource Http_PostData}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding PostDataInputMode, Mode=TwoWay}"
			Text="{Binding PostData, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="9"
			Margin="0,5,0,0">
			<TextBlock
				Margin="5,4,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Http_ContentType}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="contentTypeComboBox"
				Text="{Binding ContentType}" />
		</DockPanel>
		<Separator
			Grid.Row="10"
			Height="1"
			Margin="0,6,0,2"
			Background="{DynamicResource BorderBrush}" />
		<DockPanel
			Grid.Row="11"
			Margin="0,10,0,0"
			HorizontalAlignment="Left">
			<TextBlock
				Margin="5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Http_ReadResponseContent}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="5,0,0,0"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding ReadResponseContent}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
	</Grid>
</Page>
