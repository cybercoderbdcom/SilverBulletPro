<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockDestroyCFBypass" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockDestroyCFBypass" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:TextInputBox
			Grid.Row="1"
			Margin="0,8,0,0"
			Label="{DynamicResource Http_ApiUrl}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ApiUrlInputMode, Mode=TwoWay}"
			Text="{Binding ApiUrl, Mode=TwoWay}" />
	</Grid>
</Page>
