<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockReqsImapSearchMails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockReqsImapSearchMails" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource Imap_From}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding FromInputMode, Mode=TwoWay}"
			Text="{Binding From, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource Imap_Subject}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding SubjectInputMode, Mode=TwoWay}"
			Text="{Binding Subject, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="4"
			Margin="0,5,0,0"
			Label="{DynamicResource Imap_Arrived}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ArrivedInputMode, Mode=TwoWay}"
			Text="{Binding Arrived, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="5"
			Margin="0,5,0,0"
			Label="{DynamicResource Imap_Body}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding BodyInputMode, Mode=TwoWay}"
			Text="{Binding Body, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="6"
			Margin="0,5,0,0"
			Label="{DynamicResource Imap_Keyword}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding KeywordInputMode, Mode=TwoWay}"
			Text="{Binding Keyword, Mode=TwoWay}" />
	</Grid>
</Page>
