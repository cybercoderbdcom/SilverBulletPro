<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockReqsSmtpLogin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockReqsSmtpLogin" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="2"
			Margin="-2,10,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Smtp_Method}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="loginMethod"
				Background="{DynamicResource BackgroundSecondary}"
				SelectedItem="{Binding Method}"
				SelectionChanged="LoginMethod_SelectionChanged" />
		</DockPanel>
		<uc:TextInputBox
			Name="token"
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource Smtp_Token}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			Visibility="Collapsed"
			InputMode="{Binding TokenInputMode, Mode=TwoWay}"
			Text="{Binding Token, Mode=TwoWay}" />
		<uc:TextInputBox
			Name="username"
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource Smtp_Email}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding UserInputMode, Mode=TwoWay}"
			Text="{Binding Username, Mode=TwoWay}" />
		<uc:TextInputBox
			Name="password"
			Grid.Row="4"
			Margin="0,5,0,0"
			Label="{DynamicResource Smtp_Password}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding PassInputMode, Mode=TwoWay}"
			Text="{Binding Password, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="5"
			Margin="-1,5,0,0">
			<TextBlock
				Margin="4,5,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource Smtp_AuthenticationMethod}" /> <Run
					Text=":" /></TextBlock>
			<ComboBox
				Name="authMethod"
				Background="{DynamicResource BackgroundSecondary}"
				SelectedItem="{Binding AuthMethod}" />
		</DockPanel>
	</Grid>
</Page>
