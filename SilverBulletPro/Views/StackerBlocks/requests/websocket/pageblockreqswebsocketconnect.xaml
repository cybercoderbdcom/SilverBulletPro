<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockReqsWebSocketConnect" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockReqsWebSocketConnect" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="1"
			Margin="0,10,0,0"
			Label="{DynamicResource Ws_Url}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding UrlInputMode, Mode=TwoWay}"
			Text="{Binding Url, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,5,0,0"
			Label="{DynamicResource Ws_Username}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding UserInputMode, Mode=TwoWay}"
			Text="{Binding Username, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource Ws_Password}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding PassInputMode, Mode=TwoWay}"
			Text="{Binding Password, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="4"
			Height="29"
			Margin="0,5,0,0"
			Label="{DynamicResource Ws_KeepAliveTimeout}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding KeepAliveTimeoutInputMode, Mode=TwoWay}"
			NumericValue="{Binding KeepAliveTimeout, Mode=TwoWay}"
			StringValue="{Binding KeepAliveTimeoutString, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="5"
			Height="29"
			Margin="0,5,0,0"
			Label="{DynamicResource Ws_Timeout}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding TimeoutInputMode, Mode=TwoWay}"
			NumericValue="{Binding Timeout, Mode=TwoWay}"
			StringValue="{Binding TimeoutString, Mode=TwoWay}" />
		<uc:RichTextInputBox
			Name="rtCustomCookies"
			Grid.Row="6"
			Height="112"
			Margin="0,7,0,0"
			Label="{DynamicResource Ws_CustomCookies}">
			<uc:RichTextInputBox.RichTextBoxToolTip>
				<TextBlock>
					<Run
						Text="{DynamicResource SyntaxTip}" /> :<LineBreak />name: value</TextBlock>
			</uc:RichTextInputBox.RichTextBoxToolTip>
		</uc:RichTextInputBox>
		<uc:RichTextInputBox
			Name="rtCustomHeaders"
			Grid.Row="7"
			Height="112"
			Margin="0,5,0,0"
			Label="{DynamicResource Ws_CustomHeaders}">
			<uc:RichTextInputBox.RichTextBoxToolTip>
				<TextBlock>
					<Run
						Text="{DynamicResource SyntaxTip}" /> :<LineBreak />name: value</TextBlock>
			</uc:RichTextInputBox.RichTextBoxToolTip>
		</uc:RichTextInputBox>
	</Grid>
</Page>
