<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockReqsWebSocketSendAudio" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockReqsWebSocketSendAudio" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource Ws_OpeningMessage}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding OpeningMsgInputMode, Mode=TwoWay}"
			Text="{Binding OpeningMessage, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource Ws_Path}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding PathInputMode, Mode=TwoWay}"
			Text="{Binding Path, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="4"
			Margin="0,5,0,0"
			Label="{DynamicResource Ws_ClosingMessage}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding OpeningMsgInputMode, Mode=TwoWay}"
			Text="{Binding ClosingMessage, Mode=TwoWay}" />
	</Grid>
</Page>
