<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockSeleniumOpenBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockSeleOpenBrowser" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="1"
			Margin="0,10,0,0"
			Label="{DynamicResource Browser_ExtraCmdLineArgs}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ExtraCmdLineArgsInputMode, Mode=TwoWay}"
			Text="{Binding ExtraCmdLineArgs, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,5,0,0"
			Label="{DynamicResource Browser_CustomUserAgent}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding CustomUserAgentInputMode, Mode=TwoWay}"
			Text="{Binding CustomUserAgent, Mode=TwoWay}" />
	</Grid>
</Page>
