<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockSeleniumSetBrowserSize" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockSeleniumSetBrowserSize" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="1"
			Height="29"
			Margin="0,10,0,0"
			Label="{DynamicResource Selenium_BrowserWidth}"
			Minimum="0"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding WidthInputMode, Mode=TwoWay}"
			NumericValue="{Binding Width, Mode=TwoWay}"
			StringValue="{Binding WidthString, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="2"
			Height="29"
			Margin="0,5,0,0"
			Label="{DynamicResource Selenium_BrowserHeight}"
			Minimum="0"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding HeightInputMode, Mode=TwoWay}"
			NumericValue="{Binding Height, Mode=TwoWay}"
			StringValue="{Binding HeightString, Mode=TwoWay}" />
	</Grid>
</Page>
