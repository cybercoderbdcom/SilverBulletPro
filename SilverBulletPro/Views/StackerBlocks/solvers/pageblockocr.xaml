			<DockPanel
				Grid.Row="3"
				Margin="0,5,0,0">
				<TextBlock
					Margin="4,5,5,5"
					VerticalAlignment="Center"
					Foreground="{DynamicResource ForegroundMain}">
					<Run
						Text="{DynamicResource RegexOption}" /> <Run
						Text=":" /></TextBlock>
				<ComboBox
					Name="regexOptionComboBox"
					Margin="1,0,0,0"
					Background="{DynamicResource BackgroundSecondary}"
					Foreground="{DynamicResource ForegroundMain}"
					IsEditable="True"
					SelectedItem="{Binding RegexOptions}"
					LostFocus="RegexOptionComboBox_LostFocus" />
			</DockPanel>
		</Grid>
		<Separator
			Grid.Row="18"
			Height="1"
			Margin="0,5,0,2"
			Background="{DynamicResource BorderBrush}" />
		<StackPanel
			Grid.Row="19"
			Margin="2,4,0,7">
			<CheckBox
				Margin="0,6,20,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource Ocr_EvaluatingMathematicalExpressions}"
				IsChecked="{Binding EvaluatingMathExp}" />
		</StackPanel>
	</Grid>
</Page>
