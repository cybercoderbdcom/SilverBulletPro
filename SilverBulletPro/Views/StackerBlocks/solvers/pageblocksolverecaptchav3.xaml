<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockSolveRecaptchaV3" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockSolveRecaptchaV3" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,0"
			Label="{DynamicResource Captchas_SiteKey}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding SiteKeyInputMode, Mode=TwoWay}"
			Text="{Binding SiteKey, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="3"
			Margin="0,5,0,0"
			Label="{DynamicResource Captchas_SiteUrl}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding SiteUrlInputMode, Mode=TwoWay}"
			Text="{Binding SiteUrl, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="4"
			Margin="0,5,0,0"
			Label="{DynamicResource Captchas_Action}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ActionInputMode, Mode=TwoWay}"
			Text="{Binding Action, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Name="inputControl"
			Grid.Row="5"
			Height="29"
			Margin="0,5,0,0"
			DecimalPlaces="1"
			Label="{DynamicResource Captchas_MinScore}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding MinScoreInputMode, Mode=TwoWay}"
			NumericValue="{Binding MinScore, Mode=TwoWay}"
			StringValue="{Binding MinScoreString, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="6"
			Margin="0,5,0,0"
			Label="{DynamicResource Captchas_UserAgent}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding UserAgentInputMode, Mode=TwoWay}"
			Text="{Binding UserAgent, Mode=TwoWay}" />
		<StackPanel
			Grid.Row="7"
			Margin="2,7,0,0">
			<CheckBox
				Margin="0,6,20,0"
				HorizontalAlignment="Left"
				Content="{DynamicResource Captchas_Enterprise}"
				IsChecked="{Binding Enterprise}" />
			<CheckBox
				Margin="0,8,0,0"
				Content="{DynamicResource UseProxy}"
				IsChecked="{Binding UseProxy}" />
		</StackPanel>
	</Grid>
</Page>
