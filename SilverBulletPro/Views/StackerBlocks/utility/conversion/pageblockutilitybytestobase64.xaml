<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockUtilityBytesToBase64" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockUtilityBytesToBase64" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,5"
			EnableEncoding="True"
			Label="{DynamicResource UtilityConv_Bytes}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding StringEncoding, Mode=TwoWay}"
			InputMode="{Binding InputMode, Mode=TwoWay}"
			Text="{Binding Input, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="3">
			<TextBlock
				Margin="4,9,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource UtilityConv_UrlEncode}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="10,5,0,0"
				HorizontalAlignment="Left"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding UrlEncoded}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
	</Grid>
</Page>
