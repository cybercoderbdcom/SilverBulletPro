<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockUtilityIntegerToBytes" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockUtilityIntegerToBytes" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Grid.Row="2"
			Height="29"
			Margin="4,10,0,0"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Label="{DynamicResource UtilityConv_Input}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding InputMode, Mode=TwoWay}"
			NumericValue="{Binding Input, Mode=TwoWay}"
			StringValue="{Binding InputString, Mode=TwoWay}" />
	</Grid>
</Page>
