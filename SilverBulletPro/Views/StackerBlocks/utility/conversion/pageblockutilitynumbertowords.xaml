<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockUtilityNumberToWords" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockFuncNumberToWords" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<uc:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:NumStrInputBox
			Name="inputControl"
			Grid.Row="2"
			Height="29"
			Margin="0,10,0,0"
			Label="{DynamicResource Number}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding NumInputMode, Mode=TwoWay}"
			NumericValue="{Binding Number, Mode=TwoWay}"
			StringValue="{Binding NumberString, Mode=TwoWay}" />
	</Grid>
</Page>
