<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockUtilityReadableSize" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ucv="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockUtilityReadableSize" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<ucv:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<ucv:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,5"
			Label="{DynamicResource UtilityConv_Input}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding InputMode, Mode=TwoWay}"
			Text="{Binding Input, Mode=TwoWay}" />
		<DockPanel
			Grid.Row="3">
			<TextBlock
				Margin="4,9,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource UtilityConv_OutputBits}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="10,5,0,0"
				HorizontalAlignment="Left"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding OutputBits}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
		<DockPanel
			Grid.Row="4"
			Margin="0,2,0,3">
			<TextBlock
				Margin="4,9,5,5"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}">
				<Run
					Text="{DynamicResource UtilityConv_BinaryUnit}" /> <Run
					Text=":" /></TextBlock>
			<ToggleButton
				Margin="12,5,0,0"
				HorizontalAlignment="Left"
				Background="{DynamicResource BackgroundMain}"
				Style="{StaticResource ToggleButtonSwitch}"
				IsChecked="{Binding BinaryUnit}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</DockPanel>
		<ucv:NumStrInputBox
			Grid.Row="5"
			Height="29"
			Margin="4,8,0,0"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Label="{DynamicResource UtilityConv_DecimalPlaces}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding DecimalPlacesInputMode, Mode=TwoWay}"
			NumericValue="{Binding DecimalPlaces, Mode=TwoWay}"
			StringValue="{Binding DecimalPlacesString, Mode=TwoWay}" />
	</Grid>
</Page>
