<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockUtilityFileWriteBytes" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:uc="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockUtilityFileWriteBytes" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<uc:SafeModeCtrl
			Grid.Row="0"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="1"
			Margin="0,10,0,0"
			EnableEncoding="False"
			Label="{DynamicResource UtilityFiles_FilePath}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding PathInputMode, Mode=TwoWay}"
			Text="{Binding Path, Mode=TwoWay}" />
		<uc:TextInputBox
			Grid.Row="2"
			Margin="0,5,0,0"
			EnableEncoding="True"
			Label="{DynamicResource UtilityFiles_Content}"
			ModesOfInput="Const,Var,Base64,Hex,CSharp,JavaScript,Python"
			Encoding="{Binding StringEncoding, Mode=TwoWay}"
			InputMode="{Binding ContentInputMode, Mode=TwoWay}"
			Text="{Binding Content, Mode=TwoWay}" />
	</Grid>
</Page>
