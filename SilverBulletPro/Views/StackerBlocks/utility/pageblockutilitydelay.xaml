<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockUtilityDelay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ucv="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockUtilityDelay" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
		</Grid.RowDefinitions>
		<ucv:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<ucv:NumStrInputBox
			Grid.Row="2"
			Height="29"
			Margin="0,10,0,5"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Label="{DynamicResource UtilityFiles_DelayMilliseconds}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding InputMode, Mode=TwoWay}"
			NumericValue="{Binding Milliseconds, Mode=TwoWay}"
			StringValue="{Binding MillisecondsString, Mode=TwoWay}" />
	</Grid>
</Page>
