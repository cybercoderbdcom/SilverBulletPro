<Page
	x:Class="SilverBulletPro.Views.StackerBlocks.PageBlockUtilityTlgSendMessage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ucv="clr-namespace:SilverBulletPro.Views.UserControls"
	Title="PageBlockUtilityTlgSendMessage" xmlns:stackerblocks="clr-namespace:SilverBulletPro.Views.StackerBlocks"
	Loaded="Page_Loaded"
	Unloaded="Page_Unloaded">
	<Grid
		Margin="5,5,8,5">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<ucv:VarCapOutputBox
			ModesOfOutput="String"
			OutputMode="String"
			IsCapture="{Binding IsCapture, Mode=TwoWay}"
			Text="{Binding VariableName, Mode=TwoWay}" />
		<ucv:SafeModeCtrl
			Grid.Row="1"
			Margin="0,6,0,0"
			HorizontalAlignment="Left"
			SafeMode="{Binding SafeMode, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="2"
			Margin="0,10,0,5"
			Label="{DynamicResource Utility_TlgBotToken}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding BotTokenInputMode, Mode=TwoWay}"
			Text="{Binding BotToken, Mode=TwoWay}" />
		<ucv:TextInputBox
			Grid.Row="3"
			Margin="0,0,0,5"
			Label="{DynamicResource Utility_TlgChatId}"
			ModesOfInput="Const,Var,CSharp,JavaScript,Python"
			InputMode="{Binding ChatIdInputMode, Mode=TwoWay}"
			Text="{Binding ChatId, Mode=TwoWay}" />
		<WrapPanel
			Grid.Row="4"
			Margin="3,5,0,5"
			HorizontalAlignment="Left">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<Style
						BasedOn="{StaticResource RadioButtonBaseStyle}"
						TargetType="{x:Type RadioButton}"
						x:Key="{x:Type RadioButton}">
						<Setter
							Property="Margin"
							Value="0,2,7,3" />
					</Style>
				</ResourceDictionary>
			</FrameworkElement.Resources>
			<RadioButton
				Name="rbDefault"
				Content="Default"
				Tag="Default"
				Click="RadioButton_Click" />
			<RadioButton
				Name="rbMarkdown"
				Content="Markdown"
				Tag="Markdown"
				Click="RadioButton_Click" />
			<RadioButton
				Name="rbHtml"
				Content="Html"
				Tag="Html"
				Click="RadioButton_Click" />
			<RadioButton
				Name="rbMarkdownV2"
				Content="MarkdownV2"
				Tag="MarkdownV2"
				Click="RadioButton_Click" />
		</WrapPanel>
		<ucv:RichTextInputBox
			Name="rtInputBox"
			Grid.Row="5"
			Label="{DynamicResource Utility_TlgMsg}" />
	</Grid>
</Page>
