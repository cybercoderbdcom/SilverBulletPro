<UserControl
	x:Class="SilverBulletPro.Views.UserControls.ButtonContainer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:usercontrols="clr-namespace:SilverBulletPro.Views.UserControls">
	<Button
		Name="SubmitButton"
		Margin="5"
		Padding="5"
		Background="{DynamicResource BackgroundSecondary}"
		Foreground="{DynamicResource ForegroundMain}"
		Content="{Binding Text}"
		Click="SubmitButton_Click" />
</UserControl>
