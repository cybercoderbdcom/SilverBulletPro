<UserControl
	x:Class="SilverBulletPro.Views.UserControls.ProgressDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Name="parent" xmlns:usercontrols="clr-namespace:SilverBulletPro.Views.UserControls">
	<GroupBox
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		Background="{DynamicResource BackgroundMain}"
		BorderBrush="{DynamicResource BorderBrush}"
		Foreground="{DynamicResource ForegroundMain}"
		Style="{StaticResource BaseStyle}"
		Width="{Binding Width, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
		Height="{Binding Height, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
		DataContext="{Binding ElementName=parent}">
		<Control.Template>
			<ControlTemplate
				TargetType="{x:Type GroupBox}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="*" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Background="{DynamicResource BorderBrush}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1"
						CornerRadius="5 5 0 0">
						<Label
							Foreground="{DynamicResource ForegroundMain}">
							<ContentPresenter
								Margin="2,0,5,0"
								ContentSource="Header"
								RecognizesAccessKey="True" />
						</Label>
					</Border>
					<Border
						Grid.Row="1"
						Background="{DynamicResource BackgroundMain}"
						BorderBrush="{DynamicResource BorderBrush}"
						BorderThickness="1,0,1,1"
						CornerRadius="0 0 5 5 ">
						<ContentPresenter
							Margin="4" />
					</Border>
				</Grid>
			</ControlTemplate>
		</Control.Template>
		<HeaderedContentControl.Header>
			<TextBlock
				FontSize="12.5"
				FontWeight="Bold"
				Text="{Binding Path=Description}" />
		</HeaderedContentControl.Header>
		<Grid
			Margin="0,7,0,0"
			Background="{DynamicResource BackgroundMain}">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<ProgressBar
				Height="11"
				Margin="8,3,8,3"
				BorderElement.CornerRadius="3"
				Maximum="100"
				Minimum="0"
				IsIndeterminate="{Binding Path=IsIndeterminate}"
				Value="{Binding Path=Value}" />
			<DockPanel
				Grid.Row="1">
				<Button
					Name="DismissButton"
					Height="25"
					MinWidth="120"
					Margin="0,4,0,5"
					Padding="20,0,20,0"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					BorderElement.CornerRadius="10"
					IconElement.Geometry="M166.425,151.25 L210.6125,195.45 A12.5,12.5 1 1 1 192.9375,213.125L148.7375,168.9375 L104.55,213.125 A12.5,12.5 1 1 1 86.875,195.45L131.0625,151.2625 L86.875,107.0625 A12.5,12.5 1 1 1 104.55,89.3875L148.7375,133.575 L192.9375,89.3875 A12.5,12.5 1 1 1 210.6125,107.0625L166.425,151.2625"
					IconElement.Width="12"
					Background="{DynamicResource DarkDangerBrush}"
					Content="{DynamicResource Cancel}"
					Click="Dismiss_Click" />
			</DockPanel>
		</Grid>
	</GroupBox>
</UserControl>
