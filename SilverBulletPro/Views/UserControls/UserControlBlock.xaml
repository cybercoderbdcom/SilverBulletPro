			Margin="0"
			Padding="2"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Panel.ZIndex="2"
			IsHitTestVisible="True"
			Width="{Binding Width, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Border}}}"
			Height="{Binding Height, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Border}}}"
			Background="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Border}}}"
			Foreground="{Binding Foreground}"
			Click="Button_Click">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="auto" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>
				<TextBlock
					Name="TitleTextBlock"
					HorizontalAlignment="Center"
					VerticalAlignment="Stretch"
					FontWeight="Bold"
					TextAlignment="Center"
					TextTrimming="CharacterEllipsis"
					TextWrapping="NoWrap"
					Width="{Binding Width, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
					Margin="{Binding TextMargin}"
					FontSize="{Binding FontSize}"
					Foreground="{Binding Foreground}"
					Text="{Binding Text}"
					ToolTip="{Binding Text}"
					ToolTipOpening="TextBlock_ToolTipOpening" />
				<TextBlock
					Grid.Row="1"
					Margin="0,1,0,0"
					Padding="0,0,5,0"
					HorizontalAlignment="Center"
					VerticalAlignment="Stretch"
					FontSize="11.1"
					TextAlignment="Center"
					TextTrimming="CharacterEllipsis"
					TextWrapping="Wrap"
					Width="{Binding Width, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}"
					Foreground="{Binding Foreground}"
					Text="{Binding Description}"
					ToolTip="{Binding FullInfo}"
					Visibility="{Binding DescriptionVisibility}"
					ToolTipOpening="TextBlock_ToolTipOpening" />
			</Grid>
		</Button>
