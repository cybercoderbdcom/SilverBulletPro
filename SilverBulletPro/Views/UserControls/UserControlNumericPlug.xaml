<UserControl
	x:Class="SilverBulletPro.Views.UserControls.UserControlNumericPlug" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:usercontrols="clr-namespace:SilverBulletPro.Views.UserControls">
	<NumericUpDown
		NumericUpDown.Name="valueNumeric"
		FrameworkElement.Width="auto"
		FrameworkElement.HorizontalAlignment="Stretch"
		FrameworkElement.VerticalAlignment="Stretch"
		FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
		NumericUpDown.Maximum="{Binding Maximum}"
		NumericUpDown.Minimum="{Binding Minimum}"
		TextBlock.TextAlignment="{Binding TextAlignment}"
		x:Name="valueNumeric" xmlns="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
</UserControl>
