<UserControl
	x:Class="SilverBulletPro.Views.UserControls.UserControlTextMulti" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:usercontrols="clr-namespace:SilverBulletPro.Views.UserControls">
	<TextBox
		Name="valueTextbox"
		Height="100"
		ScrollViewerAttach.AutoHide="False"
		AcceptsReturn="True"
		Background="{DynamicResource BackgroundSecondary}"
		Foreground="{DynamicResource ForegroundMain}"
		ScrollViewer.CanContentScroll="True"
		ScrollViewer.HorizontalScrollBarVisibility="Auto"
		ScrollViewer.VerticalScrollBarVisibility="Auto"
		TextWrapping="Wrap" />
</UserControl>
