<UserControl
	x:Class="SilverBulletPro.Views.UserControls.UserControlWordlist" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:usercontrols="clr-namespace:SilverBulletPro.Views.UserControls">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="auto" />
		</Grid.ColumnDefinitions>
		<TextBox
			Name="WordlistName"
			Grid.Column="0"
			VerticalContentAlignment="Center"
			Background="{DynamicResource BackgroundSecondary}"
			Foreground="{DynamicResource ForegroundMain}"
			IsReadOnly="True" />
		<Button
			Name="Choose"
			Grid.Column="1"
			Padding="10,0"
			Background="{DynamicResource BackgroundSecondary}"
			Content="Choose"
			Foreground="{DynamicResource ForegroundMain}"
			Click="Choose_Click" />
	</Grid>
</UserControl>
