<UserControl
	x:Class="SilverBulletPro.UserControls.CustomTabItem" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:usercontrols="clr-namespace:SilverBulletPro.UserControls">
	<Button
		Padding="5"
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch"
		Width="{Binding Width, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
		Height="{Binding Height, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
		Background="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
		BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
		Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
		Click="Button_Click">
		<StackPanel>
			<ContentPresenter
				HorizontalAlignment="Center"
				Margin="{Binding MarginIcon}"
				Content="{Binding Icon}" />
			<TextBlock
				Grid.Row="1"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				FontSize="11.5"
				TextAlignment="Center"
				TextTrimming="CharacterEllipsis"
				Width="{Binding TextWidth}"
				Margin="{Binding MarginText}"
				Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
				Text="{Binding Text}" />
		</StackPanel>
	</Button>
</UserControl>
