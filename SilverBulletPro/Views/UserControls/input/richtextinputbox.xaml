<UserControl
	x:Class="SilverBulletPro.Views.UserControls.RichTextInputBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:SilverBulletPro.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Name="parent" xmlns:usercontrols="clr-namespace:SilverBulletPro.Views.UserControls"
	Loaded="Page_Loaded">
	<FrameworkElement.Resources>
		<converters:SubtractConverter
			x:Key="SubtractConverter" />
		<converters:VisibilityToVisibilityReConverter
			x:Key="VisibilityToVisibilityReConverter" />
	</FrameworkElement.Resources>
	<Grid
		DataContext="{Binding ElementName=parent}">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<DockPanel>
			<TextBlock
				Name="textBlock"
				Margin="-1,0,5,1"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap"
				Text="{Binding Path=Label, StringFormat= {0}:}"
				Visibility="{Binding LabelVisibility}" />
			<ToggleButton
				Name="toggleButton"
				Width="39"
				Height="27"
				Padding="5,0,5,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Stretch"
				BorderElement.CornerRadius="2 2 0 0"
				IconElement.Width="16"
				IconElement.Geometry="M0,800 L0,800 C0,748.8 44.8,704 96,704 L96,704 C147.2,704 192,748.8 192,800 L192,800 C192,851.2 147.2,896 96,896 L96,896 C44.8,896 0,851.2 0,800 M0,480 L0,480 C0,428.8 44.8,384 96,384 L96,384 C147.2,384 192,428.8 192,480 L192,480 C192,531.2 147.2,576 96,576 L96,576 C44.8,576 0,531.2 0,480 M0,160 L0,160 C0,108.8 44.8,64 96,64 L96,64 C147.2,64 192,108.8 192,160 L192,160 C192,211.2 147.2,256 96,256 L96,256 C44.8,256 0,211.2 0,160 M320,896 L1024,896 L1024,704 L320,704 L320,896 M320,576 L1024,576 L1024,384 L320,384 L320,576 M320,256 L1024,256 L1024,64 L320,64 L320,256"
				IconSwitchElement.GeometrySelected="M320,112 L368,64 L448,144 L400,192 L320,112 M128,304 L288,144 L368,224 L208,384 L128,304 M96,336 L176,416 L64,448 L96,336"
				BorderBrush="{DynamicResource BorderBrush}"
				BorderThickness="1.5,1.5,1.5,0.5"
				FontSize="11"
				Foreground="{DynamicResource ForegroundMain}"
				Style="{StaticResource ToggleButtonIconInfo}"
				Background="{Binding ElementName=richTextBox, Path=Background}"
				IsChecked="{Binding IsEditable}"
				Click="ToggleButton_Click" />
		</DockPanel>
		<ListBox
			Name="listBox"
			Grid.Row="1"
			ScrollViewerAttach.AutoHide="False"
			Background="{DynamicResource BackgroundSecondary}"
			Foreground="{DynamicResource ForegroundMain}"
			SelectionMode="Single"
			Width="{Binding ElementName=parent, Path=ActualWidth}"
			ToolTip="{Binding ListBoxToolTip}"
			Visibility="{Binding ElementName=richTextBox, Path=Visibility, Converter={StaticResource VisibilityToVisibilityReConverter}}"
			KeyDown="ListBox_KeyDown">
			<ItemsControl.ItemContainerStyle>
				<!--Unknown connection ID: 5-->
				<Style
					BasedOn="{StaticResource ListBoxItemBaseStyle}"
					TargetType="{x:Type ListBoxItem}">
					<Setter xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
						Property="controls:BorderElement.CornerRadius"
						Value="0" />
					<Setter
						Property="Margin"
						Value="0" />
					<Setter
						Property="Padding"
						Value="6,0,0,0" />
				</Style>
			</ItemsControl.ItemContainerStyle>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<!--Unknown connection ID: 6-->
					<Grid
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Width="{Binding Path=Width, ConverterParameter=22, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={converters:SubtractConverter Value=22}}">
						<FrameworkElement.ToolTip>
							<TextBlock
								Background="{DynamicResource BackgroundSecondary}"
								Text="Double click to edit" />
						</FrameworkElement.ToolTip>
						<Grid.ColumnDefinitions>
							<ColumnDefinition />
							<ColumnDefinition
								Width="auto" />
						</Grid.ColumnDefinitions>
						<!--Unknown connection ID: 7-->
						<TextBlock
							Margin="0,0,7,0"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center"
							FontSize="12"
							Foreground="{DynamicResource ForegroundMain}"
							TextTrimming="CharacterEllipsis"
							TextWrapping="NoWrap"
							Text="{Binding Value}"
							Visibility="{Binding ElementName=editBox, Path=Visibility, Converter={StaticResource VisibilityToVisibilityReConverter}}" />
						<!--Unknown connection ID: 8-->
						<TextBox
							Name="editBox"
							Width="auto"
							Margin="-5,0,0,0"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							p14:BorderElement.CornerRadius="2"
							Background="{DynamicResource BackgroundSecondary}"
							BorderThickness="1"
							ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
							FontSize="12.5"
							FontWeight="DemiBold"
							IsReadOnly="False"
							TextWrapping="NoWrap"
							Visibility="Collapsed"
							Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" xmlns:p14="clr-namespace:HandyControl.Controls;assembly=HandyControl">
							<FrameworkElement.Style>
								<Style
									BasedOn="{StaticResource BaseStyle}"
									TargetType="{x:Type TextBox}">
									<Setter
										Property="BorderBrush"
										Value="{x:Null}" />
									<Setter
										Property="BorderThickness"
										Value="0" />
									<Setter
										Property="Height"
										Value="28" />
									<Setter
										Property="VerticalContentAlignment"
										Value="Center" />
									<Setter
										Property="Margin"
										Value="-6,0,0,0" />
								</Style>
							</FrameworkElement.Style>
						</TextBox>
						<!--Unknown connection ID: 9-->
						<Button
							Grid.Column="1"
							Width="32"
							Height="30"
							Margin="1,0,-10,0"
							Padding="-1,0,0,0"
							HorizontalAlignment="Right"
							VerticalAlignment="Stretch"
							Panel.ZIndex="1"
							p14:BorderElement.CornerRadius="0"
							IconElement.Geometry="M23.75,20.5833 L52.25,20.5833 L52.25,26.9167 L41.1667,26.9167 L41.1667,58.5833 L34.8333,58.5833 L34.8333,26.9167 L23.75,26.9167 L23.75,20.5833"
							IconElement.Width="0"
							BorderThickness="1"
							Content=""
							DockPanel.Dock="Right"
							FontSize="11"
							FontWeight="DemiBold"
							Foreground="{DynamicResource ForegroundMain}"
							Background="{Binding ElementName=editBox, Path=Background}"
							Tag="{Binding .}" xmlns:p14="clr-namespace:HandyControl.Controls;assembly=HandyControl" />
					</Grid>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
			<FrameworkElement.ContextMenu>
				<ContextMenu>
					<MenuItem
						Header="{DynamicResource Add}"
						Click="AddItem_Click">
						<MenuItem.Icon>
							<iconpacks:PackIconModern
								PackIconModern.Kind="Add" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Modern" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem
						Header="{DynamicResource Copy}"
						Click="CopySelected_Click">
						<MenuItem.Icon>
							<iconpacks:FontAwesomeExtension
								FontAwesomeExtension.Kind="CopySolid" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem
						Header="{DynamicResource Edit}"
						Visibility="Collapsed">
						<MenuItem.Icon>
							<PackIconModern
								PackIconModern.Kind="Edit" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Modern" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem
						Header="{DynamicResource Paste}"
						Click="Paste_Click">
						<MenuItem.Icon>
							<FontAwesomeExtension
								FontAwesomeExtension.Kind="PasteSolid" xmlns="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.FontAwesome" />
						</MenuItem.Icon>
					</MenuItem>
					<Separator />
					<MenuItem
						Header="{DynamicResource Remove}"
						Click="RemoveSelected_Click">
						<MenuItem.Icon>
							<iconpacks:PackIconIonicons
								PackIconIonicons.Kind="CloseiOS" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Ionicons" />
						</MenuItem.Icon>
					</MenuItem>
					<MenuItem
						Header="{DynamicResource Clear}"
						Click="Clear_Click">
						<MenuItem.Icon>
							<iconpacks:BoxIconsExtension
								BoxIconsExtension.Kind="SolidTrashAlt" xmlns:iconpacks="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.BoxIcons" />
						</MenuItem.Icon>
					</MenuItem>
				</ContextMenu>
			</FrameworkElement.ContextMenu>
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<SolidColorBrush
						Color="{Binding ElementName=listBox, Path=Background}"
						x:Key="RegionBrush" />
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</ListBox>
		<RichTextBox
			Name="richTextBox"
			Grid.Row="1"
			p10:BorderElement.CornerRadius="4 0 4 4"
			ScrollViewerAttach.AutoHide="False"
			Background="{DynamicResource BackgroundSecondary}"
			ContextMenu="{StaticResource RichTextBox.ContextMenu}"
			Foreground="{DynamicResource ForegroundMain}"
			ScrollViewer.CanContentScroll="True"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			Style="{StaticResource RichTextBoxBaseStyle}"
			MinHeight="{Binding MinHeight}"
			ToolTip="{Binding RichTextBoxToolTip}"
			Visibility="{Binding ElementName=toggleButton, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}"
			LostFocus="RichTextBox_LostFocus" xmlns:p10="clr-namespace:HandyControl.Controls;assembly=HandyControl">
			<FrameworkElement.Resources>
				<ResourceDictionary>
					<Style
						TargetType="{x:Type Paragraph}"
						x:Key="{x:Type Paragraph}">
						<Setter
							Property="Block.Margin"
							Value="0" />
					</Style>
				</ResourceDictionary>
			</FrameworkElement.Resources>
		</RichTextBox>
	</Grid>
</UserControl>
