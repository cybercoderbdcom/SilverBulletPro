<UserControl
	x:Class="SilverBulletPro.Views.UserControls.TextInputBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Name="parent"
	Height="30" xmlns:usercontrols="clr-namespace:SilverBulletPro.Views.UserControls"
	Loaded="UserControl_Loaded">
	<DockPanel
		DataContext="{Binding ElementName=parent}">
		<TextBlock
			Name="textBlock"
			Margin="-1,0,5,1"
			VerticalAlignment="Center"
			Foreground="{DynamicResource ForegroundMain}"
			Text="{Binding Path=Label, StringFormat= {0}:}"
			Visibility="{Binding LabelVisibility}" />
		<Button
			Name="inputModeButton"
			Width="32"
			Height="auto"
			Padding="0,0,5,0"
			VerticalAlignment="Stretch"
			BorderElement.CornerRadius="0 4 4 0"
			IconElement.Geometry="M23.75,20.5833 L52.25,20.5833 L52.25,26.9167 L41.1667,26.9167 L41.1667,58.5833 L34.8333,58.5833 L34.8333,26.9167 L23.75,26.9167 L23.75,20.5833"
			IconElement.Width="0"
			BorderThickness="0,1,1,1"
			Content=""
			DockPanel.Dock="Right"
			FontSize="11"
			FontWeight="DemiBold"
			Foreground="{DynamicResource ForegroundMain}"
			Background="{Binding ElementName=inputTextBox, Path=Background}"
			Click="InputModeButton_Click" />
		<ComboBox
			Name="encodingBox"
			Width="84"
			BorderElement.CornerRadius="0"
			DropDownElement.AutoWidth="True"
			DockPanel.Dock="Right"
			FontSize="11"
			FontWeight="Bold"
			Foreground="{DynamicResource ForegroundMain}"
			Background="{Binding ElementName=inputTextBox, Path=Background}"
			SelectionChanged="EncodingBox_SelectionChanged" />
		<controls:TextBox
			TextBox.Name="inputTextBox"
			BorderElement.CornerRadius="4 0 0 4"
			Control.Background="{DynamicResource BackgroundSecondary}"
			FrameworkElement.ContextMenu="{StaticResource MahApps.TextBox.ContextMenu}"
			Control.Foreground="{DynamicResource ForegroundMain}"
			FrameworkElement.Style="{StaticResource TextBoxExtend}" xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
			InfoElement.Placeholder="{Binding Placeholder}"
			TextBoxBase.AcceptsReturn="{Binding AcceptsReturn}"
			UIElement.AllowDrop="{Binding TextInputBoxAllowDrop}"
			Control.FontSize="{Binding InputFontSize}"
			TextBoxBase.IsReadOnly="{Binding IsReadOnly}"
			TextBox.Text="{Binding Path=Text}"
			x:Name="inputTextBox"
			Drop="TextInputBox_Drop"
			PreviewDragOver="TextInputBox_PreviewDragOver"
			TextChanged="TextBox_TextChanged" />
	</DockPanel>
</UserControl>
