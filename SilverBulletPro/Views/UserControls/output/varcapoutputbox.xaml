<UserControl
	x:Class="SilverBulletPro.Views.UserControls.VarCapOutputBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Name="parent"
	Height="30" xmlns:usercontrols="clr-namespace:SilverBulletPro.Views.UserControls"
	Loaded="UserControl_Loaded">
	<Grid
		DataContext="{Binding ElementName=parent}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="auto" />
			<ColumnDefinition />
			<ColumnDefinition
				Width="auto" />
			<ColumnDefinition
				Width="auto" />
		</Grid.ColumnDefinitions>
		<DockPanel>
			<ToggleButton
				Name="toggleButton"
				Width="27"
				Margin="0,1,0,0"
				HorizontalAlignment="Center"
				Background="#00FFFFFF"
				BorderThickness="0"
				FontWeight="Bold"
				Foreground="{DynamicResource ForegroundMain}"
				Style="{StaticResource ToggleButtonFlip}"
				IsChecked="{Binding Path=IsCapture}"
				IsHitTestVisible="{Binding EnableCapture}"
				Click="CaptureBox_Click">
				<controls:StatusSwitchElement.CheckedElement xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl">
					<Border
						Name="b1"
						Background="#00FFFFFF">
						<TextBlock
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="#FFFF6347"
							Text="CAP"
							ToolTip="Capture" />
					</Border>
				</controls:StatusSwitchElement.CheckedElement>
				<Border
					Name="b2">
					<TextBlock
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="#ffd800"
						Text="VAR"
						ToolTip="Variable" />
				</Border>
			</ToggleButton>
			<TextBlock
				Margin="2,0,0,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}"
				Text="{DynamicResource Name}" />
			<TextBlock
				Margin="3,0,0,0"
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}"
				Text="(" />
			<Button
				Name="outputModeButton"
				Grid.Column="3"
				Height="23"
				Margin="5,1,0,0"
				Padding="-4,0,2,0"
				VerticalAlignment="Center"
				Background="#00FFFFFF"
				BorderBrush="#00FFFFFF"
				BorderThickness="0"
				Content="String"
				FontSize="11.4"
				FontWeight="Bold"
				Foreground="{DynamicResource ForegroundGood}"
				RenderTransformOrigin="0.5,0.5"
				Style="{StaticResource ButtonCustom}"
				ToolTip="Output Type"
				Click="OutputModeButton_Click">
				<UIElement.RenderTransform>
					<TransformGroup>
						<ScaleTransform />
						<SkewTransform />
					</TransformGroup>
				</UIElement.RenderTransform>
				<FrameworkElement.Triggers>
					<EventTrigger
						RoutedEvent="Button.Click">
						<BeginStoryboard>
							<Storyboard>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetProperty="(FrameworkElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
									Duration="0:0:0.2">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.0"
										Value="1" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.09"
										Value="0.3" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.12"
										Value="0.6" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.15"
										Value="0.8" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.18"
										Value="1" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.2"
										Value="1" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetProperty="(FrameworkElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
									Duration="0:0:0.2">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.0"
										Value="1" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.09"
										Value="0.9" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.18"
										Value="1" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.2"
										Value="1" />
								</DoubleAnimationUsingKeyFrames>
								<DoubleAnimationUsingKeyFrames
									Storyboard.TargetProperty="(FrameworkElement.RenderTransform).(TransformGroup.Children)[1].(SkewTransform.AngleY)"
									Duration="0:0:0.2">
									<SplineDoubleKeyFrame
										KeyTime="00:00:00"
										Value="0" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.06"
										Value="-10" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.09"
										Value="-20" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.1"
										Value="20" />
									<SplineDoubleKeyFrame
										KeyTime="00:00:00.18"
										Value="0" />
								</DoubleAnimationUsingKeyFrames>
							</Storyboard>
						</BeginStoryboard>
					</EventTrigger>
				</FrameworkElement.Triggers>
			</Button>
			<TextBlock
				VerticalAlignment="Center"
				Foreground="{DynamicResource ForegroundMain}"
				Text="):" />
		</DockPanel>
		<TextBox
			Name="varCapNameTextBox"
			Grid.Column="1"
			Margin="4,0,0,0"
			BorderElement.CornerRadius="4 0 0 4"
			Background="{DynamicResource BackgroundSecondary}"
			BorderThickness="1,1,0,1"
			DockPanel.Dock="Left"
			Text="{Binding Path=Text}"
			GotFocus="VarCapNameTextBox_GotFocus"
			LostFocus="VarCapNameTextBox_LostFocus"
			MouseEnter="VarCapNameTextBox_MouseEnter"
			MouseLeave="VarCapNameTextBox_MouseLeave" />
		<Border
			Name="borderHiddenVar"
			Grid.Column="2"
			BorderThickness="0,1,1,1"
			CornerRadius="0 4 4 0"
			Background="{Binding ElementName=varCapNameTextBox, Path=Background}"
			BorderBrush="{Binding ElementName=varCapNameTextBox, Path=BorderBrush}">
			<ToggleButton
				Name="hiddenVar"
				Height="20"
				Margin="2,0,2,0"
				VerticalAlignment="Center"
				BorderBrush="#00FFFFFF"
				Style="{StaticResource ToggleButtonSwitch}"
				ToolTip="Hidden Variable"
				IsChecked="{Binding Path=HiddenVar}"
				GotFocus="ToggleButton_GotFocus"
				LostFocus="ToggleButton_LostFocus"
				MouseEnter="ToggleButton_MouseEnter"
				MouseLeave="ToggleButton_MouseLeave">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<SolidColorBrush
							Color="{DynamicResource DarkSuccessColor}"
							x:Key="PrimaryBrush" />
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</ToggleButton>
		</Border>
		<ComboBox
			Name="encodingBox"
			Grid.Column="3"
			Width="80"
			BorderElement.CornerRadius="0 4 4 0"
			DropDownElement.AutoWidth="True"
			Background="{DynamicResource BackgroundSecondary}"
			ToolTip="Output Encoding"
			Visibility="Collapsed"
			SelectionChanged="EncodingBox_SelectionChanged" />
	</Grid>
</UserControl>
