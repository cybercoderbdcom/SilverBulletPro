<UserControl
	x:Class="SilverBulletPro.UserControls.SliderText" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:SilverBulletPro.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:usercontrols="clr-namespace:SilverBulletPro.UserControls">
	<StackPanel
		Name="stack"
		Margin="0"
		Orientation="Horizontal">
		<FrameworkElement.Resources>
			<ResourceDictionary>
				<converters:NegatingConverter
					x:Key="NegatingConverter" />
				<Storyboard
					x:Key="slide">
					<DoubleAnimation
						RepeatBehavior="Forever"
						Storyboard.TargetName="transferCurreny2"
						Storyboard.TargetProperty="X"
						From="0"
						To="{Binding ActualWidth, ElementName=txtKron, Converter={StaticResource NegatingConverter}}"
						Duration="{Binding Duration}" />
				</Storyboard>
			</ResourceDictionary>
		</FrameworkElement.Resources>
		<Label
			Name="txtKron"
			Canvas.Left="0"
			Margin="0"
			Padding="0"
			VerticalAlignment="Center"
			Content="{Binding Text}"
			Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
			<FrameworkElement.Triggers>
				<EventTrigger
					RoutedEvent="Label.Loaded">
					<BeginStoryboard
						Storyboard="{StaticResource slide}" />
				</EventTrigger>
				<EventTrigger
					RoutedEvent="Label.SizeChanged">
					<BeginStoryboard
						Storyboard="{StaticResource slide}" />
				</EventTrigger>
			</FrameworkElement.Triggers>
			<UIElement.RenderTransform>
				<TranslateTransform
					x:Name="transferCurreny2"
					X="0" />
			</UIElement.RenderTransform>
		</Label>
	</StackPanel>
</UserControl>
