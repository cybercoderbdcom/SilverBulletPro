<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Color
		x:Key="Color_003">#FF858585</Color>
	<Color
		x:Key="Color_004">#FF747474</Color>
	<Color
		x:Key="Color_006">#FF454545</Color>
	<Color
		x:Key="Color_008">#FF292929</Color>
	<Color
		x:Key="Color_010">#E5FFFFFF</Color>
	<Color
		x:Key="Color_024">#FF00AADE</Color>
	<Color
		x:Key="Color_002">#FFBABABA</Color>
	<SolidColorBrush
		Color="{StaticResource Color_008}"
		x:Key="GridSplitterBackgroundBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_003}"
		x:Key="GlyphBackgroundBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_004}"
		x:Key="GridSplitterBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_006}"
		x:Key="GridSplitterHoverBackgroundBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_003}"
		x:Key="GridSplitterHoverBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_024}"
		x:Key="GridSplitterPressedBackgroundBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_024}"
		x:Key="GridSplitterFocusedBorderBrush" />
	<SolidColorBrush
		Color="{StaticResource Color_002}"
		x:Key="ForegroundBrush" />
	<Style
		TargetType="{x:Type GridSplitter}"
		x:Key="GridSplitterStyle">
		<Setter
			Property="Foreground"
			Value="{StaticResource ForegroundBrush}" />
		<Setter
			Property="Background"
			Value="{StaticResource GridSplitterBackgroundBrush}" />
		<Setter
			Property="BorderBrush"
			Value="{StaticResource GridSplitterBorderBrush}" />
		<Setter
			Property="BorderThickness"
			Value="1" />
		<Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
		<Setter
			Property="GridSplitter.PreviewStyle">
			<Setter.Value>
				<Style
					TargetType="{x:Type Control}">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate>
								<Rectangle
									Opacity="0.8"
									Fill="{StaticResource GridSplitterPressedBackgroundBrush}" />
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Setter.Value>
		</Setter>
		<Setter
			Property="Template">
			<Setter.Value>
				<ControlTemplate>
					<Grid>
						<Border
							Name="border"
							MinWidth="8"
							MinHeight="8"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">
							<Grid>
								<StackPanel
									Name="HGrip"
									Height="8"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Orientation="Vertical">
									<Rectangle
										Width="20"
										Height="1"
										Margin="1,2,1,1"
										StrokeThickness="0"
										Fill="{StaticResource GlyphBackgroundBrush}" />
									<Rectangle
										Width="20"
										Height="1"
										Margin="1,1,1,2"
										StrokeThickness="0"
										Fill="{StaticResource GlyphBackgroundBrush}" />
								</StackPanel>
								<StackPanel
									Name="VGrip"
									Width="8"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Orientation="Horizontal"
									Visibility="Collapsed">
									<Rectangle
										Width="1"
										Height="20"
										Margin="2,1,1,1"
										StrokeThickness="0"
										Fill="{StaticResource GlyphBackgroundBrush}" />
									<Rectangle
										Width="1"
										Height="20"
										Margin="1,1,2,1"
										StrokeThickness="0"
										Fill="{StaticResource GlyphBackgroundBrush}" />
								</StackPanel>
							</Grid>
						</Border>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger
							Property="HorizontalAlignment"
							Value="Stretch">
							<Setter
								TargetName="HGrip"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="VGrip"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
						<Trigger
							Property="VerticalAlignment"
							Value="Stretch">
							<Setter
								TargetName="VGrip"
								Property="Visibility"
								Value="Visible" />
							<Setter
								TargetName="HGrip"
								Property="Visibility"
								Value="Collapsed" />
						</Trigger>
						<Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
							<Setter
								TargetName="border"
								Property="Background"
								Value="{StaticResource GridSplitterHoverBackgroundBrush}" />
							<Setter
								TargetName="border"
								Property="BorderBrush"
								Value="{StaticResource GridSplitterHoverBorderBrush}" />
						</Trigger>
						<Trigger
							Property="UIElement.IsFocused"
							Value="True">
							<Setter
								TargetName="border"
								Property="BorderBrush"
								Value="{StaticResource GridSplitterFocusedBorderBrush}" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
